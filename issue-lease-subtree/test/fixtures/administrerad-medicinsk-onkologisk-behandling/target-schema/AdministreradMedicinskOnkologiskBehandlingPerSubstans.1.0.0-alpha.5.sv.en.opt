                    <type>urn:oid:1.2.752.29.4.19</type>
                </default_value>
            </children>
            <differential_path>[openEHR-EHR-COMPOSITION.encounter.v1]/context/other_context[at0001]/items[openEHR-EHR-CLUSTER.organisation.v1, 'Vårdenhet']/items[at0003]</differential_path>
        </attributes>
        <attributes>
            <rm_attribute_name>value</rm_attribute_name>
            <children>
                <default_value xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="DV_CODED_TEXT">
                    <value>vårdenhet</value>
                    <defining_code>
                        <terminology_id>
                            <value>http://snomed.info/sct/900000000000207008</value>
                        </terminology_id>
                        <code_string>43741000</code_string>
                    </defining_code>
                </default_value>
            </children>
            <differential_path>[openEHR-EHR-COMPOSITION.encounter.v1]/context/other_context[at0001]/items[openEHR-EHR-CLUSTER.organisation.v1, 'Vårdenhet']/items[at0004]</differential_path>
        </attributes>
        <attributes>
            <rm_attribute_name>value</rm_attribute_name>
