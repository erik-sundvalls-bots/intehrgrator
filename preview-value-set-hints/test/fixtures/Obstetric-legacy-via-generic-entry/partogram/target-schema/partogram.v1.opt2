                            description = <"Narrativa adicional sobre os achados gerais do exame físico não capturados em outros campos.">
                        >
                        ["at0012"] = <
                            text = <"Extensão">
                            description = <"Informações adicionais necessárias para capturar conteúdo local ou alinhar com outros modelos/formalismos de referência.">
                        >
                        ["at0013"] = <
                            text = <"Posição">
                            description = <"A posição do corpo do sujeito durante o exame.">
                        >
                    >
                    ["zh-cn"] = <
                        ["at0000"] = <
                            text = <"体格检查发现">
                            description = <"对于特定主体对象进行体格检查过程中所获得的发现。">
                        >
                        ["at0001"] = <
                            text = <"Event Series">
                            description = <"@ internal @">
                        >
                        ["at0002"] = <
                            text = <"任何事件">
                            description = <"默认值，未加具体说明的，而可以在特定模板中或在运行时加以明确定义的时刻（时间点）型或时段（时间段、时间区间）型事件。">
                        >
                        ["at0003"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0004"] = <
                            text = <"描述">
                            description = <"关于特定患者的体格检查过程中所观察到的全部发现的叙述型描述。">
                        >
                        ["at0005"] = <
                            text = <"检查细节">
                            description = <"体格检查的结构化细节。">
                        >
                        ["at0006"] = <
                            text = <"解释">
                            description = <"用于表示体格检查发现的临床含义和意义的单个词语、短语或简要描述。">
                        >
                        ["at0007"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0008"] = <
                            text = <"干扰因素">
                            description = <"关于可能对体格检查发现做出了贡献的任何偶然因素的描述。">
                        >
                        ["at0009"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0010"] = <
                            text = <"装置细节">
                            description = <"关于体格检查过程中所使用的任何装置的细节。">
                        >
                        ["at0011"] = <
                            text = <"注释">
                            description = <"其他字段之中并未采集的关于全部体格检查发现的叙述型注释。">
                        >
                        ["at0012"] = <
                            text = <"扩展">
                            description = <"采集本地内容或者与其他参考模型/形式化体系进行映射时所需的额外信息。">
                        >
                        ["at0013"] = <
                            text = <"*Position(en)">
                            description = <"*The body position of the subject during the examination.(en)">
                        >
                    >
                    ["de"] = <
                        ["at0000"] = <
                            text = <"Ergebnisse der körperlichen Untersuchung">
                            description = <"Während der körperlichen Untersuchung eines Patienten beobachtete Befunde.">
                        >
                        ["at0001"] = <
                            text = <"Event Series">
                            description = <"@ internal @">
                        >
                        ["at0002"] = <
                            text = <"Jedes Ereignis">
                            description = <"Ein Standardwert, ein spezifizierter Zeitpunkt oder ein Intervallereignis, welches explizit in einem Template oder während der Laufzeit definiert werden kann.">
                        >
                        ["at0003"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0004"] = <
                            text = <"Beschreibung">
                            description = <"Beschreibung der Gesamtbefunde, die bei der körperlichen Untersuchung eines Patienten beobachtet wurden.">
                        >
                        ["at0005"] = <
                            text = <"Untersuchungsdetails">
                            description = <"Strukturierte Details der körperlichen Untersuchung.">
                        >
                        ["at0006"] = <
                            text = <"Interpretation">
                            description = <"Einzelnes Wort, Ausdruck oder Kurzbeschreibung der klinischen Bedeutung und Aussagekraft der körperlichen Untersuchungsbefunde.">
                        >
                        ["at0007"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0008"] = <
                            text = <"Störfaktoren">
                            description = <"Beschreibung aller zufälligen Faktoren, die zu den Ergebnissen der körperlichen Untersuchung beigetragen haben könnten.">
                        >
                        ["at0009"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0010"] = <
                            text = <"Gerätedetails">
                            description = <"Details über jedes Gerät, welches bei der körperlichen Untersuchung verwendet wurde.">
                        >
                        ["at0011"] = <
                            text = <"Kommentar">
                            description = <"Zusätzlicher Freitext über die allgemeinen körperlichen Untersuchungsergebnisse, die in anderen Bereichen nicht erfasst werden konnten.">
                        >
                        ["at0012"] = <
                            text = <"Erweiterung">
                            description = <"Zusätzliche Information, die für die Erfassung des lokalen Kontexts oder für die Anpassung an andere Referenzmodelle/Formalismen benötigt wird.">
                        >
                        ["at0013"] = <
                            text = <"Position">
                            description = <"Die Position der untersuchten Person während der Untersuchung.">
                        >
                    >
                    ["sv"] = <
                        ["at0000"] = <
                            text = <"Fysiska undersökningsfynd">
                            description = <"Observerade fynd under en fysisk undersökning av mottagaren av hälso- och sjukvård.">
                        >
                        ["at0001"] = <
                            text = <"Event Series">
                            description = <"@ internal @">
                        >
                        ["at0002"] = <
                            text = <"Ospecificerad händelse">
                            description = <"Standard, ospecificerad händelse eller intervallhändelse som kan definieras uttryckligen i en mall eller vid körning.">
                        >
                        ["at0003"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0004"] = <
                            text = <"Beskrivning">
                            description = <"Detaljerad beskrivning av de övergripande fynden som observerats under en fysisk undersökning av en patient.">
                        >
                        ["at0005"] = <
                            text = <"Undersökningsdetaljer">
                            description = <"Strukturerade detaljer från den fysiska undersökningen.">
                        >
                        ["at0006"] = <
                            text = <"Tolkning">
                            description = <"Enkelt ord, fras eller kort beskrivning som representerar den kliniska innebörden och betydelsen av de fysiska undersökningsfynden.">
                        >
                        ["at0007"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0008"] = <
                            text = <"Möjliga felkällor">
                            description = <"Beskrivning av eventuella tillfälliga faktorer som kan ha bidragit till de fysiska undersökningsfynden.">
                        >
                        ["at0009"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0010"] = <
                            text = <"Detaljer om utrustning">
                            description = <"Detaljer om utrustning som använts under den fysiska undersökningen.">
                        >
                        ["at0011"] = <
                            text = <"Kommentar">
                            description = <"Ytterligare beskrivning om de övergripande fysiska undersökningsfynden som inte fångats i andra fält.">
                        >
                        ["at0012"] = <
                            text = <"Tilläggsinformation">
                            description = <"Tilläggsinformation som krävs för att fånga lokalt innehåll eller för anpassning till andra referensmodeller/formalismer.">
                        >
                        ["at0013"] = <
                            text = <"Kroppsställning">
                            description = <"Kroppsställning vid undersökning.">
                        >
                    >
                    ["ca"] = <
                        ["at0000"] = <
                            text = <"Troballes de l'exploració física">
                            description = <"Troballes observades durant l'examen físic del pacient.">
                        >
                        ["at0001"] = <
                            text = <"Event Series">
                            description = <"@ internal @">
                        >
                        ["at0002"] = <
                            text = <"Qualsevol esdeveniment">
                            description = <"Esdeveniment predeterminat, en un interval de temps o moment no específic, que es pot definir de forma expressa en una plantilla o en temps d'execució.">
                        >
                        ["at0003"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0004"] = <
                            text = <"Descripció">
                            description = <"Descripció narrativa del total de les troballes durant l'examen físic del pacient.">
                        >
                        ["at0005"] = <
                            text = <"Detalls de l'examen">
                            description = <"Detalls estructurats de l'examen físic.">
                        >
                        ["at0006"] = <
                            text = <"Interpretació">
                            description = <"Una sola paraula, frase o descripció breu que englobi el significat clínic i la importància de les troballes de l'examen físic.">
                        >
                        ["at0007"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0008"] = <
                            text = <"Factors de confusió">
                            description = <"Descripció dels factors que puguin haver obstruït o dificultat les troballes de l'examen físic.">
                        >
                        ["at0009"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0010"] = <
                            text = <"Detalls del dispositiu">
                            description = <"Detalls sobre qualsevol dispositiu utilitzat durant l'examen físic.">
                        >
                        ["at0011"] = <
                            text = <"Comentaris">
                            description = <"Informació narrativa addicional sobre les troballes durant l'examen físic no registrats a altres camps.">
                        >
                        ["at0012"] = <
                            text = <"Ampliació">
                            description = <"Informació addicional requerida per registrar contingut local o alinear amb altres models o formalismes.">
                        >
                        ["at0013"] = <
                            text = <"Posició">
                            description = <"Posició del pacient durant l'examen.">
                        >
                    >
                >
            >
