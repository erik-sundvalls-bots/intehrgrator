                    ["es"] = <
                        ["at0000"] = <
                            text = <"Prescripción médica">
                            description = <"Una prescripción para un medicamento, vacuna, producto nutricional o otro producto terapéutico para un individuo específico">
                        >
                        ["at0001"] = <
                            text = <"Prescripción">
                            description = <"Detalles de la prescripción solicitada">
                        >
                        ["at0002"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0004"] = <
                            text = <"*Order identifier(en)">
                            description = <"*Unique identifier for the medication order.(en)">
                        >
                        ["at0005"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0008"] = <
                            text = <"*Extension(en)">
                            description = <"*Additional information required to capture local content or to align with other reference models/formalisms.(en)">
                        >
                        ["at0009"] = <
                            text = <"*Overall directions description(en)">
                            description = <"*Complete narrative description about how the ordered item is to be used.(en)">
                        >
                        ["at0011"] = <
                            text = <"*Order start criterion(en)">
                            description = <"*A condition which, when met, requires the commencement of administration or use.(en)">
                        >
                        ["at0012"] = <
                            text = <"*Order start date/time(en)">
                            description = <"*The date and optional time to commence use of the ordered item.(en)">
                        >
                        ["at0013"] = <
                            text = <"*Order stop date/time(en)">
                            description = <"*The date and optional time when it is planned to cease use of the ordered item.(en)">
                        >
                        ["at0016"] = <
                            text = <"*Order stop criterion(en)">
                            description = <"*A condition which, when met, requires the cessation of administration or use.(en)">
                        >
                        ["at0018"] = <
                            text = <"*Clinical indication(en)">
                            description = <"*The clinical reason for use of the ordered item.(en)">
                        >
                        ["at0044"] = <
                            text = <"*Additional instruction(en)">
                            description = <"*An additional instruction on how to use or store the ordered item.(en)">
                        >
                        ["at0047"] = <
                            text = <"*Parsable directions(en)">
                            description = <"*A parsable, computable text representation of the directions.(en)">
                        >
                        ["at0050"] = <
                            text = <"*Duration of order completed(en)">
                            description = <"*The time period during which the individual/patient has already been using the ordered item as a part of the intended whole order but prior to the issuance of this order.(en)">
                        >
                        ["at0051"] = <
                            text = <"*Maximum dose(en)">
                            description = <"*Details about the maximum, cumulative dose allowed over a defined period for the ordered item.(en)">
                        >
                        ["at0053"] = <
                            text = <"*Allowed period(en)">
                            description = <"*The period of time during which the maximum dose is calculated.(en)">
                        >
                        ["at0060"] = <
                            text = <"*Administrations completed(en)">
                            description = <"*The number of administrations of the ordered item that have been completed, as part of the intended whole order but prior to the issuance of this order.(en)">
                        >
                        ["at0062"] = <
                            text = <"*Medication safety(en)">
                            description = <"*Details about medication safety for the ordered item.(en)">
                        >
                        ["at0064"] = <
                            text = <"*Exceptional safety override?(en)">
