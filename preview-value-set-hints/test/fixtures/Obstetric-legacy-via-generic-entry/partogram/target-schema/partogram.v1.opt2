                            description = <"Detalls estructurats addicionals sobre l'element ordenat no capturat en altres camps.">
                        >
                        ["at0167"] = <
                            text = <"Comentaris">
                            description = <"Narrativa addicional sobre l'ordre de medicació no capturada en altres camps.">
                        >
