            ["openEHR-EHR-CLUSTER.ovl-organisation-001.v1"] = <
                term_definitions = <
                    ["en"] = <
                        ["at0000"] = <
                            text = <"Organisation">
                            description = <"An entity comprising one or more people and having a particular purpose.">
                        >
                        ["at0001"] = <
                            text = <"Name">
                            description = <"The unstructured name or label for the organisation.">
                        >
                        ["at0002"] = <
                            text = <"Contact person">
                            description = <"Details about one or more people within the organisation.">
                        >
                        ["at0003"] = <
                            text = <"Identifier">
                            description = <"Identifier associated with the organisation.">
                        >
                        ["at0004"] = <
                            text = <"Role">
                            description = <"The relationship or role of the organisation to the individual or subject of care.">
                        >
                        ["at0005"] = <
                            text = <"Address">
                            description = <"Details about an address for the organisation.">
                        >
                        ["at0017"] = <
                            text = <"Additional details">
                            description = <"Additional details about the organisation.">
                        >
                        ["at0019"] = <
                            text = <"Comment">
                            description = <"Additional narrative about the organisation not captured in other fields.">
                        >
                        ["at0021"] = <
                            text = <"Parent organisation">
                            description = <"A larger organisation of which this organisation is a child or subsidiary.">
                        >
                        ["at0022"] = <
                            text = <"Electronic communication">
                            description = <"Details about one or more types of electronic communication for the organisation.">
                        >
                        ["at0000.1"] = <
                            text = <"Care provider">
                            description = <"An entity comprising one or more people and having a particular purpose.
In this context, the care provider is a government authority, region, municipality, other legal person or sole trader who conducts health care activities.">
                        >
                        ["at0003.1"] = <
                            text = <"Identifier">
                            description = <"Identifier associated with the organisation.
In this context, the identifier of the care provider.">
                        >
                        ["at0004.1"] = <
                            text = <"Role">
                            description = <"The relationship or role of the organisation to the individual or subject of care.
In this context, the role states that the organisation is of the type care provider.">
                        >
                        ["at0001.1"] = <
                            text = <"Name">
                            description = <"The unstructured name or label for the organisation.
In this context, the name of the care provider.">
                        >
                        ["at0003.2"] = <
                            text = <"Organisational number">
                            description = <"Identifier associated with the organisation.
In this context, the identifier of the care provider.">
                        >
                    >
                    ["nb"] = <
                        ["at0000"] = <
                            text = <"Organisasjon">
                            description = <"En entitet som består av ett eller flere mennesker med et bestemt formål.">
                        >
                        ["at0001"] = <
                            text = <"Navn">
                            description = <"Ustrukturert navn for organisasjonen.">
                        >
                        ["at0002"] = <
                            text = <"Kontaktperson">
                            description = <"Detaljer om én eller flere personer i organisasjonen.">
                        >
                        ["at0003"] = <
                            text = <"Identifikator">
                            description = <"Identifikator for organisasjonen.">
                        >
                        ["at0004"] = <
                            text = <"Rolle">
                            description = <"Forholdet eller rollen organisasjonen har til individet som pasientjournalen omhandler.">
                        >
                        ["at0005"] = <
                            text = <"Adresse">
                            description = <"Detaljer om organisasjonens adresse.">
                        >
                        ["at0017"] = <
                            text = <"Ytterligere detaljer">
                            description = <"Ytterligere strukturerte detaljer om organisasjonen.">
                        >
                        ["at0019"] = <
                            text = <"Kommentar">
                            description = <"Ytterligere fritekst om organisasjonen som ikke er registrert i andre felt.">
                        >
                        ["at0021"] = <
                            text = <"Overordnet organisasjon">
                            description = <"En større organisasjon som denne organisasjonen er en del av.">
                        >
                        ["at0022"] = <
                            text = <"Elektronisk kommunikasjon">
                            description = <"Detaljer om én eller flere former for elektronisk kommunikasjon med organisasjonen.">
                        >
                        ["at0003.2"] = <
                            text = <"Identifikator (2)">
                            description = <"Identifikator for organisasjonen.">
                        >
                    >
                    ["de"] = <
                        ["at0000"] = <
                            text = <"Organisation">
                            description = <"Eine Einheit, die aus einer oder mehreren Personen besteht und ein bestimmtes Ziel hat.">
                        >
                        ["at0001"] = <
                            text = <"Namenszeile">
                            description = <"Der Name oder Bezeichnung der Organisation in unstrukturierter Form.">
                        >
                        ["at0002"] = <
                            text = <"Kontaktperson">
                            description = <"Details zu einer oder mehreren Personen innerhalb der Organisation.">
                        >
                        ["at0003"] = <
                            text = <"Identifier">
                            description = <"Identifikator, der der identifizierten Organisation zugeordnet ist.">
                        >
                        ["at0004"] = <
                            text = <"Funktion">
                            description = <"Die Beziehung oder Rolle der Organisation zum Pflegebedürftigen oder Patient.">
                        >
                        ["at0005"] = <
                            text = <"Adresse">
                            description = <"Angaben zu einer Adresse der Organisation.">
                        >
                        ["at0017"] = <
                            text = <"Zusätzliche Details">
                            description = <"Weitere Angaben zur Organisation.">
                        >
                        ["at0019"] = <
                            text = <"Kommentar">
                            description = <"Zusätzlicher Text zu der Organisation, der in anderen Bereichen nicht erfasst wird.">
                        >
                        ["at0021"] = <
                            text = <"Muttergesellschaft">
                            description = <"Eine größere Organisation, von der diese Organisation ein Sub- oder Tochterunternehmen ist.">
                        >
                        ["at0022"] = <
                            text = <"Elektronische Kommunikation">
                            description = <"Details zu einer oder mehreren Arten der elektronischen Kommunikation für die Organisation.">
                        >
                        ["at0003.2"] = <
                            text = <"Identifier (2)">
                            description = <"Identifikator, der der identifizierten Organisation zugeordnet ist.">
                        >
                    >
                    ["sv"] = <
                        ["at0000"] = <
                            text = <"Organisation">
                            description = <"En organisatorisk entitet som består av en eller flera personer och som har ett särskilt syfte.">
                        >
                        ["at0001"] = <
                            text = <"Namn">
                            description = <"Namnet som en organisation är känd under.">
                        >
                        ["at0002"] = <
                            text = <"Kontaktperson">
                            description = <"Uppgifter om en eller flera kontaktpersoner inom organisationen.">
                        >
                        ["at0003"] = <
                            text = <"Identifierare">
                            description = <"Identifierare associerad med organisationen.">
                        >
                        ["at0004"] = <
                            text = <"Roll">
                            description = <"Organisationens relation till eller roll gentemot vårdtagaren.">
                        >
                        ["at0005"] = <
                            text = <"Adress">
                            description = <"Organisationens adressuppgifter.">
                        >
                        ["at0017"] = <
                            text = <"Ytterligare detaljer">
                            description = <"Ytterligare uppgifter om organisationen.">
                        >
                        ["at0019"] = <
                            text = <"Kommentar">
