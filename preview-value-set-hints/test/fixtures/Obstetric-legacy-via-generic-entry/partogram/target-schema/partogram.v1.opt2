                        >
                        ["at0011"] = <
                            text = <"Startkriterium">
                            description = <"Et vilkår for at den ordinerte varen kan tas i bruk.">
                        >
                        ["at0012"] = <
                            text = <"Startdato/tid for ordineringen">
                            description = <"Dato og valgfri tid for oppstart av den ordinerte varen.">
                        >
                        ["at0013"] = <
                            text = <"Dato/tid for seponering">
