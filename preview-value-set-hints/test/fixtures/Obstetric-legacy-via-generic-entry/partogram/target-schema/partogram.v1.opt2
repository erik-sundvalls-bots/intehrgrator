                            description = <"Strukturirane podrobnosti fizičnega pregleda.">
                        >
                        ["at0006"] = <
                            text = <"Interpretacija">
                            description = <"Posamezna beseda, besedna zveza ali kratek opis, ki predstavlja klinični pomen in pomembnost ugotovitev fizičnega pregleda.">
