                                        <term_definitions code="at0000">
                                            <items id="text">Vårdgivare</items>
                                            <items id="description">In identifierad organisationsenhet eller en informell grupp.</items>
                                            <items id="comment">Exempelvis företag, institution, avdeling, enhet, förening, vårdgivare, försäkringsbolag, vårdteam, eller en grupp grannar som fungerar som stöd.</items>
                                        </term_definitions>
                                        <term_definitions code="at0001">
                                            <items id="text">Namn</items>
                                            <items id="description">Namnet som en organisation är känd för.</items>
                                            <items id="comment">Exempelvis: 'Royal Children's Hospital'; 'ABC District Nursing Service'; 'YNWA Oslo' or 'JB Smith Lawyers'.</items>
                                        </term_definitions>
                                        <term_definitions code="at0002">
                                            <items id="text">Kontaktperson</items>
                                            <items id="description">Detaljer om en eller flera personer inom organisationen.</items>
                                        </term_definitions>
                                        <term_definitions code="at0003">
                                            <items id="text">Identifierare</items>
                                            <items id="description">Identifierare associerad med den identifierade organisationen.</items>
                                            <items id="comment">Förekomster (Occurrences) för detta dataelement är satt till 0..* för att tillåta att mer än en identifierare kan användas samtidigt. Observera att ID-datatypen innehåller flera underkomponenter för ID-värde, typ, utfärdare och tilldelare.</items>
                                        </term_definitions>
                                        <term_definitions code="at0004">
                                            <items id="text">Roll</items>
                                            <items id="description">Den roll eller kapacitet i vilken organisationen bidrar till vårdpersonens hälsa eller sociala vård.</items>
                                            <items id="comment">*For example: oncologist; palliative care home nursing service; or informal support network. (en)</items>
                                        </term_definitions>
                                        <term_definitions code="at0005">
                                            <items id="text">Adress</items>
                                            <items id="description">Detaljer om en specifik adress för organisationen.</items>
                                        </term_definitions>
                                        <term_definitions code="at0017">
                                            <items id="text">Ytterligare detaljer</items>
                                            <items id="description">Ytterligare detaljer om organisationen.</items>
                                        </term_definitions>
                                        <term_definitions code="at0019">
                                            <items id="text">Kommentar</items>
                                            <items id="description">Beskrivning av organisationen som inte kunnat anges i övriga fält.</items>
                                        </term_definitions>
                                        <term_definitions code="at0021">
                                            <items id="text">Överordnad organisation</items>
                                            <items id="description">En större organisation som denna organisation är en del av.&#13;
</items>
                                        </term_definitions>
                                        <term_definitions code="at0022">
                                            <items id="text">Elektronisk kommunikation</items>
                                            <items id="description">Detaljer om en viss typ av elektronisk kommunikation för organisationen.</items>
                                        </term_definitions>
                                        <term_definitions code="http://snomed.info/sct/45991000052106::143591000052106">
                                            <items id="text">vårdgivare</items>
                                        </term_definitions>
                                    </children>
