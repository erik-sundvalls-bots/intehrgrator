                                <term_definitions code="at0000">
                                    <items id="text">Läkemedelsregim</items>
                                    <items id="description">*Medication regimen (en)</items>
                                </term_definitions>
                                <term_definitions code="at0001">
                                    <items id="text">Regim</items>
                                    <items id="description">*The name of the medication regimen which was in place when the medication was prescribed/administered.

This can be coded if required, possibly derived from a registry such as https://kunskapsbanken.cancercentrum.se/om-kakor/ (en)</items>
                                    <items id="comment">*For example: 'Atezolizumab -Nab-Paklitaxel'  (en)</items>
                                </term_definitions>
                                <term_definitions code="at0027">
                                    <items id="text">Kurnummer</items>
                                    <items id="description"></items>
                                </term_definitions>
                                <term_definitions code="at0030">
                                    <items id="text">Kurdag</items>
                                    <items id="description"></items>
                                </term_definitions>
                                <term_definitions code="at0031">
                                    <items id="text">Protokollversion</items>
                                    <items id="description">*The version of the regimen protocol used.  (en)</items>
                                    <items id="comment">*For example: '1.3' (en)</items>
                                </term_definitions>
