                                    <items id="description">Namnet som en organisation är känd för.</items>
                                    <items id="comment">Exempelvis: 'Royal Children's Hospital'; 'ABC District Nursing Service'; 'YNWA Oslo' or 'JB Smith Lawyers'.</items>
                                </term_definitions>
                                <term_definitions code="at0002">
                                    <items id="text">Kontaktperson</items>
                                    <items id="description">Detaljer om en eller flera personer inom organisationen.</items>
                                </term_definitions>
                                <term_definitions code="at0003">
                                    <items id="text">Identifierare</items>
                                    <items id="description">Vårdenhetens identifierare, i Sverige vanligen ett HSA-id</items>
                                    <items id="comment">Se https://openehr.atlassian.net/wiki/spaces/healthmod/pages/1922990156/HSA-identitet+och+Organisationsnummer och https://openehr.atlassian.net/wiki/spaces/healthmod/pages/1893105737/PDL+i+openEHR#vg_ve
 </items>
                                </term_definitions>
                                <term_definitions code="at0004">
                                    <items id="text">Roll</items>
                                    <items id="description">Organisationens relation eller roll till till individen eller patienten</items>
                                    <items id="comment">Se https://openehr.atlassian.net/wiki/spaces/healthmod/pages/1922990156/HSA-identitet+och+Organisationsnummer och https://openehr.atlassian.net/wiki/spaces/healthmod/pages/1893105737/PDL+i+openEHR#vg_ve
 </items>
                                </term_definitions>
                                <term_definitions code="at0005">
                                    <items id="text">Adress</items>
                                    <items id="description">Detaljer om en specifik adress för organisationen.</items>
                                </term_definitions>
                                <term_definitions code="at0017">
                                    <items id="text">Ytterligare detaljer</items>
                                    <items id="description">Ytterligare detaljer om organisationen.</items>
                                </term_definitions>
                                <term_definitions code="at0019">
                                    <items id="text">Kommentar</items>
                                    <items id="description">Beskrivning av organisationen som inte kunnat anges i övriga fält.</items>
                                </term_definitions>
                                <term_definitions code="at0021">
                                    <items id="text">Överordnad organisation</items>
                                    <items id="description">En större organisation som denna organisation är en del av.&#13;
</items>
                                </term_definitions>
                                <term_definitions code="at0022">
                                    <items id="text">Elektronisk kommunikation</items>
                                    <items id="description">Detaljer om en viss typ av elektronisk kommunikation för organisationen.</items>
                                </term_definitions>
                                <term_definitions code="http://snomed.info/sct/900000000000207008::43741000">
                                    <items id="text">vårdenhet</items>
                                </term_definitions>
                            </children>
