                        <archetype_id>
                            <value>openEHR-EHR-ACTION.medication.v1</value>
                        </archetype_id>
                        <term_definitions code="at0000">
                            <items id="text">Schemalagd administrering per substans</items>
                            <items id="description">Alla aktiviteter relaterade till planering, schemaläggning, recepthantering, utdelning, administrering, upphörande, vaccin, näringsprodukt och annan användning av ett läkemedel eller annan behandlings produkt.</items>
                            <items id="comment">Detta är inte begränsat till aktiviteter som utförs bara baserat på remiss på läkemedel från kliniker, utan kan också inkludera till exempel övertagande av partikelräknare medicinering.</items>
                        </term_definitions>
                        <term_definitions code="at0002">
                            <items id="text">Recept utfärdat</items>
                            <items id="description">Ett recept har utfärdats för medicinering.</items>
                        </term_definitions>
                        <term_definitions code="at0003">
                            <items id="text">Recept utdelat</items>
                            <items id="description">Det beställda läkemedlet har delats ut, till exempel från ett apotek till patienten.</items>
                        </term_definitions>
                        <term_definitions code="at0004">
                            <items id="text">Läkemedels kuren påbörjades</items>
                            <items id="description">Läkemedlet har börjats användas eller administrerats till patienten för första gången. i vissa delar av sjukvården registrering av detta betydelsefulla datum räknas som första administrations uppgift. i andra delar såsom primärvård räknas inte det som det tillgängliga specifika administrationsdatum.</items>
                        </term_definitions>
                        <term_definitions code="at0005">
                            <items id="text">Läkemedlet omprövades</items>
                            <items id="description">Det enskilda läkemedlet har omvärderats, till exempel om medicinen fortfarande ska tas av patienten. Detta är inte avsett att fånga en översyn av läkemedelslistan.</items>
                        </term_definitions>
                        <term_definitions code="at0006">
                            <items id="text">Dos administrerad</items>
                            <items id="description">En enda administrering av läkemedlet har ägt rum.</items>
                        </term_definitions>
                        <term_definitions code="at0007">
                            <items id="text">Läkemedelskuren slutförd</items>
                            <items id="description">Läkemedelskuren har slutförts som planerat.</items>
                        </term_definitions>
                        <term_definitions code="at0008">
                            <items id="text">Receptleverans försenad</items>
                            <items id="description">Receptet har inte delats ut på grund av ett tekniskt eller farmaceutiskt problem.</items>
                        </term_definitions>
                        <term_definitions code="at0009">
                            <items id="text">Administrationer avstängda</items>
                            <items id="description">Administreringen av läkemedlet har avbrutits tills vidare. Inga ytterligare doser ska ges förrän omstartdatumet är bestämt eller villkoren har uppfyllts. När du ställer in datum / villkor för omstart efter avstängning, ska gå från steg 'Administrationer avbryts' tillbaka till 'Läkemedelsstartdatum / tillståndssätt' utföras.&#13;
</items>
                        </term_definitions>
                        <term_definitions code="at0010">
                            <items id="text">Recept utfärdat på nytt</items>
                            <items id="description">Ett recept har utfärdats för en befintlig läkemedelsordination.</items>
                        </term_definitions>
                        <term_definitions code="at0011">
                            <items id="text">Receptansökan om godkännande väntar</items>
                            <items id="description">Utfärdandet av receptet väntar på godkännande av en läkare.&#13;
</items>
                        </term_definitions>
                        <term_definitions code="at0012">
                            <items id="text">Avbruten läkemedelsbehandling</items>
                            <items id="description">Den planerade medicineringen har avbrutits före administrering.</items>
                        </term_definitions>
                        <term_definitions code="at0013">
                            <items id="text">läkemedelsbehandling skjutits upp</items>
                            <items id="description">Den schemalagda läkemedelskursen har skjutits upp före administrering.</items>
                        </term_definitions>
                        <term_definitions code="at0015">
                            <items id="text">Läkemedels kuren slutade</items>
                            <items id="description">Administreringen av läkemedlet har upphört under den planerade kur perioden.&#13;
</items>
                        </term_definitions>
                        <term_definitions code="at0016">
                            <items id="text">Läkemedlets startdatum eller startvillkor inställt</items>
                            <items id="description">Tiden för att starta medicinen, eller annat starttillstånd, har ställts in.</items>
                        </term_definitions>
                        <term_definitions code="at0017">
                            <items id="text">Tree</items>
                            <items id="description">@ internal @</items>
                        </term_definitions>
                        <term_definitions code="at0018">
                            <items id="text">Administration av dosen är utelämnad</items>
                            <items id="description">En administrering av läkemedlets dos har avbrutits. Det förväntas inte att det kommer att utföras klart senare heller, även om det skulle göras enligt den ursprungliga ordinationen.</items>
                        </term_definitions>
                        <term_definitions code="at0020">
                            <items id="text">Läkemedelsföremål</items>
                            <items id="description">Namnet på medicinen, vaccinet eller andra behandlings/ förskrivningsbara föremål som var fokus för aktiviteten.</items>
                            <items id="comment">Till exempel: 'Atenolol 100 mg' eller 'Tenormin tabletter 100 mg'.&#13;
Det rekommenderas starkt att ”Läkemedelsartikeln” är kodad med en terminologi som kan trigga igång beslutsstödet, där det är möjligt. Kodningens omfattning kan variera från det enkla namnet på läkemedelsartikeln till strukturerade detaljer om det faktiska läkemedelspaket som används. Fri textinmatning bör endast användas om det inte finns någon lämplig terminologi tillgänglig.</items>
                        </term_definitions>
                        <term_definitions code="at0021">
                            <items id="text">Orsak</items>
                            <items id="description">Anledningen till att vägsteget för det identifierade läkemedlet genomfördes.</items>
                            <items id="comment">Till exempel: 'Uppskjuten - Patient inte tillgänglig vid administreringstid', 'Avbruten - Biverkning'. Obs: Detta är inte orsaken till medicin instruktionen, utan snarare den specifika anledningen till att ett vårdsteg genomfördes och kommer ofta att användas för att dokumentera en viss avvikelse från den ursprungliga beställningen.</items>
                        </term_definitions>
                        <term_definitions code="at0024">
                            <items id="text">Kommentar</items>
                            <items id="description">Ytterligare redogörelse för aktiviteten eller sökvägen som inte har registrerats i andra fält, inklusive information om eventuell avvikelse mellan den avsedda åtgärden och den faktiska utförda åtgärden.</items>
                            <items id="comment">Till exempel: 'Patienten var på röntgenavdelningen', 'Oavsiktlig injektion i blodkärlet under IM-administrering'.</items>
                        </term_definitions>
                        <term_definitions code="at0025">
                            <items id="text">Sekvensnummer</items>
                            <items id="description">Sekvensnumret som är specifikt för sökvägen</items>
                            <items id="comment">Till exempel: Vaccinsekvensnummer.&#13;
</items>
                        </term_definitions>
                        <term_definitions code="at0030">
                            <items id="text">Tree</items>
                            <items id="description">@ internal @</items>
                        </term_definitions>
                        <term_definitions code="at0033">
                            <items id="text">Patientvägledning</items>
                            <items id="description">All vägledning, instruktioner eller råd som ges till ämnet vård eller personlig vårdperson vid tidpunkten för vägsteget.</items>
                            <items id="comment">Till exempel: 'Undvik grapefrukt', 'Ta minst två timmar före sänggåendet', 'Ta med mat'. Kan kodas med en terminologi när det är kliniskt lämpligt.</items>
                        </term_definitions>
                        <term_definitions code="at0039">
                            <items id="text">Stor förändring i beställning</items>
                            <items id="description">En större ändring av beställningen krävdes, vilket resulterade i att denna order stoppades och en ersättnings order startades.&#13;
</items>
                        </term_definitions>
                        <term_definitions code="at0041">
                            <items id="text">Mindre ändring i läkemedelsordination</items>
                            <items id="description">Läkemedelsordination har ändrats på ett sätt som inte kräver så att en ny instruktion/ordination ska utfärdas, detta enligt lokala kliniska regler.</items>
                        </term_definitions>
                        <term_definitions code="at0043">
                            <items id="text">Ursprungligt schemalagt datum / tid</items>
                            <items id="description">Den tidpunkt då medicineringsåtgärden var planerad att inträffa.</items>
                            <items id="comment">Används för att jämföra avvikelse från faktisk åtgärdstid där detta inte är lätt att beräkna från original instruktionen.</items>
                        </term_definitions>
                        <term_definitions code="at0044">
                            <items id="text">Dosadministrationen uppskjuten</items>
                            <items id="description">En dos av läkemedlet har försenats men förväntas ges så snart som möjligt.</items>
                        </term_definitions>
                        <term_definitions code="at0053">
                            <items id="text">Ytterligare detaljer</items>
                            <items id="description">Ytterligare strukturerade detaljer om aktiviteten, eventuellt specifika för ett vägval.</items>
                        </term_definitions>
                        <term_definitions code="at0085">
                            <items id="text">Förlängning</items>
                            <items id="description">Ytterligare information krävs för att fånga lokalt innehåll eller för att anpassa sig till andra referensmodeller / formalismer.&#13;
</items>
                            <items id="comment">Till exempel: lokala informationskrav eller ytterligare metadata för att anpassa sig till FHIR- eller CIMI-ekvivalenter.&#13;
</items>
                        </term_definitions>
                        <term_definitions code="at0103">
                            <items id="text">Order ID</items>
                            <items id="description">Unik identifierare för läkemedelsbeställningen. RekvisitionsID för ordination där ordination innehåller flera kurdagar. </items>
                            <items id="comment">Beställnings-ID vid ordination av hel kur.</items>
                        </term_definitions>
                        <term_definitions code="at0104">
                            <items id="text">Läkemedelsinformation</items>
                            <items id="description">Strukturerade detaljer om läkemedlet inklusive styrka, form och beståndsdelar.</items>
                            <items id="comment">Använd denna SLOT där den detaljerade beskrivningen av den utdelade, auktoriserade eller administrerade artikeln måste anges uttryckligen. Till exempel: form, styrka, eventuella utspädningsmedel eller blandning av ingredienser.</items>
                        </term_definitions>
                        <term_definitions code="at0106">
                            <items id="text">Receptet godkännts på nytt</items>
                            <items id="description">Den ursprungliga läkemedelsordination har godkänts på nytt för att möjliggöra upprepad recept eller utdelning. I vissa jurisdiktioner måste en helt ny beställning utfärdas under dessa situationer.</items>
                        </term_definitions>
                        <term_definitions code="at0109">
                            <items id="text">Läkemedel rekommenderad</items>
                            <items id="description">Läkemedlet har rekommenderats men inga åtgärder har vidtagits för att börja med läkemedelsförskrivning.</items>
                        </term_definitions>
                        <term_definitions code="at0131">
                            <items id="text">Mängd</items>
                            <items id="description">Specifika detaljer om mängden av läkemedelsartikeln.</items>
                            <items id="comment">CLUSTER.dosage är avsett att innehålla information om ändringar av läkemedelsbeställningar eller dosadministrationer, medan CLUSTER.medication_supply_amount är avsedd för information om doseringsrelaterad aktivitet.</items>
                        </term_definitions>
                        <term_definitions code="at0132">
                            <items id="text">Utbyte</items>
                            <items id="description">Ersättningsåtgärder som vidtas av den person som administrerar eller delar ut läkemedlet.</items>
                            <items id="comment">I många jurisdiktioner är det möjligt utbyte/ersättning av en beställd artikel som har en generisk form eller med ett annat varumärke. Detta är möjligt om det är tillåtet vid utdelning eller leverans (om det har fastställts som bioekvivalent). I andra fall, klinikern måste uttryckligen begära att inte bytas ut.&#13;
</items>
                        </term_definitions>
                        <term_definitions code="at0133">
                            <items id="text">Anledningar till byte</items>
                            <items id="description">Orsaken eller motiveringen till utbytet är tagen.</items>
                            <items id="comment">Till exempel: "Generiskt alternativ innehåller ett ämne som inte tolereras av patienten." Kan kodas med en terminologi när det är kliniskt lämpligt.</items>
                        </term_definitions>
                        <term_definitions code="at0138">
                            <items id="text">Utbyte utfört</items>
                            <items id="description">Ett läkemedel ersattes som är bioekvivalent med det som har beställts.</items>
                        </term_definitions>
                        <term_definitions code="at0139">
                            <items id="text">Ersättning inte utförd</items>
                            <items id="description">Även om det tillåts av läkemedelsbeställningen ersattes inte ett bioekvivalent läkemedel.</items>
                        </term_definitions>
                        <term_definitions code="at0140">
                            <items id="text">Administrationsinformation</items>
                            <items id="description">Detaljer om lokalisation (hur tas i kroppen) och administrering av medicinen.</items>
                        </term_definitions>
                        <term_definitions code="at0141">
                            <items id="text">Anatomisk lokalisation</items>
                            <items id="description">Strukturerad beskrivning av administrering av den beställda artikeln/medicin</items>
                            <items id="comment">Till exempel: "vänster överarm", "intravenös kateter högra hand". Det föredras kodning av kroppsstället med en terminologi , där det är möjligt.</items>
                        </term_definitions>
                        <term_definitions code="at0142">
                            <items id="text">Strukturerad anatomisk lokalisation</items>
                            <items id="description">Strukturerad beskrivning av administreringsstället för läkemedlet, vaccinet eller den lämpliga behandlingen.</items>
                            <items id="comment">Till exempel: "På den mediala hudytan på vänster underarm, från 10 cm till 20 cm distalt från armbågens punkt".</items>
                        </term_definitions>
                        <term_definitions code="at0143">
                            <items id="text">Administrations metod</items>
                            <items id="description">Tekniken eller anordningen som den beställda artikeln administrerades eller ska administreras.</items>
                            <items id="comment">Kommentar: Till exempel: 'via Z-track-injektion'; "via nebulisator". Rekommenderas kodning av metoden med en terminologi, där det är möjligt.</items>
                        </term_definitions>
                        <term_definitions code="at0144">
                            <items id="text">Administrations enhet</items>
                            <items id="description">Detaljer om den medicinska enheten som används för att hjälpa till med läkemedlet.</items>
                        </term_definitions>
                        <term_definitions code="at0145">
                            <items id="text">Förskrivning väntar på auktorisering</items>
                            <items id="description">Utkast till förskrivning/recept har utarbetats och väntar på bekräftelse från en auktoriserad läkare. Kan användas där auktorisationer utförs som en uppsättning. Denna careflow_step kan ha statusen "planerad" eller "aktiv", vilket återspeglar behovet av att hantera nya ordination såväl som obehöriga ordination.&#13;
</items>
                        </term_definitions>
                        <term_definitions code="at0147">
                            <items id="text">Administreringsväg</items>
                            <items id="description">Beskriver genom vilken väg den beställda artikeln ska tas eller ska tas in i anatomisk lokalisation.</items>
                            <items id="comment">Kommentar: Till exempel: 'oral', 'intravenös' eller 'aktuell'. Det föredras kodning av vägen med en terminologi, om det finns möjlighet. Flera potentiella vägar kan specificeras.</items>
                        </term_definitions>
                        <term_definitions code="at0148">
                            <items id="text">Läkemedel förberedd</items>
                            <items id="description">Läkemedlet har förberetts fysiskt. Till exempel: beredning av en intravenös blandning.</items>
                        </term_definitions>
                        <term_definitions code="at0149">
                            <items id="text">Dubbelkollade?</items>
                            <items id="description">Vägsteget har kontrollerats av en separat person.&#13;
</items>
                            <items id="comment">Detaljer om den person som utför dubbelkontrollen kan anges i referensmodellelementet "Deltagande".</items>
                        </term_definitions>
                        <term_definitions code="at0150">
                            <items id="text">Recept avbrutet</items>
                            <items id="description">Receptet avbröts innan det utfärdades.&#13;
</items>
                        </term_definitions>
                        <term_definitions code="at0151">
                            <items id="text">Receptet är ogiltigt eller upphört att gälla</items>
                            <items id="description">Receptet har ogiltigförklarats eller har upphört att gälla utan att det har utförts klart.&#13;
</items>
                        </term_definitions>
                        <term_definitions code="at0152">
                            <items id="text">Receptet utfört</items>
                            <items id="description">Receptet har utförts framgångsrikt.&#13;
</items>
                        </term_definitions>
                        <term_definitions code="at0153">
                            <items id="text">Läkemedlet är godkänt</items>
                            <items id="description">Läkemedlet har formellt godkänts för användning.</items>
                        </term_definitions>
                        <term_definitions code="at0154">
                            <items id="text">Datum och tid för Omstart</items>
                            <items id="description">Datum/tid då läkemedelskuren är inställd på att starta om, enligt tidigare steget "Administrationer avstängd".</items>
                            <items id="comment">Till exempel: 2017-10-29</items>
                        </term_definitions>
                        <term_definitions code="at0155">
                            <items id="text">Omstart av kriterium</items>
                            <items id="description">kriterium som triggar igång så att läkemedelskuren startas om enligt steget "Administrationer avstängd".</items>
                            <items id="comment">Till exempel: "På dag 2 efter operationen".</items>
                        </term_definitions>
                        <term_definitions code="at0156">
                            <items id="text">Klinisk indikation</items>
                            <items id="description">Den kliniska orsaken till läkemedelsaktiviteten.</items>
                            <items id="comment">Till exempel: 'Angina' eller 'Pain'. Kodning av indikationen med en terminologi rekommenderas. självklart där det går att hitta terminologibindning. Detta dataelement tillåter flera händelser. Om endast en ACTION används för att registrera en medicin indikation kan detta dataelement användas utan adderande hänsyn. Men om en klinisk indikation registreras för både INSTRUKTIONEN för läkemedelsbeställningen och ACTION för läkemedelshantering, var medveten om att dessa indikationer kanske inte är konsekventa. "</items>
                        </term_definitions>
                    </children>
                    <cardinality>
                        <is_ordered>false</is_ordered>
                        <is_unique>false</is_unique>
                        <interval>
                            <lower_included>true</lower_included>
                            <upper_included>false</upper_included>
                            <lower_unbounded>false</lower_unbounded>
                            <upper_unbounded>true</upper_unbounded>
                            <lower>1</lower>
                        </interval>
                    </cardinality>
                </attributes>
