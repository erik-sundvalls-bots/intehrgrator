<term_definitions code="at0000.1">
    <items id="text">Varaktighet</items>
    <items id="description">Följdfråga som kan användas t.ex. i frågeformulär efter att ha svarat "Ja" på frågor som "upplever du några symtom på..."</items>
</term_definitions>
