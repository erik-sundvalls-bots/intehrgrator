                        <archetype_id>
                            <value>openEHR-EHR-CLUSTER.followup_question.v0</value>
                        </archetype_id>
                        <term_definitions code="at0000">
                            <items id="text">följdfråga</items>
                            <items id="description">Följdfråga som kan användas t.ex. i frågeformulär efter att ha svarat "Ja" på frågor som "upplever du några symtom på..."</items>
                        </term_definitions>
                        <term_definitions code="at0002">
                            <items id="text">Hur påverkar tröttheten ditt dagliga liv?</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0004">
                            <items id="text">ytterligare följdfrågedetaljer</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0.16">
                            <items id="text">Lätt trötthet, vilar mer än vanligt</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0.17">
                            <items id="text">Måttlig trötthet, vilar mindre än 50% av vaken tid</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0.18">
                            <items id="text">Svår trötthet, vilar mer än 50% av vaken tid</items>
                            <items id="description"></items>
                        </term_definitions>
                    </children>
