                <archetype_id>
                    <value>openEHR-EHR-OBSERVATION.symptom_sign_screening.v1</value>
                </archetype_id>
                <term_definitions code="at0000">
                    <items id="text">Frågeformulär för symptom och andra tecken</items>
                    <items id="description">Lista av frågor och tillhörande svarsalternativ, används för att screena efter symtom eller tecken.</items>
                    <items id="comment">Svaren kan vara självrapporterade.</items>
                </term_definitions>
                <term_definitions code="at0001">
                    <items id="text">History</items>
                    <items id="description">@ internal @</items>
                </term_definitions>
                <term_definitions code="at0002">
                    <items id="text">Ospecificerad händelse</items>
                    <items id="description">Ospecificerad standardhändelse vid en tidpunkt eller inom ett tidsintervall som explicit kan definieras i en mall eller genereras automatiskt av vissa IT-system.</items>
                </term_definitions>
                <term_definitions code="at0003">
                    <items id="text">Tree</items>
                    <items id="description">@ internal @</items>
                </term_definitions>
                <term_definitions code="at0004">
                    <items id="text">Symptom/tecken-benämning</items>
                    <items id="description">Benämning på det symptom eller annat tecken (eller grupp av dessa) som screenas.&#13;
&#13;
</items>
                    <items id="comment">Kodning av 'Symtom/teckennamn' med en terminologi är att föredra, om möjligt.</items>
                </term_definitions>
                <term_definitions code="at0005">
                    <items id="text">Närvarande?</items>
                    <items id="description">Har symptomet eller tecknet förekommit?</items>
                    <items id="comment">I en mall skulle dataelementet vanligtvis döpas om till den specifika fråga som ställdes till användaren. De föreslagna svarsalternativen kan anpassas för lokal användning genom att välja DV_TEXT eller DV_BOOLEAN datatyper för att matcha varje specifikt användningsfall.</items>
                </term_definitions>
                <term_definitions code="at0007">
                    <items id="text">Item tree</items>
                    <items id="description">@ internal @</items>
                </term_definitions>
                <term_definitions code="at0021">
                    <items id="text">Tilläggsinformation</items>
                    <items id="description">Plats för att infoga tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items>
                    <items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR- eller CIMI-motsvarigheter.</items>
                </term_definitions>
                <term_definitions code="at0022">
                    <items id="text">Specifika symptom/tecken</items>
                    <items id="description">Detaljer om ett specifikt symptom eller tecken eller gruppering av symtom eller tecken som är relevanta för screeningändamålet.</items>
                </term_definitions>
                <term_definitions code="at0023">
                    <items id="text">Ja</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0024">
                    <items id="text">Nej</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0026">
                    <items id="text">Ytterligare detaljer</items>
                    <items id="description">Ytterligare detaljer relaterade till det specifika symptomet eller tecknet.</items>
                </term_definitions>
                <term_definitions code="at0027">
                    <items id="text">Okänt</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0028">
                    <items id="text">Förekommer några symptom eller andra tecken?</items>
                    <items id="description">Har det förekommit några symtom eller tecken som är relevanta för screeningändamålet?</items>
                    <items id="comment">I en mall skulle dataelementet vanligtvis döpas om till den specifika fråga som ställdes. Den föreslagna svarsalternativen kan anpassas för lokal användning genom att använda datatyperna DV_TEXT eller DV_BOOLEAN för att matcha varje specifikt användningsfall</items>
                </term_definitions>
                <term_definitions code="at0029">
                    <items id="text">Debut</items>
                    <items id="description">Datum/tid då symptom eller andra tecken relevanta för screeningändamålet först upptäcktes.</items>
                    <items id="comment">"Debut"-dataelementet har medvetet modellerats flexibelt för att stödja de otaliga sätt som det kan användas i frågeformulär för att fånga uppkomsten av symtom eller tecken. Den specifika och avsedda semantiken kan ytterligare förtydligas i en mall.&#13;
&#13;
Till exempel:&#13;
Datum/tid för när symtomet började. Intervall för datum/tid under en tidsperiod, t.ex. mellan 1940 och 1942. Text för beskrivningar som 'Omedelbart efter operationen' eller 'Upp till en vecka sedan', 'Upp till två veckor sedan', 'Tre veckor sedan'. Varaktighet (duration) för individens ålder vid debut. Intervall av Varaktighet (duration) för individens ungefärliga ålder vid tidpunkten för debut.</items>
                </term_definitions>
                <term_definitions code="at0031">
                    <items id="text">Ja</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0032">
                    <items id="text">Nej</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0033">
                    <items id="text">Okänt</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0034">
                    <items id="text">Screeningssyfte</items>
                    <items id="description">Sammanhang eller orsak till screening.</items>
                    <items id="comment">Detta dataelement är avsett att ange sammanhanget för frågor/svar-grupperna när formuläret efterfrågas vid ett senare tillfälle. Det förväntas inte att detta dataelement kommer att visas för användarna som fyller i formuläret, utan endast lagras i data.&#13;
&#13;
Exempel: "screening inför inskrivning" eller namnet på själva frågeformuläret.</items>
                </term_definitions>
                <term_definitions code="at0035">
                    <items id="text">Kommentar</items>
                    <items id="description">Kommentarer avseende det specifika symptomet eller tecknrt som inte beskrivs i övriga fält.</items>
                </term_definitions>
                <term_definitions code="at0036">
                    <items id="text">Beskrivning</items>
                    <items id="description">Beskrivning om alla symptom eller andra tecken relevanta för screeningändamålet</items>
                </term_definitions>
                <term_definitions code="at0037">
                    <items id="text">Debut</items>
                    <items id="description">Datum/tid då symptomet eller tecknet först upptäcktes.</items>
                    <items id="comment">"Debut"-dataelementet har medvetet modellerats flexibelt för att stödja de otaliga sätt som det kan användas i frågeformulär för att fånga uppkomsten av symtom eller tecken. Den specifika och avsedda semantiken kan ytterligare förtydligas i en mall.&#13;
&#13;
Till exempel:&#13;
Datum/tid för när symtomet började. Intervall för datum/tid under en tidsperiod, t.ex. mellan 1940 och 1942. Text för beskrivningar som 'Omedelbart efter operationen' eller 'Upp till en vecka sedan', 'Upp till två veckor sedan', 'Tre veckor sedan'. Varaktighet (duration) för individens ålder vid debut. Intervall av Varaktighet (duration) för individens ungefärliga ålder vid tidpunkten för debut.</items>
                </term_definitions>
                <term_definitions code="at0039">
                    <items id="text">Screening-detaljer eller frågor</items>
                    <items id="description">Strukturerade detaljer eller frågor relaterade till screening av symptom och tecken</items>
                </term_definitions>
                <term_definitions code="SNOMED-CT::385785003">
                    <items id="text">utvärdering av cytostatikabehandling</items>
                </term_definitions>
