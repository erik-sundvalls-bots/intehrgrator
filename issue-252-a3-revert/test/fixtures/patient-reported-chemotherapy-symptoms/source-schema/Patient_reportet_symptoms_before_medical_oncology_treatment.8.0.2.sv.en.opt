                        </term_definitions>
                        <term_definitions code="local_terms::1">
                            <items id="text">Lätta stickningar/pirrningar/domningar men har full känsel</items>
                        </term_definitions>
                        <term_definitions code="local_terms::2">
                            <items id="text">Måttliga stickningar/pirrningar/domningar med lätt känselnedsättning</items>
                        </term_definitions>
                        <term_definitions code="local_terms::3">
                            <items id="text">Svåra stickningar/pirrningar/domningar med svår känselnedsättning</items>
                        </term_definitions>
                        <term_definitions code="local_terms::4">
                            <items id="text">Har ingen känsel i angivet område</items>
                        </term_definitions>
