                <archetype_id>
                    <value>openEHR-EHR-CLUSTER.general_treatment_questions.v0</value>
                </archetype_id>
                <term_definitions code="at0000">
                    <items id="text">generella behandlingsrelaterade frågor</items>
                    <items id="description">Några avslutande frågor angående tidigare och kommande behandling; försämring av symtom eller ytterligare symtom och frågor.</items>
                </term_definitions>
                <term_definitions code="at0003">
                    <items id="text">Har något eller några av de symptom du skattat förvärrats sedan föregående behandling?</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0004">
                    <items id="text">Ja</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0005">
                    <items id="text">Nej</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0007">
                    <items id="text">Vilka symptom har förvärrats?</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0008">
                    <items id="text">Har du ytterligare biverkningar som du vill förmedla eller förtydliga för oss?</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0009">
                    <items id="text">Ja</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0010">
                    <items id="text">Nej</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0011">
                    <items id="text">Beskriv vilka ytterligare biverkningar:</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0012">
                    <items id="text">Har du någon fråga inför kommande behandling?</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0013">
                    <items id="text">Ja</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0014">
                    <items id="text">Nej</items>
                    <items id="description"></items>
                </term_definitions>
                <term_definitions code="at0015">
                    <items id="text">Beskriv din fråga:</items>
                    <items id="description"></items>
                </term_definitions>
            </children>
