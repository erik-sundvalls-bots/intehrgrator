                        <term_definitions code="at0000">
                            <items id="text">följdfråga</items>
                            <items id="description">Följdfråga som kan användas t.ex. i frågeformulär efter att ha svarat "Ja" på frågor som "upplever du några symtom på..."</items>
                        </term_definitions>
                        <term_definitions code="at0002">
                            <items id="text">Hur bedömer du förändringarna av naglarna?</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0004">
                            <items id="text">ytterligare följdfrågedetaljer</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0.1">
                            <items id="text">Lätta, t.ex. färgförändringar, räfflor</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0.2">
                            <items id="text">Måttliga, t.ex. smärta under nageln</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0.3">
                            <items id="text">Svåra, t.ex. avlossning av nagel, helt eller delvis</items>
                            <items id="description"></items>
                        </term_definitions>
                    </children>
