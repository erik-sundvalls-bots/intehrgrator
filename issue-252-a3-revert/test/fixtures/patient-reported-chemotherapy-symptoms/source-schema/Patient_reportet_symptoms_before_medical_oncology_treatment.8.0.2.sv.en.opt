                <term_definitions code="at0021">
                    <items id="text">Mätplats</items>
                    <items id="description">Enkel beskrivning av mätplatsen.</items>
                </term_definitions>
                <term_definitions code="at0022">
                    <items id="text">Mun</items>
                    <items id="description">Temperaturen mäts i munnen.</items>
                </term_definitions>
                <term_definitions code="at0023">
                    <items id="text">Hörselgång</items>
                    <items id="description">Temperaturen mäts inifrån den externa hörselgången.</items>
                </term_definitions>
                <term_definitions code="at0024">
                    <items id="text">Axill</items>
                    <items id="description">Temperaturen mäts på armens hud, med armen placerad nedåt vid sidan.</items>
                </term_definitions>
                <term_definitions code="at0025">
                    <items id="text">Rektum</items>
                    <items id="description">Temperaturen mäts i ändtarmen.</items>
                </term_definitions>
                <term_definitions code="at0026">
                    <items id="text">Nasofarynx</items>
                    <items id="description">Temperaturen mäts i nasofarynxen.</items>
                </term_definitions>
                <term_definitions code="at0027">
                    <items id="text">Urinblåsa</items>
                    <items id="description">Temperaturen mäts i urinblåsan.</items>
                </term_definitions>
                <term_definitions code="at0028">
                    <items id="text">Intravaskulär</items>
                    <items id="description">Temperaturen mäts i kärlsystemet.</items>
                </term_definitions>
                <term_definitions code="at0029">
                    <items id="text">Status</items>
                    <items id="description">Information om individens tillstånd.</items>
                </term_definitions>
                <term_definitions code="at0030">
                    <items id="text">Kroppsexponering</items>
                    <items id="description">Individens kroppsexponering vid tidpunkten för mätningen.</items>
                </term_definitions>
                <term_definitions code="at0031">
                    <items id="text">Naken</items>
                    <items id="description">Individen har inga kläder, sängkläder eller överdrag på sig.</items>
                </term_definitions>
                <term_definitions code="at0032">
                    <items id="text">Mindre mängd kläder eller sängkläder</items>
                    <items id="description">Individen är täckt av en mindre mängd kläder eller sängkläder än vad som bedöms vara lämpliga för miljöförhållandena.</items>
                </term_definitions>
                <term_definitions code="at0033">
                    <items id="text">Lämplig mängd kläder och sängkläder</items>
                    <items id="description">Individen är täckt av en mängd kläder eller sängkläder som bedöms vara lämpliga för miljöförhållandena.</items>
                </term_definitions>
                <term_definitions code="at0034">
                    <items id="text">Större mängd kläder och sängkläder</items>
                    <items id="description">Individen är täckt av en större mängd kläder eller sängkläder än vad som bedöms vara lämpliga för miljöförhållandena.</items>
                </term_definitions>
                <term_definitions code="at0041">
                    <items id="text">Beskrivning av termisk stress</items>
                    <items id="description">Beskrivning av saker som påverkar patienten och därmed patientens uppmätta kroppstemperatur.</items>
                </term_definitions>
                <term_definitions code="at0043">
                    <items id="text">Hud</items>
                    <items id="description">Temperaturen mäts från exponerad hud.</items>
                </term_definitions>
                <term_definitions code="at0051">
                    <items id="text">Vagina</items>
                    <items id="description">Temperaturen mäts i vaginan.</items>
                </term_definitions>
                <term_definitions code="at0054">
                    <items id="text">Esofagus</items>
                    <items id="description">Temperaturen mäts i matstrupen.</items>
                </term_definitions>
                <term_definitions code="at0055">
                    <items id="text">Ljumskveck</items>
                    <items id="description">Temperaturen mäts i ljumskens hudveck mellan benet och bukväggen.</items>
                </term_definitions>
                <term_definitions code="at0056">
                    <items id="text">Miljöförhållanden</items>
                    <items id="description">Information om rådande miljöförhållanden vid tidpunkten för temperaturmätning.</items>
                </term_definitions>
                <term_definitions code="at0057">
                    <items id="text">Ansträngning</items>
                    <items id="description">Uppgifter om individens ansträngning vid tidpunkten för temperaturmätning.</items>
                </term_definitions>
                <term_definitions code="at0059">
                    <items id="text">Utrustning</items>
                    <items id="description">Detaljer om enheten som används för att mäta kroppstemperaturen.</items>
                </term_definitions>
                <term_definitions code="at0060">
                    <items id="text">Tinning</items>
                    <items id="description">Temperaturen mäts på tinningen, över den ytliga temporalartären.</items>
                </term_definitions>
                <term_definitions code="at0061">
                    <items id="text">Panna</items>
                    <items id="description">Temperaturen mäts på pannan.</items>
                </term_definitions>
                <term_definitions code="at0062">
                    <items id="text">Tilläggsinformation</items>
                    <items id="description">Plats för tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items>
                    <items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR-motsvarigheter</items>
                </term_definitions>
                <term_definitions code="at0063">
                    <items id="text">Kommentar</items>
                    <items id="description">Extra kommentar om kroppstemperaturmätningen som inte beskrivits i andra fält.</items>
                </term_definitions>
                <term_definitions code="at0064">
                    <items id="text">Strukturerad mätplats</items>
                    <items id="description">Strukturerade detaljer om mätplatsen.</items>
                </term_definitions>
                <term_definitions code="at0065">
                    <items id="text">Dag i menstruationscykeln</items>
                    <items id="description">Nuvarande dag i menstruationscykeln</items>
                    <items id="comment">Den första dagen av menstruationen anses vara dag 1 i varje menstruationscykel.</items>
                </term_definitions>
                <term_definitions code="at0066">
                    <items id="text">Möjliga felkällor</items>
                    <items id="description">Beskrivning av ytterligare faktorer och felkällor som kan påverka mätningen av kroppstemperatur och inte redan dokumenterats i andra fält.</items>
                </term_definitions>
                <term_definitions code="Cel">
                    <items id="text">°C</items>
                    <items id="description">degrees Celsius</items>
                </term_definitions>
