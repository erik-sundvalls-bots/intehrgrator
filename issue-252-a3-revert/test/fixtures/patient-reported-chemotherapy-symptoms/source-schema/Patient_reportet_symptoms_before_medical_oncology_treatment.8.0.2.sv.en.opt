                        <term_definitions code="at0000">
                            <items id="text">följdfråga</items>
                            <items id="description">Följdfråga som kan användas t.ex. i frågeformulär efter att ha svarat "Ja" på frågor som "upplever du några symtom på..."</items>
                        </term_definitions>
                        <term_definitions code="at0002">
                            <items id="text">Hur upplever du dina besvär i mun/svalg?</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0004">
                            <items id="text">ytterligare följdfrågedetaljer</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0.1">
                            <items id="text">Lätta besvär, t.ex. beläggning, ömhet, rodnad, brännande känsla i munnen. Inga blåsor</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0.2">
                            <items id="text">Måttliga besvär, t.ex. rodnad, smärta och blåsor i munnen</items>
                            <items id="description"></items>
                        </term_definitions>
                        <term_definitions code="at0.3">
                            <items id="text">Svåra besvär, t.ex. kan ej äta och dricka p.g.a. blåsor och smärta i munnen</items>
                            <items id="description"></items>
                        </term_definitions>
                    </children>
