                    ["ca"] = <
                        ["at0000"] = <
                            text = <"Qualificador de problemes/diagnòstic">
                            description = <"Qualificador contextual o temporal per a un problema o diagnòstic específic.">
                        >
                        ["at0001"] = <
                            text = <"Episodicitat">
                            description = <"Categoria d'aquest episodi per al problema/diagnòstic identificat.">
                        >
                        ["at0003"] = <
                            text = <"Actiu/Inactiu?">
                            description = <"Categoria que dona suport a la divisió de problemes i diagnòstics en llistes de problemes actius o inactius.">
                        >
                        ["at0004"] = <
                            text = <"Estat del diagnòstic">
                            description = <"Estat o fase del procés diagnòstic.">
                        >
                        ["at0016"] = <
                            text = <"Preliminar">
                            description = <"El diagnòstic inicial realitzat, normalment associat a un baix nivell de certesa clínica. Pot canviar a mesura que els resultats de les proves estiguin disponibles.">
                        >
                        ["at0017"] = <
                            text = <"Present">
                            description = <"Diagnòstic provisional, basat en una quantitat raonable de certesa clínica però pendent de nous resultats de prova o consell clínic. Encara pot canviar a mesura que els resultats de les proves estiguin disponibles.">
                        >
                        ["at0018"] = <
                            text = <"Establert">
                            description = <"Diagnòstic final fonamentat, basat en un alt nivell de certesa clínica, que pot incloure evidència clínica dels resultats de les proves. No s'espera que canviï.">
                        >
                        ["at0026"] = <
                            text = <"Actiu">
                            description = <"El problema o diagnòstic està actualment actiu i és clínicament rellevant.">
                        >
                        ["at0027"] = <
                            text = <"Inactiu">
                            description = <"El problema o diagnòstic no està completament resolt però està inactiu o se sent menys rellevant per al context clínic actual.">
                        >
                        ["at0034"] = <
                            text = <"Nou">
                            description = <"Un nou episodi d'un problema o diagnòstic nou o existent. Una marca per a 'Primera ocurrència' es pot enregistrar per separat per distingir la primera d'altres ocurrències.">
                        >
                        ["at0035"] = <
                            text = <"En curs">
                            description = <"El problema o diagnòstic continua, sense que es produeixin nous episodis aguts.">
                        >
                        ["at0060"] = <
                            text = <"Actual/Passat?">
                            description = <"Categoria que admet la divisió de problemes i diagnòstics en llistes de problemes actuals o passats.">
                        >
                        ["at0061"] = <
                            text = <"Passat">
                            description = <"Hi havia un problema en el passat.">
                        >
                        ["at0062"] = <
                            text = <"Actual">
                            description = <"Hi ha un problema en l'actualitat.">
                        >
                        ["at0063"] = <
                            text = <"Categoria diagnòstica">
                            description = <"Categoria del problema o diagnòstic dins d'un episodi especificat de l'atenció i/o context d'atenció local.">
                        >
                        ["at0064"] = <
                            text = <"Diagnòstic principal">
                            description = <"El diagnòstic determina quin és el motiu principal d'un episodi d'atenció al pacient ingressat, un episodi d'atenció residencial o una assistència al lloc d'atenció sanitària.">
                        >
                        ["at0066"] = <
                            text = <"Diagnòstic secundari">
                            description = <"Un problema o diagnòstic que es produeix al mateix temps que el problema o diagnòstic primari. També es pot conèixer com una condició comòrbida.">
                        >
                        ["at0070"] = <
                            text = <"Indeterminat">
                            description = <"No és possible determinar si aquesta ocurrència del problema o del diagnòstic és nova o persistent.">
                        >
                        ["at0071"] = <
                            text = <"Ocurrència">
                            description = <"Categoria de l'ocurrència d'aquest problema o diagnòstic.">
                        >
                        ["at0073"] = <
                            text = <"Diagnòstic d'admissió?">
                            description = <"El problema o el diagnòstic estaven presents al moment de l'admissió?">
                        >
                        ["at0076"] = <
                            text = <"Complicació">
                            description = <"Una evolució desfavorable d'un problema o diagnòstic.">
                        >
                        ["at0077"] = <
                            text = <"Etiqueta del curs">
                            description = <"Categoria que reflecteix la celeritat d'inici i/o durada i persistència del problema o diagnòstic.">
                        >
                        ["at0079"] = <
                            text = <"Crònic">
                            description = <"Un problema o diagnòstic amb efectes persistents, o que evolucioni amb el temps.">
                        >
                        ["at0081"] = <
                            text = <"Agut">
                            description = <"Un problema o diagnòstic amb un inici ràpid, un curs curt, o tots dos.">
                        >
                        ["at0083"] = <
                            text = <"Fase de resolució">
                            description = <"Fase de curació per a un problema agut o diagnòstic.">
                        >
                        ["at0084"] = <
                            text = <"Resolt">
                            description = <"El problema o el diagnòstic avança satisfactòriament a través de les etapes normals de curació.">
                        >
                        ["at0085"] = <
                            text = <"En curació">
                            description = <"El problema o el diagnòstic avança satisfactòriament a través de les etapes normals de curació.">
                        >
                        ["at0086"] = <
                            text = <"No resolt">
                            description = <"El problema o el diagnòstic no avança satisfactòriament a través de les etapes normals de curació.">
                        >
                        ["at0087"] = <
                            text = <"Indeterminat">
                            description = <"No és possible determinar l'estat de curació del problema o diagnòstic.">
                        >
                        ["at0088"] = <
                            text = <"Refutat">
                            description = <"El diagnòstic prèviament enregistrat ha estat reavaluat clínicament o refutat amb un alt nivell de certesa clínica. Aquest estat s'utilitza per corregir un error en el registre de salut.">
                        >
                        ["at0089"] = <
                            text = <"Estat de remissió">
                            description = <"Estat de remissió d'un diagnòstic incurable.">
                        >
                        ["at0090"] = <
                            text = <"En remissió">
                            description = <"No s'han identificat signes o símptomes de la malaltia.">
                        >
                        ["at0092"] = <
                            text = <"Sense remissió">
                            description = <"No s'ha identificat cap disminució dels signes o símptomes de la malaltia.">
                        >
                        ["at0093"] = <
                            text = <"Indeterminat">
                            description = <"No és possible determinar si s'han detectat disminucions dels signes o símptomes de la malaltia.">
                        >
                        ["at0094"] = <
                            text = <"Agut i crònic">
                            description = <"Un problema o diagnòstic amb una exacerbació aguda d'una condició crònica.">
                        >
                        ["at0095"] = <
                            text = <"Primera ocurrència">
                            description = <"Aquesta és la primera aparició d'aquest problema o diagnòstic.">
                        >
                        ["at0096"] = <
                            text = <"Recurrent">
                            description = <"Nova ocurrència del mateix problema o diagnòstic després que es resolgués un episodi anterior.">
                        >
                        ["at0097"] = <
                            text = <"Recaiguda">
                            description = <"El problema o el diagnòstic ha empitjorat després d'un període de millora temporal.">
                        >
                        ["at0098"] = <
                            text = <"Nivell de control">
                            description = <"Categoria del nivell de control del problema o diagnòstic segons el maneig actual.">
                        >
                        ["at0099"] = <
                            text = <"Controlat">
                            description = <"El problema o diagnòstic està controlat amb el maneig actual.">
                        >
                        ["at0100"] = <
                            text = <"Indeterminat">
                            description = <"No és possible determinar si el problema o el diagnòstic està controlat amb el maneig actual.">
                        >
                        ["at0101"] = <
                            text = <"No controlat">
                            description = <"El problema o diagnòstic no està controlat amb el maneig actual.">
                        >
                        ["at0102"] = <
                            text = <"Progressió">
                            description = <"Categoria de la progressió a través del curs d'un problema o diagnòstic crònic.">
                        >
                        ["at0103"] = <
                            text = <"Millora">
                            description = <"El problema o el diagnòstic està millorant.">
                        >
                        ["at0104"] = <
                            text = <"Estable">
                            description = <"El problema o el diagnòstic no canvia.">
                        >
                        ["at0105"] = <
                            text = <"Empitjora">
                            description = <"El problema o el diagnòstic està empitjorant.">
                        >
                        ["at0106"] = <
                            text = <"Indeterminat">
                            description = <"No és possible determinar la progressió del problema o el diagnòstic.">
                        >
                        ["at0107"] = <
                            text = <"Motiu d'un episodi en curs">
                            description = <"Raó per a un problema o diagnòstic que no es resol com s'esperava.">
                        >
                        ["at0108"] = <
                            text = <"Sí">
                        >
                        ["at0109"] = <
                            text = <"No">
                        >
                        ["at0110"] = <
                            text = <"Comentaris">
                            description = <"Informació addicional sobre els valors del qualificador del problema/diagnòstic, no capturats en altres camps.">
                        >
                        ["at0111"] = <
                            text = <"*Disorder category (en)">
                            description = <"*A high‑level grouping of the problem or diagnosis. (en)">
                        >
                        ["ac0.1"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.2"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.3"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.4"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.5"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.6"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.7"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.8"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.9"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.10"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.11"] = <
