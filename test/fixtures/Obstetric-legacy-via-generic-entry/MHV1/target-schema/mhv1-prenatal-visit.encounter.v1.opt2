                        >
                        ["at0006"] = <
                            text = <"Levenslang niet-drinker">
                            description = <"Individu heeft nooit alcohol gedronken.">
                        >
                        ["at0013"] = <
                            text = <"Episode startdatum">
                            description = <"Datum waarop de episode begon.">
                        >
                        ["at0014"] = <
                            text = <"Stopdatum">
                            description = <"*Date when the individual last consumed alcohol. (en)">
                        >
                        ["at0015"] = <
                            text = <"Regelmatige consumptie begonnen">
                            description = <"De datum of gedeeltelijke datum waarop het individu begon regelmatig, maar doorgaans niet dagelijks, alcohol te drinken.">
                        >
                        ["at0016"] = <
                            text = <"Algemene stopdatum">
                            description = <"De datum waarop het individu voor het laatst stopte met het drinken van alcohol van welk type dan ook.">
                        >
                        ["at0019"] = <
                            text = <"Algemene opmerkingen">
                            description = <"Aanvullende opmerkingen over alcohol consumptie die niet vastgelegd zijn in andere velden.">
                        >
                        ["at0021"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0022"] = <
                            text = <"Laatst bijgewerkt">
                            description = <"De datum waarop dit alcohol consumptie overzicht het laatst is bijgewerkt.">
                        >
                        ["at0023"] = <
                            text = <"Typische consumptie (alcohol eenheden)">
                            description = <"*Estimate of number of alcohol units consumed. (en)">
                        >
                        ["at0025"] = <
                            text = <"Aantal stoppogingen">
                            description = <"Totale aantal keer dat het individu heeft gepoogd om te stoppen met drinken tijdens deze episode.">
                        >
                        ["at0026"] = <
                            text = <"Episode details">
                            description = <"Aanvullende gestructureerde details over deze periode van alcohol consumptie.">
                        >
                        ["at0029"] = <
                            text = <"Per type">
                            description = <"Details over consumptie van een specifiek type alcohol.">
                        >
                        ["at0030"] = <
                            text = <"Patroon">
                            description = <"Het typische patroon van alcohol consumptie.">
                        >
                        ["at0043"] = <
                            text = <"Algemene beschrijving">
                            description = <"Verhalende samenvatting van het individu's algemene alcohol consumptie patroon en geschiedenis.">
                        >
                        ["at0052"] = <
                            text = <"Status">
                            description = <"Uitspraak over huidige alcohol consumptie gedrag.">
                        >
                        ["at0053"] = <
                            text = <"Beschrijving">
                            description = <"Verhalende samenvatting over alcohol consumptie van het bepaalde type alcohol.">
                        >
                        ["at0061"] = <
                            text = <"*Drinker (en)">
                            description = <"Individu gebruikt alcohol tijdens deze periode.">
                        >
                        ["at0064"] = <
                            text = <"Per episode">
                            description = <"Details over een discrete periode met een consistent patroon van typische consumptie.">
                        >
                        ["at0069"] = <
                            text = <"Opmerking">
                            description = <"Aanvullende omschrijving over de consumptie van het specifieke type alcohol, indien niet vastgelegd in andere velden.">
                        >
                        ["at0071"] = <
                            text = <"Stopdatum definitie">
                            description = <"De definitie van 'Stopdatum' toegepast op data elementen gebruikt in dit archetype.">
                        >
                        ["at0073"] = <
                            text = <"Uitbreiding">
                            description = <"Aanvullende informatie vereist voor het vastleggen van lokale materie of om aan te sluiten bij andere referentiemodellen/formalismen.">
                        >
                        ["at0075"] = <
                            text = <"Huidige drinker definitie">
                            description = <"De definitie van 'Huidige drinker' toegepast in de 'Status' data elementen gebruikt in dit archetype.">
                        >
                        ["at0076"] = <
                            text = <"Ex-drinker definitie">
                            description = <"De definitie van 'Ex-drinker' toegepast in de 'Status' data elementen gebruikt in dit archetype.">
                        >
                        ["at0077"] = <
                            text = <"Type details">
                            description = <"Aanvullende gestructureerde details over de consumptie van het specifieke type alcohol.">
                        >
                        ["at0079"] = <
                            text = <"NIet-drinker definitie">
                            description = <"De definitie van 'Niet-drinker' toegepast in de 'Status' data elementen gebruikt in dit archetype.">
                        >
                        ["at0080"] = <
                            text = <"Dagelijke consumptie begonnen">
                            description = <"De datum of gedeeltelijke datum waarop het individu begon met dagelijkse consumptie van alcohol.">
                        >
                        ["at0081"] = <
                            text = <"Episode label">
                            description = <"Identificatie van een episode van alcohol consumptie - als een nummer in een reeks of een genoemde gebeurtenis.">
                        >
                        ["at0082"] = <
                            text = <"Episode einddatum">
                            description = <"Datum waarop deze episode eindigt.">
                        >
                        ["at0083"] = <
                            text = <"Dagelijks">
                            description = <"Consumeert alcoholische drank op zijn minst eenmaaldaags.">
                        >
                        ["at0084"] = <
                            text = <"Niet-dagelijks">
                            description = <"Consumeert alcoholische dranken niet dagelijks.">
                        >
                        ["at0085"] = <
                            text = <"Stoppoging definitie">
                            description = <"De definitie van 'Stoppoging' gebruikt voor het bepalen van het 'Aantal stoppogingen' data element gebruikt in dit archetype.">
                        >
                        ["at0086"] = <
                            text = <"Algemene details">
                            description = <"Aanvullende gestructureerde details over het algemene alcoholgebruik.">
                        >
                        ["at0087"] = <
                            text = <"Episode opmerkingen">
                            description = <"Aanvullende opmerkingen over alcohol consumptie tijdens deze episode, niet vastgelegd in andere velden.">
                        >
                        ["at0089"] = <
                            text = <"Algemene status">
                            description = <"Uitspraak over huidige consumptie van alle typen alcohol.">
                        >
                        ["at0091"] = <
                            text = <"NIet-drinker">
                            description = <"Individu heeft geen alcohol gedronken tijdens deze episode.">
                        >
                        ["at0097"] = <
                            text = <"Overmatig drinken frequentie">
                            description = <"De typische frequentie waarop het individu zwaar drinkt in een korte periode met de intentie om dronken te worden.">
                        >
                        ["at0104"] = <
                            text = <"Alcohol eenheden definitie (massa)">
                            description = <"Massa van alcohol dat een standaard glas of alcohol eenheid definieert in dit archetype.">
                        >
                        ["at0108"] = <
                            text = <"Type">
                            description = <"De naam van een specifiek type of groep van alcoholische drank.">
                        >
                        ["at0110"] = <
                            text = <"Alcoholvrije dagen">
                            description = <"Het aantal dagen waarop geen alcohol was geconsumeerd in de bepaalde periode.">
                        >
                        ["at0111"] = <
                            text = <"Typische consumptie (alcohol eenheden)">
                            description = <"*Estimate of number of standard drinks of the specified type of alcohol consumed. (en)">
                        >
                        ["at0112"] = <
                            text = <"Episode beschrijving">
                            description = <"Verhalende beschrijving over het individu's algemene alcohol consumptie patroon tijdens deze episode.">
                        >
                        ["at0113"] = <
                            text = <"Overmatig drinken beschrijving">
                            description = <"Verhalende beschrijving over het individu's typische patroon van overmatig drinken.">
                        >
                        ["at0114"] = <
                            text = <"Datum eerste dronkenschap">
                            description = <"De datum of gedeeltelijke datum waarop het individu voor het eerst dronken was.">
                        >
                        ["at0115"] = <
                            text = <"Bier">
                            description = <"Gefermenteerde drank gemaakt van graanpuree.">
                        >
                        ["at0116"] = <
                            text = <"Wijn">
                            description = <"Gefermenteerde drank gemaakt van druiven en soms andere vruchten.">
                        >
                        ["at0117"] = <
                            text = <"Cider">
                            description = <"Gefermenteerde drank gemaakt van een vruchtensap.">
                        >
                        ["at0118"] = <
                            text = <"Mede">
                            description = <"Gefermenteerde drank gemaakt van honing, soms met verscheidene vruchten, kruiden, granen of hop.">
                        >
                        ["at0119"] = <
                            text = <"Pulque">
                            description = <"Gefermenteerde drank gemaakt van \"honingwater\" uit cacti.">
                        >
                        ["at0120"] = <
                            text = <"Gedestileerde dranken">
                            description = <"Gefermenteerde drank gemaakt door een destilatieproces. Heeft doorgaans een alcoholgehalte >20%. Dit omvat likeuren, cocktails en gedenatureerde alcohol.">
                        >
                        ["at0121"] = <
                            text = <"Versterkte wijn">
                            description = <"Wijn met toegevoegde gedestileerde drank.">
                        >
                        ["at0122"] = <
                            text = <"*Typical consumption (mass) (en)">
                            description = <"*Estimate of number of pure grams alcohol consumed. (en)">
                        >
                        ["at0127"] = <
                            text = <"*Typical consumption (mass) (en)">
                            description = <"*Estimate of number of grams of pure alcohol the specified type of alcoholic beverage consumed. (en)">
                        >
                        ["at0064.2"] = <
                            text = <"Per episode (2)">
                            description = <"Details over een discrete periode met een consistent patroon van typische consumptie.">
                        >
                        ["ac0.12"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.17"] = <
                            text = <"*(Synthesized) (en)">
                        >
                    >
                >
            >
            ["openEHR-EHR-EVALUATION.ovl-clinical_synopsis-001.v1"] = <
                term_definitions = <
                    ["en"] = <
                        ["at0000"] = <
                            text = <"Clinical synopsis">
                            description = <"Narrative summary or overview about a patient, specifically from the perspective of a healthcare provider, and with or without associated interpretations.">
                        >
                        ["at0001"] = <
                            text = <"List">
                            description = <"@ internal @">
                        >
                        ["at0002"] = <
                            text = <"Synopsis">
                            description = <"The summary, assessment, conclusions or evaluation of the clinical findings.">
                        >
                        ["at0003"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0004"] = <
                            text = <"Extension">
                            description = <"Additional information required to capture local content or to align with other reference models/formalisms.">
                        >
                        ["at0000.1"] = <
                            text = <"Assessment at first visit">
                            description = <"Narrative summary or overview about a patient, specifically from the perspective of a healthcare provider, and with or without associated interpretations.">
                        >
                    >
                    ["fa"] = <
                        ["at0000"] = <
                            text = <"خلاصه بالینی">
                            description = <"خلاصه یا مروری تشریحی دربازه بیمار بویژه از نظز ارایه کننده مراقبت بهداشتی با یا بدون تفسیرهای مربوطه ">
                        >
                        ["at0001"] = <
                            text = <"*List(en)">
                            description = <"*@ internal @(en)">
                        >
                        ["at0002"] = <
                            text = <"خلاصه">
                            description = <"خلاصه ، ارزیابی ، نتیجه ، یا ارزشیابی یافته های بالینی">
                        >
                        ["at0003"] = <
                            text = <"*Tree(en)">
                            description = <"*@ internal @(en)">
                        >
                        ["at0004"] = <
                            text = <"*Extension(en)">
                            description = <"*Additional information required to capture local content or to align with other reference models/formalisms.(en)">
                        >
                    >
                    ["ar-sy"] = <
                        ["at0000"] = <
                            text = <"المختصر السريري">
                            description = <"ملخص بالرواية أو نظرة عامة عن المريض, خاصة من وجهة نظر مقدم الخدمة الصحية, مع إرفاق أو عدم إرفاق تفسيرات ">
                        >
                        ["at0001"] = <
                            text = <"*List(en)">
                            description = <"*@ internal @(en)">
                        >
                        ["at0002"] = <
                            text = <"المختصر">
                            description = <"الملخص, التقييم, الاستنتاجات أو التقييم للموجودات السريرية">
                        >
                        ["at0003"] = <
                            text = <"*Tree(en)">
                            description = <"*@ internal @(en)">
                        >
                        ["at0004"] = <
                            text = <"*Extension(en)">
                            description = <"*Additional information required to capture local content or to align with other reference models/formalisms.(en)">
                        >
                    >
                    ["de"] = <
                        ["at0000"] = <
                            text = <"Klinische Synopsis">
                            description = <"Zusammenfassung oder Übersicht einer Patientengeschichte, speziell aus der Sicht eines Gesundheitsdienstleisters, evtl. mit dazugehörigen Interpretationen.">
                        >
                        ["at0001"] = <
                            text = <"*List(en)">
                            description = <"*@ internal @(en)">
                        >
                        ["at0002"] = <
                            text = <"Synopsis">
                            description = <"Die Zusammenfassung, Beurteilung, Aussagen or Auswertung des klinischen Befunds.">
                        >
                        ["at0003"] = <
                            text = <"*Tree(en)">
                            description = <"*@ internal @(en)">
                        >
                        ["at0004"] = <
                            text = <"Erweiterung">
                            description = <"Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle / Formalismen.
			    ">
                        >
                    >
                    ["es-ar"] = <
                        ["at0000"] = <
                            text = <"Sinopsis Clínica">
                            description = <"Sumario narrativo o visión global acerca de un paciente, específicamente desde la perspectiva de un profesional del cuidado de la salud, con o sin interpretaciones asociadas.">
                        >
                        ["at0001"] = <
                            text = <"*List(en)">
                            description = <"*@ internal @(en)">
                        >
                        ["at0002"] = <
                            text = <"Sinopsis">
                            description = <"El sumario, la impresión diagnóstica y las conclusiones sobre los hallazgos clínicos.">
                        >
                        ["at0003"] = <
                            text = <"*Tree(en)">
                            description = <"*@ internal @(en)">
                        >
                        ["at0004"] = <
                            text = <"*Extension(en)">
                            description = <"*Additional information required to capture local content or to align with other reference models/formalisms.(en)">
                        >
                    >
                    ["pt-br"] = <
                        ["at0000"] = <
                            text = <"Sinopse Clínica">
                            description = <"Resumo narrativo ou visão geral sobre um paciente, especificamente a partir da perspectiva de um profissional de saúde, e com ou sem interpretações associadas.">
                        >
                        ["at0001"] = <
                            text = <"*List(en)">
                            description = <"*@ internal @(en)">
                        >
                        ["at0002"] = <
                            text = <"Sinopse">
                            description = <"O sumário, a avaliação, conclusões ou avaliação dos achados clínicos.">
                        >
                        ["at0003"] = <
                            text = <"*Tree(en)">
                            description = <"*@ internal @(en)">
                        >
                        ["at0004"] = <
                            text = <"*Extension(en)">
                            description = <"*Additional information required to capture local content or to align with other reference models/formalisms.(en)">
                        >
                    >
                    ["zh-cn"] = <
                        ["at0000"] = <
                            text = <"临床提要">
                            description = <"从医疗保健服务提供着的角度，手工综合并记录关于患者的叙述型摘要或概述，且带有或没有相关联的解释。">
                        >
                        ["at0001"] = <
                            text = <"*List(en)">
                            description = <"*@ internal @(en)">
                        >
                        ["at0002"] = <
                            text = <"提要">
                            description = <"对于临床所见（临床发现）进行的概括、评估、总结或评价。">
                        >
                        ["at0003"] = <
                            text = <"*Tree(en)">
                            description = <"*@ internal @(en)">
                        >
                        ["at0004"] = <
                            text = <"*Extension(en)">
                            description = <"*Additional information required to capture local content or to align with other reference models/formalisms.(en)">
                        >
                    >
                    ["nb"] = <
                        ["at0000"] = <
                            text = <"Klinisk sammendrag">
                            description = <"Fritekstsammendrag eller oversikt om en pasient fra helsepersonellets perspektiv, med eller uten tilhørende fortolkninger.">
                        >
                        ["at0001"] = <
                            text = <"List">
                            description = <"@ internal @">
                        >
                        ["at0002"] = <
                            text = <"Sammendrag">
                            description = <"Oppsummering, vurdering, konklusjoner eller evaluering av de kliniske funnene.">
                        >
                        ["at0003"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0004"] = <
                            text = <"Tilleggsinformasjon">
                            description = <"Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.">
                        >
                    >
                    ["sv"] = <
                        ["at0000"] = <
                            text = <"Klinisk synopsis">
                            description = <"Beskrivande sammanfattning eller överblick av en patient, särskilt ur vårdgivarens perspektiv, med eller utan associerade tolkningar.">
                        >
                        ["at0001"] = <
                            text = <"List">
                            description = <"@ internal @">
                        >
                        ["at0002"] = <
                            text = <"Synopsis">
                            description = <"Sammanfattning, bedömning, slutsatser eller utvärderingar av de kliniska fynden.">
                        >
                        ["at0003"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0004"] = <
                            text = <"Tilläggsinformation">
                            description = <"*Additional information required to capture local content or to align with other reference models/formalisms.(en)">
                        >
                        ["at0002.1"] = <
                            text = <"Bedömning">
                            description = <"Sammanfattning, bedömning, slutsatser eller utvärderingar av de kliniska fynden.">
                        >
                    >
                    ["ca"] = <
                        ["at0000"] = <
                            text = <"Sinopsi clínica">
                            description = <"Informe o resum narratiu sobre un pacient, específicament des de la perspectiva d'un professional d’atenció sanitària, i amb o sense interpretacions associades.">
                        >
                        ["at0001"] = <
                            text = <"List">
                            description = <"@ internal @">
                        >
                        ["at0002"] = <
                            text = <"Sinopsi">
                            description = <"El resum, l'avaluació, les conclusions o l'avaluació dels resultats clínics.">
                        >
                        ["at0003"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0004"] = <
                            text = <"Extensió">
                            description = <"Informació addicional necessària per a expandir el model amb el contingut local o per alinear-se amb altres models/formalismes de referència.">
                        >
                    >
                    ["es"] = <
                        ["at0000"] = <
                            text = <"Sinopsis clínica">
                            description = <"Resumen narrativo o visión general sobre un paciente, específicamente desde la perspectiva de un profesional sanitario, y con o sin interpretaciones asociadas.">
                        >
                        ["at0001"] = <
                            text = <"List">
                            description = <"@ internal @">
                        >
                        ["at0002"] = <
                            text = <"Sinopsis">
                            description = <"El resumen, la valoración, las conclusiones o la evaluación de los hallazgos clínicos.">
                        >
                        ["at0003"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0004"] = <
                            text = <"Extensión">
                            description = <"Información adicional necesaria para captar el contenido local o para alinearse con otros modelos/formalismos de referencia.">
                        >
                    >
                    ["el"] = <
                        ["at0000"] = <
                            text = <"Κλινική σύνοψη">
                            description = <"Αφηγηματική περίληψη ή επισκόπηση σχετικά με έναν ασθενή, ειδικά από την οπτική γωνία ενός παρόχου υγειονομικής περίθαλψης και με ή χωρίς σχετικές ερμηνείες.">
                        >
                        ["at0001"] = <
                            text = <"List">
                            description = <"@ internal @">
                        >
                        ["at0002"] = <
                            text = <"Σύνοψη">
                            description = <"Η περίληψη, η αξιολόγηση, τα συμπεράσματα ή η αξιολόγηση των κλινικών ευρημάτων.">
                        >
                        ["at0003"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0004"] = <
                            text = <"*Extension(en)">
                            description = <"Πρόσθετες πληροφορίες που απαιτούνται για την καταγραφή τοπικού περιεχομένου ή για την ευθυγράμμιση με άλλα μοντέλα αναφοράς/φορμαλισμούς.">
                        >
                    >
                >
            >
            ["openEHR-EHR-EVALUATION.ovl-container-001.v0"] = <
                term_definitions = <
                    ["en"] = <
                        ["at0000"] = <
                            text = <"Container">
                            description = <"Generic archetype to contain existing CLUSTER archetypes which need to be represented as standalone data.">
                        >
                        ["at0001"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0004"] = <
                            text = <"Detail">
                            description = <"Clinical details held within CLUSTER archetypes.">
                        >
                        ["at0000.1"] = <
                            text = <"Living and work enviornment problems">
                            description = <"Generic archetype to contain existing CLUSTER archetypes which need to be represented as standalone data.">
                        >
                    >
                    ["pt-br"] = <
                        ["at0000"] = <
                            text = <"Conteiner">
                            description = <"Arquétipo genérico usado para conter arquétipos CLUSTER existentes que precisam ser representados como um dado independente.">
                        >
                        ["at0001"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0004"] = <
                            text = <"Detalhe">
                            description = <"Detalhes clínicos mantidos dentro de arquétipos CLUSTER.">
                        >
                    >
                    ["sv"] = <
                        ["at0000"] = <
                            text = <"Behållare">
                            description = <"Generisk arketyp för att innehålla befintliga CLUSTER-arketyper som behöver representeras som fristående data.">
                        >
                        ["at0001"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0004"] = <
                            text = <"Detaljer">
                            description = <"*Clinical details held within CLUSTER archetypes. (en)">
                        >
                        ["at0000.1"] = <
                            text = <"Bostad eller arbetsmiljö problem">
                            description = <"Generisk arketyp för att innehålla befintliga CLUSTER-arketyper som behöver representeras som fristående data.">
                        >
                    >
                >
            >
            ["openEHR-EHR-EVALUATION.ovl-contraceptive_summary-001.v1"] = <
                term_definitions = <
                    ["en"] = <
                        ["at0000"] = <
                            text = <"Contraceptive use summary">
                            description = <"Summary and persistent information about the use of methods to prevent pregnancy.">
                        >
                        ["at0001"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0003"] = <
                            text = <"Current user">
                            description = <"Individual currently uses contraception.">
                        >
                        ["at0005"] = <
                            text = <"Not current user">
                            description = <"Individual has previously used contraception but is not a current user.">
                        >
                        ["at0006"] = <
                            text = <"Never used">
                            description = <"Individual has never used any type of contraception.">
                        >
                        ["at0013"] = <
                            text = <"Episode start date">
                            description = <"Date when this episode commenced.">
                        >
                        ["at0019"] = <
