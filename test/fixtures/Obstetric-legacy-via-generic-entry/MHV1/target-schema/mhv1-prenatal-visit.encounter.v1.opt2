                    ["ar-sy"] = <
                        ["at0000"] = <
                            text = <"الارتفاع / الطول">
                            description = <"الارتفاع أو طول الجسم, يتم قياسه من تاج الرأس إلى أخمص القدم. يتم قياس الارتفاع عندما يكون الفرد واقفا, و طول الجسم عندما يكون الفرد مستلقيا.">
                        >
                        ["at0001"] = <
                            text = <"*history(en)">
                            description = <"*@ internal @(en)">
                        >
                        ["at0002"] = <
                            text = <"*Any event(en)">
