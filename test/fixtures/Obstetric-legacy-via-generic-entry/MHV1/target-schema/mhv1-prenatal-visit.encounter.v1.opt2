                        >
                    >
                    ["de"] = <
                        ["at0000"] = <
                            text = <"Arzneimittel">
                            description = <"Angaben über ein Arzneimittel oder eine Arzneimittelkomponente, einschließlich der Wirkstärke, der Darreichungsform und Informationen über spezifische Bestandteile.">
                        >
                        ["at0001"] = <
                            text = <"Kombinationsprodukt">
                            description = <"Das Arzneimittel oder die Arzneimittelkomponente besteht aus einer Reihe von separaten Produkten, die vom Hersteller vorverpackt werden, z.B. Canesten Combi.">
                        >
                        ["at0003"] = <
                            text = <"Verfallsdatum">
                            description = <"Das Verfallsdatum und/oder die Verfallszeit des Arzneimittels oder der Arzneimittelkomponente. Diese Angabe wird vom Hersteller oder einer Person während der Mixtur-Zubereitung gemacht.">
                        >
                        ["at0071"] = <
                            text = <"Darreichungsform">
                            description = <"Die Zubereitung oder die Darstellung eines Arzneimittels oder einer Arzneimittelkomponente.">
                        >
                        ["at0080"] = <
                            text = <"Wirkstoff">
                            description = <"Bestandteil, der allein oder in Kombination mit einem oder mehreren anderen Inhaltsstoffen die beabsichtigte Wirkung eines Arzneimittels erfüllt.">
                        >
                        ["at0083"] = <
                            text = <"Hilfsstoff">
                            description = <"Ein Bestandteil mit der primären Funktion, die Wirkung des aktiven Bestandteils zu verändern. Ein unterstützender (adjuvant) Bestandteil kann selbst therapeutisch wirksam sein, muss es aber nicht.">
                        >
                        ["at0084"] = <
                            text = <"Sonstiger Bestandteil">
                            description = <"Bestandteil, der in Bezug auf die beabsichtigte Wirkung des Arzneimittels unbeteiligt ist.">
                        >
                        ["at0115"] = <
                            text = <"Wirkstoffkonzentration">
                            description = <"Die Wirkstärke eines Arzneimittels oder einer Arzneimittelkomponente als Konzentration.">
                        >
                        ["at0127"] = <
                            text = <"Funktion">
                            description = <"Die Funktion eines Arzneimittels oder einer Arzneimittelkomponente innerhalb einer Mixtur.">
                        >
                        ["at0132"] = <
                            text = <"Name">
                            description = <"Der Name des Arzneimittels oder der Arzneimittelkomponente.">
                        >
                        ["at0133"] = <
                            text = <"Beschreibung">
                            description = <"Eine Möglichkeit zur Beschreibung des Arzneimittels oder der Arzneimittelkomponente, wenn dies nicht mit vollständig strukturierten Elementen möglich war.">
                        >
                        ["at0138"] = <
                            text = <"Bestandteil">
                            description = <"Angaben zu einem Inhaltsstoff oder Produkt, das zur Herstellung einer Mischpackung, eines Präparats oder einer Infusion verwendet wird.">
                        >
                        ["at0139"] = <
                            text = <"Menge">
                            description = <"Die Menge des Arzneimittels oder der Arzneimittelkomponente.">
                        >
                        ["at0141"] = <
                            text = <"Strukturierte Angaben">
                            description = <"Zusätzliche Angaben über das Arzneimittel oder die Arzneimittelkomponente.">
                        >
                        ["at0142"] = <
                            text = <"Kategorie">
                            description = <"Die Kategorie des Arzneimittels oder der Arzneimittelkomponente, hinsichtlich der Herstellung oder Zubereitung und der Anzahl der Inhaltsstoffe.">
                        >
                        ["at0143"] = <
                            text = <"Ad-hoc Mixtur">
                            description = <"Das Arzneimittel oder die Arzneimittelkomponente besteht aus einer Mischung von Inhaltsstoffen, die in der Verordnung angegeben sind. Diese werden in der Regel von Apotheken- oder Stationspersonal individuell für den Patienten zubereitet.">
                        >
                        ["at0144"] = <
                            text = <"Produkt mit meheren Inhaltsstoffen">
                            description = <"Das Arzneimittel oder die Arzneimittelkomponente besteht aus einer Reihe von Wirkstoffen, die vom Hersteller in einer Darreichungsform, wie z.B. als eine Tablette, Creme oder ein Pulver, zusammengesetzt werden. Ein Beispiel hierfür ist Paracetamol/Codein.">
                        >
                        ["at0145"] = <
                            text = <"Produkt mit einem Inhaltsstoff">
                            description = <"Das Arzneimittel oder die Arzneimittelkomponente ist ein hergestelltes Produkt, das einen einzigen Wirkstoff enthält.">
                        >
                        ["at0146"] = <
                            text = <"Inhaltsstoff">
                            description = <"Das Arzneimittel oder die Arzneimittelkomponente ist ein einzelner Inhaltsstoff des Arzneimittels. Dieser Begriff wird verwendet, wenn der Archetyp innerhalb einer übergeordneten Instanz seines eigenen Archetyps verschachtelt ist, um die einzelnen Bestandteile eines Arzneimittels zu beschreiben.">
                        >
                        ["at0148"] = <
                            text = <"Alternative Menge">
                            description = <"Der Wert einer äquivalenten Darstellung der Menge des Arzneimittels oder der Arzneimittelkomponente.">
                        >
                        ["at0150"] = <
                            text = <"Batch ID">
                            description = <"Die Kennung der Produktionscharge, die vom Hersteller während der Produktion zugewiesen wird.">
                        >
                        ["at0151"] = <
                            text = <"Hersteller">
                            description = <"Der Hersteller des Arzneimittels oder der Arzneimittelkomponente.">
                        >
                        ["at0152"] = <
                            text = <"Wirkstärke (Darreichungsform)">
                            description = <"Die Wirkstärke des Arzneimittels oder der Arzneimittelkomponente, ausgedrückt als Verhältniszahl.">
                        >
                        ["at0153"] = <
                            text = <"Wirkstärke (Zähler)">
                            description = <"Der Wert des Zählers des Wirkstärkeanteils.">
                        >
                        ["at0157"] = <
                            text = <"Wirkstärke (Nenner)">
                            description = <"Der Wert des Nenners des Wirkstärkeanteils.">
                        >
                        ["ac0.1"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.2"] = <
                            text = <"*(Synthesized) (en)">
                        >
                    >
                    ["nl"] = <
                        ["at0000"] = <
                            text = <"*Medication details (en)">
                            description = <"Gegevens over een medicament of onderdeel van een medicament, inclusief dosis, vorm en details over een specifiek bestandsdeel.">
                        >
                        ["at0001"] = <
                            text = <"Combinatie product">
                            description = <"Het medicament of medicatie bestanddeel bestaat uit een aantal onafhankelijke producten die voorverpakt zijn door de fabrikant, bijvoorbeeld 'Canesten Combi'.">
                        >
                        ["at0003"] = <
                            text = <"Houdbaarheid">
                            description = <"De houdbaarheidsdatum en/of tijd van het medicament of medicatie bestanddeel, zoals bepaald door de fabrikant of het individu dat het mengsel bereidt.">
                        >
                        ["at0071"] = <
                            text = <"Vorm">
                            description = <"De vorm waarin het medicament of medicatie bestandsdeel aangeboden wordt.">
                        >
                        ["at0080"] = <
                            text = <"Therapeuticum">
                            description = <"*Constituent that alone or in combination with one or more other ingredients is considered to fulfil the intended activity of a medicinal product. (en)">
                        >
                        ["at0083"] = <
                            text = <"Adjuvans">
                            description = <"*Constituent whose primary function is to modify the activity of an active constituent. An adjuvant constituent itself may or may not be therapeutically active.">
                        >
                        ["at0084"] = <
                            text = <"*Excipient (en)">
                            description = <"*Constituent that is inert in relation to the intended activity of the medicinal product. (en)">
                        >
                        ["at0115"] = <
                            text = <"Dosis (concentratie)">
                            description = <"*The strength of the medication or medication component, as a concentration. (en)">
                        >
                        ["at0127"] = <
                            text = <"Rol">
                            description = <"De rol van het medicament of het medicatie bestanddeel in een mengsel.">
                        >
                        ["at0132"] = <
                            text = <"Naam">
                            description = <"De naam van het medicament of medicatie bestandsdeel.">
                        >
                        ["at0133"] = <
                            text = <"Beschrijving">
                            description = <"*Narrative description of the medication or medication component where it is not possible to describe this fully using structured elements. (en)">
                        >
                        ["at0138"] = <
                            text = <"Bestanddeel">
                            description = <"Gegevens over een bestanddeel of product als onderdeel van een gemengde strip, bereiding of infusie.">
                        >
                        ["at0139"] = <
                            text = <"Hoeveelheid">
                            description = <"*The amount of medication or medication component. (en)">
                        >
                        ["at0141"] = <
                            text = <"*Structured details (en)">
                            description = <"*Additional details about the medication or medication component. (en)">
                        >
                        ["at0142"] = <
                            text = <"Categorie">
                            description = <"De categorie van het medicament of het medicatie bestandsdeel, gerelateerd aan fabricage of bereiding en het aantal bestandsdelen.">
                        >
                        ["at0143"] = <
                            text = <"Ad-hoc mengsel">
                            description = <"Het medicament of medicatie bestandsdeel bestaat uit een mengsel van bestanddelen vastgelegd in het recept. Deze worden normaal specifiek voor een patient bereidt door apotheek- of verpleegafdelingspersoneel.">
                        >
                        ["at0144"] = <
                            text = <"Samengesteld product">
                            description = <"Het medicament of het medicatie bestanddeel bestaat uit een aantal actieve onderdelen die in enkele vorm zoals een table, creme of poeder, bereid zijn door de fabrikant, bijvoorbeeld 'Paracetamol/codeïne'.">
                        >
                        ["at0145"] = <
                            text = <"Enkelvoudig productie">
                            description = <"Een medicament of medicatie bestanddeel is een gefabriceerd product dat een enkel actief bestanddeel bevat.">
                        >
                        ["at0146"] = <
                            text = <"Bestanddeel">
                            description = <"Het medicament of het medicatie bestanddeel is een enkel bestanddeel van het medicament. Deze term wordt gebruikt wanneer het archetype onderdeel is van een 'parent instance' van zichzelf, voor het beschrijven van individuele bestanddelen van een medicament.">
                        >
                        ["at0148"] = <
                            text = <"Alternatieve hoeveelheid">
                            description = <"*An equivalent representation of the amount of the medication or medication component. (en)">
                        >
                        ["at0150"] = <
                            text = <"Batch ID">
                            description = <"De identificatie toegewezen aan de productie batch door de fabrikant tijdens de productie. Ook wel partij-, lot- of chargenummer genoemd.">
                        >
                        ["at0151"] = <
                            text = <"Fabrikant">
                            description = <"De fabrikant van het medicament of medicatie bestanddeel.">
                        >
                        ["at0152"] = <
                            text = <"Dosis (presentatie)">
                            description = <"De dosis van het medicament of medicatie bestanddeel, uitgedrukt als een ratio.">
                        >
                        ["at0153"] = <
                            text = <"Dosis teller">
                            description = <"*The numerator of the strength fraction. (en)">
                        >
                        ["at0157"] = <
                            text = <"Dosis noemer">
                            description = <"*The denominator of the strength fraction. (en)">
                        >
                        ["ac0.1"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.2"] = <
                            text = <"*(Synthesized) (en)">
                        >
                    >
                    ["sv"] = <
                        ["at0000"] = <
                            text = <"Läkemedelsdetaljer">
                            description = <"Detaljer om ett läkemedel eller ett innehållsämne, inkluderat styrka, beredning och uppgifter om eventuella specifika beståndsdelar.">
                        >
                        ["at0001"] = <
                            text = <"Kombinationsförpackning">
                            description = <"Läkemedlet består av ett antal separata produkter som förpackats av tillverkaren, exempelvis Canesten Combi.">
                        >
                        ["at0003"] = <
                            text = <"Utgångsdatum">
                            description = <"Utgångsdatum eller -tidpunkt för läkemedlet eller innehållsämnet, såsom angivet av tillverkaren eller vid en individuell beredning av en blandning.">
                        >
                        ["at0071"] = <
                            text = <"Beredning">
                            description = <"Beredningsformen, eller en beskrivning av läkemedlet eller innehållsämnet.">
                        >
                        ["at0080"] = <
                            text = <"Terapeutisk">
                            description = <"Beståndsdel som ensam eller i kombination med en eller flera andra beståndsdelar bedöms uppfylla läkemedlets avsedda verkan.">
                        >
                        ["at0083"] = <
                            text = <"Adjuvant">
                            description = <"Beståndsdel vars primära funktion är att modifiera effekten hos en aktiv beståndsdel. En adjuvant beståndsdel kan antingen vara terapeutiskt verksam eller inte.">
                        >
                        ["at0084"] = <
                            text = <"Hjälpämne">
                            description = <"Beståndsdel som är overksam i förhållande till läkemedlets avsedda verkan.">
                        >
                        ["at0115"] = <
                            text = <"Styrka (koncentration)">
                            description = <"Styrkan hos läkemedlet eller innehållsämnet, angivet som koncentration.">
                        >
                        ["at0127"] = <
                            text = <"Verkningssätt">
                            description = <"Verkningssättet för läkemedlet eller innehållsämnet i en blandning.">
                        >
                        ["at0132"] = <
                            text = <"Namn">
                            description = <"Namnet på läkemedlet eller innehållsämnet.">
                        >
                        ["at0133"] = <
                            text = <"Beskrivning">
                            description = <"Beskrivning av läkemedlet eller innehållsämnet där det inte är möjligt att beskriva detta fullt ut med hjälp av de strukturerade datafälten.">
                        >
                        ["at0138"] = <
                            text = <"Beståndsdel">
                            description = <"Detaljer om en beståndsdel eller produkt som används för att göra en blandad förpackning, beredning eller infusion.">
                        >
                        ["at0139"] = <
                            text = <"Mängd">
                            description = <"Mängden av läkemedlet eller innehållsämnet.">
                        >
                        ["at0141"] = <
                            text = <"Strukturerade detaljer">
                            description = <"Ytterligare information om läkemedlet eller innehållsämnet.">
                        >
                        ["at0142"] = <
                            text = <"Kategori">
                            description = <"Kategorin av läkemedel eller innehållsämne, med avseende på tillverkning eller beredning samt antalet beståndsdelar.">
                        >
                        ["at0143"] = <
                            text = <"Situationsanpassad blandning">
                            description = <"Läkemedlet eller innehållsämnet består av en blandning av beståndsdelar som anges i ordinationen. Dessa bereds vanligtvis av apotek eller avdelningspersonal för att anpassas till enskilda patienter.">
                        >
                        ["at0144"] = <
                            text = <"Kombinationsläkemedel">
                            description = <"Läkemedlet eller innehållsämnet består av ett antal aktiva substanser som är förblandade till en enda beredningsform av tillverkaren, såsom en tablett, en kräm eller pulver, exempelvis paracetamol/kodein.">
                        >
                        ["at0145"] = <
                            text = <"Singelsubstansprodukt">
                            description = <"Läkemedlet eller innehållsämnet är en tillverkad produkt som innehåller en enda aktiv substans.">
                        >
                        ["at0146"] = <
                            text = <"Beståndsdel">
                            description = <"Läkemedlet eller innehållsämnet är en enskild beståndsdel i läkemedlet. Denna term används när arketypen är nästlad i en föräldrainstans av sig själv för att beskriva de enskilda beståndsdelarna i ett läkemedel.">
                        >
                        ["at0148"] = <
                            text = <"Alternativ mängd">
                            description = <"Ett likvärdigt sätt att beskriva mängden av läkemedlet eller innehållsämnet.">
                        >
                        ["at0150"] = <
                            text = <"Batch-ID">
                            description = <"Den identifierare som tillverkaren tilldelat batchen under produktionen.">
                        >
                        ["at0151"] = <
                            text = <"Tillverkare">
                            description = <"Tillverkaren av läkemedlet eller innehållsämnet.">
                        >
                        ["at0152"] = <
                            text = <"Styrka (beskrivning)">
                            description = <"Styrkan hos läkemedlet eller innehållsämnet, uttryckt som en fraktion.">
                        >
                        ["at0153"] = <
                            text = <"Styrka i täljare">
                            description = <"Täljaren i styrkefraktionen.">
                        >
                        ["at0157"] = <
                            text = <"Styrka i nämnare">
                            description = <"Nämnaren i styrkefraktionen.">
                        >
                        ["ac0.1"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.2"] = <
                            text = <"*(Synthesized) (en)">
                        >
                    >
                    ["ca"] = <
                        ["at0000"] = <
                            text = <"Detalls de la medicació">
                            description = <"Dades sobre un medicament o un component d'un medicament, inclosa la concentració, la forma i els detalls de qualsevol component específic.">
                        >
                        ["at0001"] = <
                            text = <"Producte combinat">
                            description = <"El medicament o component del medicament consisteix en una sèrie de productes independents preenvasats pel fabricant, per exemple Canesten Combi.">
                        >
                        ["at0003"] = <
                            text = <"Caducitat">
                            description = <"La data i/o hora de caducitat del medicament o del component del medicament, indicades pel fabricant o la persona que prepara la barreja.">
                        >
                        ["at0071"] = <
                            text = <"Forma farmacèutica">
                            description = <"La formulació o presentació del medicament o component del medicament.">
                        >
                        ["at0080"] = <
                            text = <"Terapèutic">
                            description = <"Constituent que només o en combinació amb un o més ingredients es considera que compleix l'activitat prevista d'un medicament.">
                        >
                        ["at0083"] = <
                            text = <"Adjuvant">
                            description = <"Constituent de la qual la funció principal és modificar l'activitat d'un constituent actiu. Un component adjuvant pot ser terapèuticament actiu o no.">
                        >
                        ["at0084"] = <
                            text = <"Excipient">
                            description = <"Constituent inert en relació amb l'activitat prevista del medicament.">
                        >
                        ["at0115"] = <
                            text = <"Dosi (concentració)">
                            description = <"La dosi del medicament o component del medicament, en forma de concentració.">
                        >
                        ["at0127"] = <
                            text = <"Rol (funció)">
                            description = <"El paper que juga el medicament o component del medicament dins una barreja.">
                        >
                        ["at0132"] = <
                            text = <"Nom">
                            description = <"Nom del medicament o del component del medicament.">
                        >
                        ["at0133"] = <
                            text = <"Descripció">
                            description = <"Descripció narrativa del medicament o del component del medicament quan no sigui possible descriure'l completament mitjançant elements estructurats.">
                        >
                        ["at0138"] = <
                            text = <"Constituent">
                            description = <"Dades d'un ingredient o producte utilitzat per compondre un envàs mixt, un preparat o una infusió.">
                        >
                        ["at0139"] = <
                            text = <"Quantitat">
                            description = <"Quantitat de medicament o component del medicament.">
                        >
                        ["at0141"] = <
                            text = <"Detalls estructurats">
                            description = <"Detalls addicionals sobre el medicament o el component del medicament.">
                        >
                        ["at0142"] = <
                            text = <"Categoria">
                            description = <"La categoria del medicament o component del medicament, pel que fa a la fabricació o la preparació, i el nombre d'ingredients.">
                        >
                        ["at0143"] = <
                            text = <"Barreja ad hoc">
                            description = <"El medicament o el component del medicament es compon d'una barreja d'ingredients especificats a l'ordre. Normalment els prepara el personal de farmàcia o de la sala per adaptar-los a cada pacient.">
                        >
                        ["at0144"] = <
                            text = <"Producte amb diversos ingredients">
                            description = <"El medicament o component del medicament consisteix en una sèrie de principis actius que el fabricant combina prèviament en una forma única, com ara un comprimit, una crema o una pols, per exemple Paracetamol/codeïna.">
                        >
                        ["at0145"] = <
                            text = <"Producte monocomponent">
                            description = <"El medicament o component del medicament és un producte manufacturat que conté un únic principi actiu.">
                        >
                        ["at0146"] = <
                            text = <"Ingredient">
                            description = <"El medicament o component del medicament és un ingredient individual del medicament. Aquest terme s'utilitza quan l'arquetip està imbricat dins d'una instància pare de si mateix, per descriure els ingredients individuals d'un medicament.">
                        >
                        ["at0148"] = <
                            text = <"Quantitat alternativa">
                            description = <"Una representació equivalent de la quantitat de medicament o component del medicament.">
                        >
                        ["at0150"] = <
                            text = <"ID de lot">
                            description = <"Identificador assignat al lot de producció pel fabricant durant la fabricació.">
                        >
                        ["at0151"] = <
                            text = <"Fabricant">
                            description = <"El fabricant del medicament o del component del medicament.">
                        >
                        ["at0152"] = <
                            text = <"Dosi (presentació)">
                            description = <"La dosi del medicament o del component del medicament, expressada en forma de proporció.">
                        >
                        ["at0153"] = <
                            text = <"Numerador de dosi">
                            description = <"El numerador de la fracció de dosi.">
                        >
                        ["at0157"] = <
                            text = <"Denominador de dosi">
                            description = <"El denominador de la fracció de dosi.">
                        >
                        ["ac0.1"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.2"] = <
                            text = <"*(Synthesized) (en)">
                        >
                    >
                    ["es"] = <
                        ["at0000"] = <
                            text = <"Detalles de la medicación">
                            description = <"Detalles sobre el medicamento o componente de un medicamento, incluido la dosis, forma o detalles de cualquier otro componente específico.">
                        >
                        ["at0001"] = <
                            text = <"Producto combinado">
                            description = <"El medicamento o componente del medicamento consiste en un número separado de productos independientes previamente envasados por el fabricante; por ejemplo, Canesten Combi.">
                        >
                        ["at0003"] = <
                            text = <"Caducidad">
                            description = <"La fecha y/u hora de caducidad del medicamento o componente del medicamento, indicadas por el fabricante o la persona que prepara la mezcla.">
                        >
                        ["at0071"] = <
                            text = <"Forma farmacéutica">
                            description = <"La formulación o presentación del medicamento o componente del medicamento.">
                        >
                        ["at0080"] = <
                            text = <"Terapéutico">
                            description = <"Componente que a solas o en combinación con uno o más ingredientes se considera que cumple la actividad prevista de un medicamento.">
                        >
                        ["at0083"] = <
                            text = <"Adyuvante">
                            description = <"Componente del cual la función principal es modificar la actividad de un principio activo. Un componente adyuvante puede ser terapéuticamente activo o no.">
                        >
                        ["at0084"] = <
                            text = <"Excipiente">
                            description = <"Componente inerte en relación con la actividad prevista del medicamento.">
                        >
                        ["at0115"] = <
                            text = <"Dosis (concentración)">
                            description = <"La dosis del medicamento o componente del medicamento, en forma de concentración.">
                        >
                        ["at0127"] = <
                            text = <"Función">
                            description = <"La función del medicamento o componente del medicamento dentro de una mezcla.">
                        >
                        ["at0132"] = <
                            text = <"Nombre">
                            description = <"Nombre del medicamento o componente del medicamento.">
                        >
                        ["at0133"] = <
                            text = <"Descripción">
                            description = <"Descripción narrativa sobre el medicamento o componente del medicamento cuando no sea posible describirlo completamente mediante elementos estructurados.">
                        >
                        ["at0138"] = <
                            text = <"Componente">
                            description = <"Detalles de un ingrediente o producto utilizado para componer un envase mixto, un preparado o una infusión.">
                        >
                        ["at0139"] = <
                            text = <"Cantidad">
                            description = <"Cantidad de medicamento o componente del medicamento.">
                        >
                        ["at0141"] = <
                            text = <"Detalles estructurados">
                            description = <"Detalles adicionales sobre el medicamento o componente del medicamento.">
                        >
                        ["at0142"] = <
                            text = <"Categoría">
                            description = <"La categoría del medicamento o componente del medicamento por lo que hace a la fabricación o preparación, y la cantidad de ingredientes.">
                        >
                        ["at0143"] = <
                            text = <"Mezcla ad hoc">
                            description = <"La medicación o componentes de la medicación consisten en una serie de principios activos que el fabricante combina previamente en una forma única, como ahora un comprimido, una crema o un polvo; por ejemplo, paracetamol/codeína.">
                        >
                        ["at0144"] = <
                            text = <"Producto con múltiples componentes">
                            description = <"El medicamento o componente del medicamento consiste en una serie de principios activos que el fabricante combina previamente en una forma única, como ahora un comprimido o una crema en polvo; por ejemplo, paracetamol/codeína.">
                        >
                        ["at0145"] = <
                            text = <"Producto de un solo componente">
                            description = <"El medicamento o componente del medicamento es un producto fabricado que contiene un único principio activo.">
                        >
                        ["at0146"] = <
                            text = <"Componente">
                            description = <"La medicación o componente del medicamento es un componente individual del medicamento. Este término se utiliza cuando el arquetipo está situado dentro de una instancia principal de sí mismo para describir los componentes individuales de un medicamento.">
                        >
                        ["at0148"] = <
                            text = <"Cantidad alternativa">
                            description = <"Una representación equivalente de la cantidad de medicamento o componente del medicamento.">
                        >
                        ["at0150"] = <
                            text = <"Identificación del lote">
                            description = <"El identificador asignado al lote de producción por el fabricante durante la fabricación del producto.">
                        >
                        ["at0151"] = <
                            text = <"Fabricante">
                            description = <"El fabricante de la medicación o del componente de medicación.">
                        >
                        ["at0152"] = <
                            text = <"Dosis (presentación)">
                            description = <"La dosis del medicamento o del componente del medicamento, expresada en forma de proporción.">
                        >
                        ["at0153"] = <
                            text = <"Numerador de dosis">
                            description = <"El numerador de la fracción de dosis.">
                        >
                        ["at0157"] = <
                            text = <"Denominador de dosis">
                            description = <"El denominador de la fracción de dosis.">
                        >
                        ["ac0.1"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.2"] = <
                            text = <"*(Synthesized) (en)">
                        >
                    >
