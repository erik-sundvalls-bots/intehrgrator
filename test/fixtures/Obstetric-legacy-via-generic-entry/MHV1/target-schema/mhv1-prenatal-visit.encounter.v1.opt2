                    ["ca"] = <
                        ["at0000"] = <
                            text = <"Sinopsi clínica">
                            description = <"Informe o resum narratiu sobre un pacient, específicament des de la perspectiva d'un professional d’atenció sanitària, i amb o sense interpretacions associades.">
