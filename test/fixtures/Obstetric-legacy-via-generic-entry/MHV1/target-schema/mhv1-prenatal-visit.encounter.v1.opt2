                        >
                        ["at0079"] = <
                            text = <"Variant">
                            description = <"Spesifikk variant eller subtype av diagnose, hvis det er relevant.">
                        >
                        ["at0080"] = <
                            text = <"Innvirkning">
                            description = <"Overordnet vurdering av innvirkningen et helseproblem har for individet.">
                        >
