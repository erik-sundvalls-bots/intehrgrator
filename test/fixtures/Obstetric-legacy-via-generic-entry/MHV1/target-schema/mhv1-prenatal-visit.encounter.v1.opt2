                        >
                        ["at0046"] = <
                            text = <"Status">
                            description = <"Jäsennellyt yksityiskohdat diagnosointiprosessin sijainti-, alue-, jakso- tai työnkulkukohtaisista näkökohdista.">
                        >
                        ["at0047"] = <
