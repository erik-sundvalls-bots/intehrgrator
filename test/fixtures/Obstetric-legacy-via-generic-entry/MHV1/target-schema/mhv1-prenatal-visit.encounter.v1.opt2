                        >
                    >
                    ["el"] = <
                        ["at0000"] = <
                            text = <"Κλινική σύνοψη">
                            description = <"Αφηγηματική περίληψη ή επισκόπηση σχετικά με έναν ασθενή, ειδικά από την οπτική γωνία ενός παρόχου υγειονομικής περίθαλψης και με ή χωρίς σχετικές ερμηνείες.">
                        >
                        ["at0001"] = <
