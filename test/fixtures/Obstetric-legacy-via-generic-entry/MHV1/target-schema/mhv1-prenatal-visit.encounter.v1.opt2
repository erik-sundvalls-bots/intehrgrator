                        >
                        ["at0020"] = <
                            text = <"مستلقٍ">
                            description = <"يتم قياس الطول في وضع مستلقٍ متمدد بشكل تام مع استواء الحوض, و الأرجل ممتدة و الأقدام مرتخية.">
                        >
                        ["at0021"] = <
