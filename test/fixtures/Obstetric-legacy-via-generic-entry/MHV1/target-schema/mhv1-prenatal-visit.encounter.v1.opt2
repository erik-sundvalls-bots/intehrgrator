                        ["at0102"] = <
                            text = <"Duración de la administración">
                            description = <"Periodo de tiempo durante el cual debe administrarse una dosis única del medicamento o vacuna.">
                        >
                        ["at0134"] = <
                            text = <"Velocidad de administración">
                            description = <"La velocidad a la que debe administrarse la medicación, por ejemplo una infusión.">
                        >
                        ["at0135"] = <
                            text = <"Fórmula de dosificación">
                            description = <"La fórmula utilizada para calcular la cantidad de dosis o la tasa de administración cuando ésta depende de algún otro factor, como el peso corporal o la superficie.">
