                    ["sv"] = <
                        ["at0000"] = <
                            text = <"Problem/Diagnos">
                            description = <"Detaljer om enskilt identifierat hälsotillstånd, skada, funktionshinder eller något annat problem som påverkar individens fysiska, psykiska och eller sociala välbefinnande.">
                        >
                        ["at0001"] = <
                            text = <"structure">
                            description = <"@ internal @">
                        >
                        ["at0002"] = <
                            text = <"Benämning på problem/diagnos">
                            description = <"Problemets eller diagnosens benämning.">
                        >
                        ["at0003"] = <
                            text = <"Datum och tid för klinisk bekräftelse">
                            description = <"Uppskattat eller reellt datum och tid när problemets eller diagnosens tecken eller symtom först bekräftades av sjukvårdspersonal.">
                        >
                        ["at0005"] = <
                            text = <"Svårighetsgrad">
                            description = <"En bedömning av problemets eller diagnosens totala svårighetsgrad.">
                        >
                        ["at0009"] = <
                            text = <"Klinisk beskrivning">
                            description = <"Beskrivning av problemet eller diagnosen.">
                        >
                        ["at0012"] = <
                            text = <"Kroppslokalisation">
                            description = <"Identifiering av problemets eller diagnosens anatomiska lokalisation.">
                        >
                        ["at0030"] = <
                            text = <"Datum och tid för tillfrisknande">
                            description = <"Av sjukvårdspersonal uppskattat eller faktiskt datum och tid för tillfrisknande eller remission.">
                        >
                        ["at0032"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0039"] = <
                            text = <"Strukturerad kroppslokalisation">
                            description = <"En strukturerad anatomisk lokalisation för problemet eller diagnosen.">
                        >
                        ["at0043"] = <
                            text = <"Specifika detaljer">
                            description = <"Ytterligare detaljer som krävs för att dokumentera de egenskaper som är unika för problemet eller diagnosen.">
                        >
                        ["at0046"] = <
                            text = <"Status">
                            description = <"Strukturerade specifika detaljer om den diagnostiska processen såsom plats, område, episod eller arbetsflöde.">
                        >
                        ["at0047"] = <
                            text = <"Lindrig">
                            description = <"Problemet eller diagnosen påverkar inte normal aktivitet och kan inte orsaka skador på hälsan utan behandling.">
                        >
                        ["at0048"] = <
                            text = <"Måttlig">
                            description = <"Problemet eller diagnosen stör normal aktivitet och kan skada hälsan utan behandling.">
                        >
                        ["at0049"] = <
                            text = <"Svår">
                            description = <"Problemet eller diagnosen förhindrar normal aktivitet och kan allvarligt skada hälsan utan behandling.">
                        >
                        ["at0069"] = <
                            text = <"Kommentar">
                            description = <"Ytterligare beskrivning av problemet eller diagnosen som inte dokumenterats i andra fält.">
                        >
                        ["at0070"] = <
                            text = <"Senast uppdaterad">
                            description = <"Datum då dokumentation om problemet eller diagnosen senast uppdaterades.">
                        >
                        ["at0071"] = <
                            text = <"Tilläggsinformation">
                            description = <"Plats för tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.">
                        >
                        ["at0072"] = <
                            text = <"Förlopp">
                            description = <"Beskrivning av problemets eller diagnosens förlopp sedan debuten.">
                        >
                        ["at0073"] = <
                            text = <"Diagnostisk säkerhet">
                            description = <"Graden av säkerhet vid fastställande av diagnosen.">
                        >
                        ["at0074"] = <
                            text = <"Misstänkt">
                            description = <"Diagnosen har bekräftats med en låg grad av säkerhet.">
                        >
                        ["at0075"] = <
                            text = <"Sannolik">
                            description = <"Diagnosen har bekräftats med en hög grad av säkerhet.">
                        >
                        ["at0076"] = <
                            text = <"Bekräftad">
                            description = <"Diagnosen har bekräftats mot kända kriterier.">
                        >
                        ["at0077"] = <
                            text = <"Datum och tid för debut">
                            description = <"Uppskattat eller reellt datum och tid när problemets eller diagnosens tecken eller symtom först observerades.">
                        >
                        ["at0078"] = <
                            text = <"Orsak">
                            description = <"En eller flera orsaker till problemet eller diagnosen, eller dess uppkomstsätt.">
                        >
                        ["at0079"] = <
                            text = <"Specificering">
                            description = <"Specificering av diagnosen, där det är relevant.">
                        >
                        ["at0080"] = <
                            text = <"Påverkan">
                            description = <"Övergripande bedömning av hur ett hälsoproblem påverkar patienten.">
                        >
                        ["ac0.1"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.2"] = <
                            text = <"*(Synthesized) (en)">
                        >
                    >
                    ["ko"] = <
                        ["at0000"] = <
                            text = <"문제/진단">
                            description = <"한 개인의 신체, 정신 그리고/또는 사회적 웰빙에 영향을 주는 단일한 확인된 건강 성태, 상해, 장애 또는 다른 이슈에 대한 상세내용.">
                        >
                        ["at0001"] = <
                            text = <"structure">
                            description = <"@ internal @">
                        >
                        ["at0002"] = <
                            text = <"문제/진단명">
                            description = <"명칭으로 문제 또는 진단의 식별.">
                        >
                        ["at0003"] = <
                            text = <"임상적으로 인지된 날짜/시간">
                            description = <"진단 또는 문가가 헬스케어 전문가에게 인지된 추정 또는 실제 날짜/시간.">
                        >
                        ["at0005"] = <
                            text = <"중증도">
                            description = <"문제 또는 진단의 전반적인 중증도 평가.">
                        >
                        ["at0009"] = <
                            text = <"임상적 서술">
                            description = <"문제 또는 진단에 대한 서술 기록.">
                        >
                        ["at0012"] = <
                            text = <"신체 위치">
                            description = <"문제 또는 진단의 위치를 위해 간단한 신체 위치 확인">
                        >
                        ["at0030"] = <
                            text = <"완치 날짜/시간">
                            description = <"헬스케어 전문가에 의해 결정된 이 문제나 진단의 추정 또는 실제 완치 또는 관해 날짜시간.">
                        >
                        ["at0032"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0039"] = <
                            text = <"구조화된 신체 위치">
                            description = <"문제 또는 진단을 위한 구조화된 해부학적 위치">
                        >
                        ["at0043"] = <
                            text = <"특정 상세내용">
                            description = <"이 문제 또는 진단의 유일한 속성으로 기록하는데 필요한 상세내용.">
                        >
                        ["at0046"] = <
                            text = <"상태">
                            description = <"진단 과정의 위치-, 도메인-, 에피소드- 또는 워크플로우-특징적인 측면에 대한 구조화된 상세내용.">
                        >
                        ["at0047"] = <
                            text = <"경도">
                            description = <"문제나 진단이 정상 활동을 방해하지 않거나 치료하지 않으면 건강에 해를 일으킬 수 있음.">
                        >
                        ["at0048"] = <
                            text = <"중등도">
                            description = <"문제나 진단이 정상 활동에 방해가 되거나 치료하지 않으면 건강에 해가 됨.">
                        >
                        ["at0049"] = <
                            text = <"증증도">
                            description = <"문제나 진단이 정상 활동을 할 수 없게 하거나 치료하지 않으면 건강에 심각한 해가 됨.">
                        >
                        ["at0069"] = <
                            text = <"코멘트">
                            description = <"다른 필드에서 획득되지 않은 문제 또는 진단에 대한 추가적인 서술내용">
                        >
                        ["at0070"] = <
                            text = <"최종 업데이트 날짜">
                            description = <"문제 또는 진단이 최종 업데이트된 날짜.">
                        >
                        ["at0071"] = <
                            text = <"확장">
                            description = <"로컬 컨텐트를 획득하거나 다른 참조모델/표기형식과 조율하기 위해 필요한 추가적인 정보.">
                        >
                        ["at0072"] = <
                            text = <"경과 서술">
                            description = <"발병이후 문제 또는 진단의 결과에 대한 서술.">
                        >
                        ["at0073"] = <
                            text = <"진단적 확실성">
                            description = <"진단을 확인하는 신뢰의 수준.">
                        >
                        ["at0074"] = <
                            text = <"의심">
                            description = <"진단이 낮은 확신 수준으로 식별됨.">
                        >
                        ["at0075"] = <
                            text = <"추정">
                            description = <"진단이 높은 확신 수준으로 식별됨.">
                        >
                        ["at0076"] = <
                            text = <"확진">
                            description = <"진단이 인정된 기준에 대해 확진됨.">
                        >
                        ["at0077"] = <
                            text = <"발병 날짜/시간">
                            description = <"문제/진단의 증상 또는 징후가 처음 관찰된 추정 또는 실제 날짜/시간.">
                        >
                        ["at0078"] = <
                            text = <"*Cause (en)">
                            description = <"*A cause, set of causes, or manner of causation of the problem or diagnosis.(en)">
                        >
                        ["at0079"] = <
                            text = <"*Variant (en)">
                            description = <"*Specific variant or subtype of the Diagnosis, if relevant. (en)">
                        >
                        ["at0080"] = <
                            text = <"*DV_TEXT (en)">
                        >
                        ["ac0.1"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.2"] = <
                            text = <"*(Synthesized) (en)">
                        >
                    >
                    ["fi"] = <
                        ["at0000"] = <
                            text = <"Ongelma/Diagnoosi">
                            description = <"Yksityiskohdat yksittäisestä tunnistetusta terveystilasta, vammasta, vammasta tai muusta aiheesta, joka vaikuttaa yksilön fyysiseen, henkiseen ja / tai sosiaaliseen hyvinvointiin.">
                        >
                        ["at0001"] = <
                            text = <"structure">
                            description = <"@ internal @">
                        >
                        ["at0002"] = <
                            text = <"Ongelman/Diagnoosin nimi">
                            description = <"Ongelman tai diagnoosin tunnistaminen nimellä.">
                        >
                        ["at0003"] = <
                            text = <"Toteamispäivämäärä">
                            description = <"Arvioitu tai tarkka ajankohta ongelman tai diagnoosin toteamiselle terv.huollon ammattilaisen tekemänä">
                        >
                        ["at0005"] = <
                            text = <"Vakavuus">
                            description = <"Arvioitu vakavuus oireen tai diagnoosin kohdalla">
                        >
                        ["at0009"] = <
                            text = <"Kliininen kuvaus">
                            description = <"Ongelman tai diagnoosin vapaamuotoinen selitys">
                        >
                        ["at0012"] = <
                            text = <"Kehonosa">
                            description = <"Yksinkertaisen vartalokohdan tunnistaminen ongelman tai diagnoosin sijaintia varten.">
                        >
                        ["at0030"] = <
                            text = <"Toteamise pvm">
                            description = <"ongelman tai diagnoosin arvioitu tai todellinen ratkaisemis- tai loppumispäivämäärä / -aika, jonka on määrittänyt terveydenhuollon ammattilainen.">
                        >
                        ["at0032"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0039"] = <
                            text = <"Anatominen alue">
                            description = <"Ongelman tai diagnoosin anatominen alue">
                        >
                        ["at0043"] = <
                            text = <"Tarkennettu tieto">
                            description = <"Tiedot, joita tarvitaan lisäksi tämän ongelman tai diagnoosin yksilöivinä ominaisuuksina tallentamiseksi.">
                        >
                        ["at0046"] = <
                            text = <"Status">
                            description = <"Jäsennellyt yksityiskohdat diagnosointiprosessin sijainti-, alue-, jakso- tai työnkulkukohtaisista näkökohdista.">
                        >
                        ["at0047"] = <
                            text = <"Vähäinen">
                            description = <"Ongelma tai diagnoosi ei häiritse normaalia toimintaa tai voi aiheuttaa terveysvaurioita, jos sitä ei hoideta.">
                        >
                        ["at0048"] = <
                            text = <"Kohtalainen">
                            description = <"Ongelma tai diagnoosi häiritsee normaalia toimintaa tai vahingoittaa terveyttä, jos sitä jätetään hoitamatta.">
                        >
                        ["at0049"] = <
                            text = <"Vakava">
                            description = <"Ongelma tai diagnoosi estää normaalia toimintaa tai vahingoittaa vakavasti terveyttä, jos sitä jätetään hoitamatta.">
                        >
                        ["at0069"] = <
                            text = <"Kommentti">
                            description = <"Lisätietoa ongelmasta tai diagnoosista, jota ei voi asettaa edeltäville tietokentille.">
                        >
                        ["at0070"] = <
                            text = <"Viimeksi päivitetty">
                            description = <"Ongelman tai diagnoosin viimeisin päivityspäivämäärä">
                        >
                        ["at0071"] = <
                            text = <"Laajennus">
                            description = <"Additional information required to capture local content or to align with other reference models/formalisms.">
                        >
                        ["at0072"] = <
                            text = <"Ongelman kulku">
                            description = <"Kuvaus ongelman tai diagnoosin etenemisestä alusta.">
                        >
                        ["at0073"] = <
                            text = <"Diagnoosin varmuus">
                            description = <"Diagnoosin tunnistamisen luotettavuus">
                        >
                        ["at0074"] = <
                            text = <"Epäilty">
                            description = <"Diagnoosi on tunnistettu alhaisella varmuustasolla.">
                        >
                        ["at0075"] = <
                            text = <"Mahdollinen">
                            description = <"Diagnoosi on tunnistettu erittäin varmuudella.">
                        >
                        ["at0076"] = <
                            text = <"Varmistettu">
                            description = <"Diagnoosi on vahvistettu tunnustettujen kriteerien perusteella.">
                        >
                        ["at0077"] = <
                            text = <"Alkamis pvm">
                            description = <"Arvioitu tai todellinen päivämäärä / aika, jolloin ongelman / diagnoosin merkkejä tai oireita havaittiin ensimmäisen kerran.">
                        >
                        ["at0078"] = <
