                        >
                        ["at0030"] = <
                            text = <"Toteamise pvm">
                            description = <"ongelman tai diagnoosin arvioitu tai todellinen ratkaisemis- tai loppumispäivämäärä / -aika, jonka on määrittänyt terveydenhuollon ammattilainen.">
                        >
                        ["at0032"] = <
                            text = <"Tree">
