                            description = <"Data i/o hora d'inici de la complicació.">
                        >
                        ["at0064"] = <
                            text = <"Descripció">
                            description = <"Descripció narrativa de la complicació.">
                        >
                        ["at0065"] = <
                            text = <"Complicació materna">
                            description = <"Detalls sobre complicacions de l'embaràs o del part que afecten la mare.">
                        >
                        ["at0066"] = <
                            text = <"Complicació">
                            description = <"Identificació de la complicació.">
                        >
                        ["at0067"] = <
                            text = <"Data/hora d'inici">
                            description = <"Data d'inici de la complicació, avaluada per un metge.">
