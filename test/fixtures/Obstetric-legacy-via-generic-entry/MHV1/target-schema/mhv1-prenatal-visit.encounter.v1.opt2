                        >
                    >
                    ["ar-sy"] = <
                        ["at0000"] = <
                            text = <"المختصر السريري">
                            description = <"ملخص بالرواية أو نظرة عامة عن المريض, خاصة من وجهة نظر مقدم الخدمة الصحية, مع إرفاق أو عدم إرفاق تفسيرات ">
                        >
                        ["at0001"] = <
                            text = <"*List(en)">
                            description = <"*@ internal @(en)">
