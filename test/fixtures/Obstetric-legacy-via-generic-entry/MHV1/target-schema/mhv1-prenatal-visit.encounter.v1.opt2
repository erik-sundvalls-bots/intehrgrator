                        ["ac0.8"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.9"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.10"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.11"] = <
