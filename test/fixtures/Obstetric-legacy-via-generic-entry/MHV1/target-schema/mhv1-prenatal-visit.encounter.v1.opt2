                            description = <"*@ internal @(en)">
                        >
                        ["at0004"] = <
                            text = <"الارتفاع / الطول">
                            description = <"طول الجسم من تاج الرأس إلى أخمص القدم.">
                        >
                        ["at0007"] = <
