                        >
                    >
                    ["de"] = <
                        ["at0000"] = <
                            text = <"Zusammenfassung der Menstruation">
                            description = <"Zusammenfassende oder dauerhafte Informationen über die Menstruationsgeschichte einer Person.">
                        >
                        ["at0001"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0002"] = <
                            text = <"Menarche">
                            description = <"Beginn des ersten Menstruationszyklus.">
                        >
                        ["at0003"] = <
                            text = <"Menstruationsstatus">
                            description = <"Angaben zur aktuellen Menstruationsaktivität.">
                        >
                        ["at0004"] = <
                            text = <"Menopause">
                            description = <"Ausbleiben aller Menstruationszyklen.">
                        >
                        ["at0005"] = <
                            text = <"Prämenopausal">
                            description = <"Nach der Menarche, vor der Menopause und ohne Symptome im Zusammenhang mit den hormonellen Veränderungen vor der Menopause.">
                        >
                        ["at0006"] = <
                            text = <"Perimenopausal">
                            description = <"or der Menopause auftretende Symptome, die mit den hormonellen Veränderungen im Vorfeld der Menopause zusammenhängen.">
                        >
                        ["at0007"] = <
                            text = <"Postmenopausal">
                            description = <"Nach der Menopause.">
                        >
                        ["at0008"] = <
                            text = <"Item tree">
                            description = <"@ internal @">
                        >
                        ["at0009"] = <
                            text = <"Erweiterung">
                            description = <"Zusätzliche Informationen sind erforderlich, um lokale Inhalte zu erfassen oder mit anderen Referenzmodellen/Formalismen in Einklang zu bringen.">
                        >
                        ["at0010"] = <
                            text = <"Pro Episode">
                            description = <"Angaben über ein typisches Menstruationsmuster während eines bestimmten Zeitintervalls.">
                        >
                        ["at0011"] = <
                            text = <"Episodenbezeichnung">
                            description = <"Ein Name oder ein Kennzeichen, das mit dieser Episode der Menstruation verbunden ist.">
                        >
                        ["at0012"] = <
                            text = <"Startdatum der Episode">
                            description = <"Datum des Beginns dieser Episode.">
                        >
                        ["at0013"] = <
                            text = <"Beschreibung">
                            description = <"Narrative Beschreibung dieser Episode.">
                        >
                        ["at0014"] = <
                            text = <"Typischer Zyklus">
                            description = <"Die übliche Vorhersehbarkeit der Menstruation während dieser Episode.">
                        >
                        ["at0015"] = <
                            text = <"Regelmäßig">
                            description = <"Der Beginn der Menstruation ist von Monat zu Monat ungefähr vorhersehbar.">
                        >
                        ["at0016"] = <
                            text = <"Unregelmäßig">
                            description = <"Der Beginn der Menstruation ist nicht von Monat zu Monat vorhersehbar.">
                        >
                        ["at0017"] = <
                            text = <"Typische Zykluslänge">
                            description = <"Die übliche Länge des Zyklus während dieser Episode.">
                        >
                        ["at0018"] = <
                            text = <"Typische Menstruationsdauer">
                            description = <"Die übliche Dauer der Menstruation während dieser Episode.">
                        >
                        ["at0020"] = <
                            text = <"Zusätzliche Details">
                            description = <"Zusätzliche strukturierte Details über diese Episode der Menstruation.">
                        >
                        ["at0021"] = <
                            text = <"Enddatum der Episode">
                            description = <"Datum, an dem diese Episode endete.">
                        >
                        ["at0022"] = <
                            text = <"Kommentar zur Episode">
                            description = <"Zusätzliche Beschreibung über diese Episode der Menstruation, die in anderen Bereichen nicht erfasst wird.">
                        >
                        ["at0023"] = <
                            text = <"Kommentar">
                            description = <"Zusätzliche Angaben zu den allgemeinen Mustern und Episoden der Menstruation, die in anderen Bereichen nicht erfasst werden.">
                        >
                        ["at0024"] = <
                            text = <"Datum der letzten Aktualisierung">
                            description = <"Datum, an dem die Zusammenfassung der Menstruation, einschließlich der Episoden, aktualisiert wurde.">
                        >
                        ["at0025"] = <
                            text = <"Allgemeine Beschreibung">
                            description = <"Narrative Beschreibung des allgemeinen Menstruationszyklus.">
                        >
                        ["at0026"] = <
                            text = <"Prämenarchal">
                            description = <"Vor dem ersten Einsetzen der Menstruation.">
                        >
                        ["ac0.1"] = <
                            text = <"*(Synthesized) (en)">
                        >
                    >
                >
