                        >
                        ["at0020"] = <
                            text = <"Acostado">
                            description = <"La longitud corporal es medida en una posición recostada y completamente extendida, con la pelvis plana, las piernas extendidas y los pies flexionados.">
                        >
                        ["at0021"] = <
