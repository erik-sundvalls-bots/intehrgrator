                        >
                    >
                    ["es"] = <
                        ["at0000"] = <
                            text = <"Calificador del problema/diagnóstico">
                            description = <"Calificador contextual o temporal para un problema o diagnóstico específico.">
                        >
                        ["at0001"] = <
                            text = <"Episodicidad">
                            description = <"Categoría de este episodio para el problema/diagnóstico identificado.">
                        >
                        ["at0003"] = <
                            text = <"¿Activo/Inactivo?">
                            description = <"Categoría que permite la división de problemas y diagnósticos en listas de problemas activos o inactivos.">
                        >
                        ["at0004"] = <
                            text = <"Estado del diagnóstico">
                            description = <"Etapa o fase del proceso diagnóstico.">
                        >
                        ["at0016"] = <
                            text = <"Preliminar">
                            description = <"Diagnóstico inicial realizado, generalmente asociado con un bajo nivel de certeza clínica. Puede cambiar a medida que se disponga de resultados de pruebas o asesoramiento.">
                        >
                        ["at0017"] = <
                            text = <"En funcionamiento">
                            description = <"Diagnóstico provisional, basado en un nivel razonable de certeza clínica, pero a la espera de resultados de pruebas adicionales o asesoramiento clínico. Puede cambiar a medida que se disponga de resultados de pruebas o asesoramiento.">
                        >
                        ["at0018"] = <
                            text = <"Establecido">
                            description = <"Diagnóstico final fundamentado, basado en un alto nivel de certeza clínica, que puede incluir evidencia clínica de los resultados de pruebas. No se espera que cambie.">
                        >
                        ["at0026"] = <
                            text = <"Activo">
                            description = <"El problema o diagnóstico está actualmente activo y es clínicamente relevante.">
                        >
                        ["at0027"] = <
                            text = <"Inactivo">
                            description = <"El problema o diagnóstico no se ha resuelto por completo, pero está inactivo o se considera menos relevante para el contexto clínico actual.">
                        >
                        ["at0034"] = <
                            text = <"Nuevo">
                            description = <"Nueva aparición de un problema o diagnóstico, ya sea nuevo o existente. Se puede registrar por separado una marca para \"Primera aparición\" para distinguirla de las demás. El problema o diagnóstico persiste sin que se presenten nuevos episodios agudos.">
                        >
                        ["at0035"] = <
                            text = <"En curso">
                            description = <"La cuestión, problema o diagnóstico continúa, sin que se produzcan nuevos episodios agudos.">
                        >
                        ["at0060"] = <
                            text = <"¿Actual/Pasado?">
                            description = <"Categoría que admite la división de problemas y diagnósticos en listas de problemas actuales o pasados.">
                        >
                        ["at0061"] = <
                            text = <"Pasado">
                            description = <"Un problema que ocurrió en el pasado.">
                        >
                        ["at0062"] = <
                            text = <"Actual">
                            description = <"Un problema que ocurre actualmente.">
                        >
                        ["at0063"] = <
                            text = <"Categoría diagnóstica">
                            description = <"Categoría del problema o diagnóstico dentro de un episodio específico de atención y/o contexto local de atención.">
                        >
                        ["at0064"] = <
                            text = <"Diagnóstico principal">
                            description = <"El diagnóstico determinado como la causa principal de un episodio de ingreso hospitalario, un episodio de atención residencial o una asistencia al centro de salud.">
                        >
                        ["at0066"] = <
                            text = <"Diagnóstico secundario">
                            description = <"Un problema o diagnóstico que se presenta simultáneamente con el problema o diagnóstico principal. También puede denominarse comorbilidad.">
                        >
                        ["at0070"] = <
                            text = <"Indeterminado">
                            description = <"No es posible determinar si esta aparición del problema o diagnóstico es nueva o continua.">
                        >
                        ["at0071"] = <
                            text = <"Ocurrencia">
                            description = <"Categoría de la aparición de este problema o diagnóstico.">
                        >
                        ["at0073"] = <
                            text = <"¿Diagnóstico de ingreso?">
                            description = <"¿El problema o diagnóstico estaba presente al ingreso?">
                        >
                        ["at0076"] = <
                            text = <"Complicación">
                            description = <"Una evolución desfavorable de un problema o diagnóstico.">
                        >
                        ["at0077"] = <
                            text = <"Etiqueta del curso">
                            description = <"Categoría que refleja la rapidez de aparición y/o la duración y persistencia del problema o diagnóstico.">
                        >
                        ["at0079"] = <
                            text = <"Crónico">
                            description = <"Un problema o diagnóstico con efectos persistentes o duraderos, o que evoluciona con el tiempo.">
                        >
                        ["at0081"] = <
                            text = <"Agudo">
                            description = <"Un problema o diagnóstico de inicio rápido, de corta duración o ambos.">
                        >
                        ["at0083"] = <
                            text = <"Fase de resolución">
                            description = <"Fase de curación de un problema o diagnóstico agudo.">
                        >
                        ["at0084"] = <
                            text = <"Resuelto">
                            description = <"El problema o diagnóstico ha completado las fases normales de recuperación o curación y puede considerarse resuelto.">
                        >
                        ["at0085"] = <
                            text = <"En resolución">
                            description = <"El problema o diagnóstico está progresando satisfactoriamente a través de las etapas normales de recuperación o curación hacia su resolución.">
                        >
                        ["at0086"] = <
                            text = <"No se resuelve">
                            description = <"El problema o diagnóstico no está progresando satisfactoriamente a través de las etapas normales de recuperación o curación hacia su resolución.">
                        >
                        ["at0087"] = <
                            text = <"Indeterminado">
                            description = <"No es posible determinar el estado de resolución o curación del problema o diagnóstico.">
                        >
                        ["at0088"] = <
                            text = <"Refutado">
                            description = <"El diagnóstico previamente registrado ha sido reevaluado clínicamente o refutado con un alto nivel de certeza clínica. Este estado se utiliza para corregir un error en la historia clínica.">
                        >
                        ["at0089"] = <
                            text = <"Estado de remisión">
                            description = <"Estado de remisión de un diagnóstico incurable.">
                        >
                        ["at0090"] = <
                            text = <"En remisión">
                            description = <"No se han identificado signos ni síntomas persistentes de la enfermedad.">
                        >
                        ["at0092"] = <
                            text = <"No en remisión">
                            description = <"No se ha identificado disminución de los signos ni síntomas de la enfermedad.">
                        >
                        ["at0093"] = <
                            text = <"Indeterminado">
                            description = <"No es posible determinar si se ha identificado disminución de los signos o síntomas de la enfermedad.">
                        >
                        ["at0094"] = <
                            text = <"Agudo sobre crónico">
                            description = <"Un problema o diagnóstico con una exacerbación aguda de una afección crónica.">
                        >
                        ["at0095"] = <
                            text = <"Primera ocurrencia">
                            description = <"Esta es la primera vez que se presenta este problema o diagnóstico.">
                        >
                        ["at0096"] = <
                            text = <"Recurrencia">
                            description = <"Nueva aparición del mismo problema o diagnóstico tras la resolución de un episodio previo.">
                        >
                        ["at0097"] = <
                            text = <"Recaída">
                            description = <"El problema o diagnóstico ha empeorado tras un período de mejoría temporal.">
                        >
                        ["at0098"] = <
                            text = <"Nivel de control">
                            description = <"Categoría del nivel de control del problema o diagnóstico por parte del manejo actual.">
                        >
                        ["at0099"] = <
                            text = <"Controlado">
                            description = <"El problema o diagnóstico está controlado por el manejo actual.">
                        >
                        ["at0100"] = <
                            text = <"Indeterminado">
                            description = <"No es posible determinar si el problema o diagnóstico está controlado por el manejo actual.">
                        >
                        ["at0101"] = <
                            text = <"No controlado">
                            description = <"El problema o diagnóstico no está controlado por el manejo actual.">
                        >
                        ["at0102"] = <
                            text = <"Progresión">
                            description = <"Categoría de la progresión a lo largo de un problema o diagnóstico crónico.">
                        >
                        ["at0103"] = <
                            text = <"Mejorando">
                            description = <"El problema o diagnóstico está mejorando.">
                        >
                        ["at0104"] = <
                            text = <"Estable">
                            description = <"El problema o diagnóstico no ha cambiado.">
                        >
                        ["at0105"] = <
                            text = <"Empeoramiento">
                            description = <"El problema o diagnóstico está empeorando.">
                        >
                        ["at0106"] = <
                            text = <"Indeterminado">
                            description = <"No es posible determinar la progresión del problema o diagnóstico.">
                        >
                        ["at0107"] = <
                            text = <"Motivo del episodio en curso">
                            description = <"Motivo por el cual un problema o diagnóstico no se resuelve según lo previsto.">
                        >
                        ["at0108"] = <
                            text = <"Sí">
                        >
                        ["at0109"] = <
                            text = <"No">
                        >
                        ["at0110"] = <
                            text = <"Comentario">
                            description = <"Narrativa adicional sobre los valores del calificador Problema/Diagnóstico, no capturados en otros campos.">
                        >
                        ["at0111"] = <
                            text = <"*Disorder category (en)">
                            description = <"*A high‑level grouping of the problem or diagnosis. (en)">
                        >
                        ["ac0.1"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.2"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.3"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.4"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.5"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.6"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.7"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.8"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.9"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.10"] = <
