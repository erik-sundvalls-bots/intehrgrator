                    ["nb"] = <
                        ["at0000"] = <
                            text = <"Graviditetssammenfatning">
                            description = <"En oversikt eller oppsummering av en bekreftet graviditet og utfall, inkludert svangerskapsperioden, fødselen og den umiddelbare postpartum perioden.">
                        >
                        ["at0001"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
