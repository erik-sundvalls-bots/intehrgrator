                            text = <"*(Synthesized) (en)">
                        >
                    >
                    ["fa"] = <
                        ["at0000"] = <
                            text = <"قد و یا طول">
                            description = <"قد یا طول بدن از نوک سر تا کف پا اندازه گیری می شود.بلندی در حالت ایستاده و طول بدن فرد در حالت خوابیده اندازه گیری می شود ">
                        >
