                    ["ca"] = <
                        ["at0000"] = <
                            text = <"Resum de l'embaràs">
                            description = <"Resum o registre resum d'un embaràs i el seu resultat, inclòs el període prenatal, el treball de part, el part i el període postnatal immediat.">
                        >
                        ["at0001"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0007"] = <
                            text = <"*Number of fetuses (en)">
                            description = <"Nombre de fetus identificats a l'úter.">
                        >
                        ["at0008"] = <
                            text = <"Inici del treball de part">
                            description = <"Manera en què va començar el part.">
                        >
                        ["at0009"] = <
                            text = <"Espontani">
                            description = <"Començament sense intervenció.">
                        >
                        ["at0010"] = <
                            text = <"Induït">
                            description = <"Inici a través de la intervenció.">
                        >
                        ["at0016"] = <
                            text = <"Durada total del treball de part">
                            description = <"Durada total de les tres etapes del part.">
                        >
                        ["at0022"] = <
                            text = <"Mètode d'acceleració">
                            description = <"Mètode d'acceleració del treball de part.">
                        >
                        ["at0028"] = <
                            text = <"Per nadó">
                            description = <"Informació sobre un fetus únic o nadó.">
                        >
                        ["at0029"] = <
                            text = <"Data/hora del part">
                            description = <"Data i hora del part del nadó.">
                        >
                        ["at0036"] = <
                            text = <"Etiqueta/nom">
                            description = <"Identificació del nadó.">
                        >
                        ["at0037"] = <
                            text = <"Sexe assignat">
                            description = <"Sexe del nadó per observació directa dels genitals externs.">
                        >
                        ["at0038"] = <
                            text = <"Pes en néixer">
                            description = <"Pes del nadó al part.">
                        >
                        ["at0045"] = <
                            text = <"Presentació">
                            description = <"Presentació del nadó en el part.">
                        >
                        ["at0046"] = <
                            text = <"Cafàlica">
                            description = <"La part de presentació era el vèrtex cefàlic.">
                        >
                        ["at0047"] = <
                            text = <"Natges">
                            description = <"La part de presentació eren les natges.">
                        >
                        ["at0048"] = <
                            text = <"Cara">
                            description = <"La part de presentació era la cara.">
                        >
                        ["at0049"] = <
                            text = <"Cella">
                            description = <"La part de presentació era la cella.">
                        >
                        ["at0061"] = <
                            text = <"Complicació del nounat">
                            description = <"Detalls sobre qualsevol complicació que afecti el nounat.">
                        >
                        ["at0062"] = <
                            text = <"Complicació">
                            description = <"Identificació de la complicació després del part.">
                        >
                        ["at0063"] = <
                            text = <"Data/hora d'inici">
                            description = <"Data i/o hora d'inici de la complicació.">
                        >
                        ["at0064"] = <
                            text = <"Descripció">
                            description = <"Descripció narrativa de la complicació.">
                        >
                        ["at0065"] = <
                            text = <"Complicació materna">
                            description = <"Detalls sobre complicacions de l'embaràs o del part que afecten la mare.">
                        >
                        ["at0066"] = <
                            text = <"Complicació">
                            description = <"Identificació de la complicació.">
                        >
                        ["at0067"] = <
                            text = <"Data/hora d'inici">
                            description = <"Data d'inici de la complicació, avaluada per un metge.">
                        >
                        ["at0068"] = <
                            text = <"Descripció">
                            description = <"Descripció narrativa de la complicació materna.">
                        >
                        ["at0081"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0082"] = <
                            text = <"Última actualització">
                            description = <"La data/hora de l'última actualització del resum de l'embaràs.">
                        >
                        ["at0083"] = <
                            text = <"Sinopsi de l'embaràs">
                            description = <"Descripció narrativa sobre tot l'embaràs, treball de part i part, incloses les complicacions.">
                        >
                        ["at0094"] = <
                            text = <"Resultat de fases tempranes de l'embaràs">
                            description = <"Resultat de l'embaràs en el seu conjunt.">
                        >
                        ["at0096"] = <
                            text = <"Mètode d'inducció">
                            description = <"Mètode d'inducció del treball de part.">
                        >
                        ["at0097"] = <
                            text = <"Motiu de la inducció">
                            description = <"Motiu de la inducció del treball de part.">
                        >
                        ["at0104"] = <
                            text = <"Reproducció assistida?">
                            description = <"L'embaràs va ser fruit d'una tècnica de reproducció assistida?">
                        >
                        ["at0105"] = <
                            text = <"Tipus de reproducció assitida">
                            description = <"Tipus de tècnica de reproducció asistida utilitzada per a aconseguir aquest embaràs.">
                        >
                        ["at0106"] = <
                            text = <"Podàlica">
                            description = <"La part de presentació era un peu.">
                        >
                        ["at0107"] = <
                            text = <"Braç">
                            description = <"La part de presentació era un braç.">
                        >
                        ["at0109"] = <
                            text = <"Alimentació">
                            description = <"Descripció narrativa sobre l'alimentació del nadó.">
                        >
                        ["at0112"] = <
                            text = <"No treball de part">
                            description = <"No inici de treball de part.">
                        >
                        ["at0113"] = <
                            text = <"Masculí">
                            description = <"El nadó sembla físicament masculí.">
                        >
                        ["at0114"] = <
                            text = <"Femení">
                            description = <"El nadó sembla físicament femení.">
                        >
                        ["at0115"] = <
                            text = <"Indeterminat">
                            description = <"Encara no s'ha pogut determinar el sexe del nadó a partir de l'observació de les característiques físiques.">
                        >
                        ["at0118"] = <
                            text = <"Perineu">
                            description = <"Descripció codificada o narrativa sobre l'estat del perineu després del naixement, incloses les lesions i reparacions.">
                        >
                        ["at0119"] = <
                            text = <"Pèrdua de sang estimada">
                            description = <"Estimació de la pèrdua total de sang materna durant el part i postpart immediat.">
                        >
                        ["at0133"] = <
                            text = <"Espatlla">
                            description = <"La part de presentació era una espatlla.">
                        >
                        ["at0146"] = <
                            text = <"Etiqueta de l'embaràs">
                            description = <"*An informal identifier assigned to the pregnancy, used to distinguish it from other pregnancies. (en)">
                        >
                        ["at0149"] = <
                            text = <"Posició">
                            description = <"Posició del nadó durant el part.">
                        >
                        ["at0150"] = <
                            text = <"Occipital esquerre anterior/transvers">
                            description = <"L'esquena del nadó estava cap al costat esquerre de l'úter a l'inici del part.">
                        >
                        ["at0151"] = <
                            text = <"Occipital dret anterior/transvers">
                            description = <"L'esquena del nadó estava cap al costat dret de l'úter a l'inici del part.">
                        >
                        ["at0152"] = <
                            text = <"Desconegut">
                            description = <"No es coneix de quin costat es va col·locar l'esquena del nadó a l'inici del part.">
                        >
                        ["at0153"] = <
                            text = <"Esquinçament vaginal de primer grau">
                            description = <"Implica només la pell de l'obertura vaginal i el perineu.">
                        >
                        ["at0154"] = <
                            text = <"Esquinçament vaginal de segon grau">
                            description = <"Implica la pell i el múscul del perineu i es pot estendre profundament a la vagina.">
                        >
                        ["at0155"] = <
                            text = <"Esquinçament vaginal de tercer grau">
                            description = <"Esquinçament del teixit vaginal, la pell perineal i els músculs perineals que s'estén a l'esfínter anal.">
                        >
                        ["at0156"] = <
                            text = <"Esquinçament vaginal de quart grau">
                            description = <"S'estén a través de l'esfínter anal i cap a la membrana mucosa que recobreix el recte.">
                        >
                        ["at0157"] = <
                            text = <"Episiotomia">
                            description = <"Es va fer una episiotomia?">
                        >
                        ["at0158"] = <
                            text = <"Embaràs confirmat">
                            description = <"Confirmació de l'embaràs.">
                        >
                        ["at0159"] = <
                            text = <"Durada de l'embaràs">
                            description = <"La gestació quan s'ha acabat l'embaràs.">
                        >
                        ["at0160"] = <
                            text = <"Detall del naixement">
                            description = <"Un subconjunt d'informació persistent o resumida sobre l'embaràs i el naixement d'un nadó, seleccionada per a la utilitat d'ús tant als registres de salut materna com infantil.">
                        >
                        ["at0161"] = <
                            text = <"Detalls addicionals">
                            description = <"Detalls estructurats sobre informació addicional relacionada amb el resum de l'embaràs.">
