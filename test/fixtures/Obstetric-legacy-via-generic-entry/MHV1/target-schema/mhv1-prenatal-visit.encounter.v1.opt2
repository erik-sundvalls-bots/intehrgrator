                        ["at0004"] = <
                            text = <"Boarrangement">
                            description = <"Et enkelt ord eller uttrykk som beskriver om et individ vanligvis bor alene eller med andre.">
                        >
                        ["at0005"] = <
                            text = <"Husholdningstype">
