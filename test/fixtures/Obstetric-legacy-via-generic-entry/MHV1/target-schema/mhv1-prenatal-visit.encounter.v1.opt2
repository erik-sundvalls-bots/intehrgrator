                                                    ELEMENT[at0016.1] occurrences matches {0..0}
                                                    ELEMENT[at0023.1] occurrences matches {0..0}
                                                    ELEMENT[at0024.1] occurrences matches {0..0}
                                                    ELEMENT[at0025.1] occurrences matches {0..0}
                                                    ELEMENT[at0026.1] occurrences matches {0..0}
                                                    ELEMENT[at0027.1] occurrences matches {0..0}
                                                    ELEMENT[at0028.1] occurrences matches {0..0}
                                                    ELEMENT[at0029.1] occurrences matches {0..0}
                                                    ELEMENT[at0033.1] occurrences matches {0..0} matches {
                                                        value matches {
                                                            DV_COUNT matches {
                                                                magnitude matches {
                                                                    |0..12|
                                                                }
                                                            }
                                                        }
                                                    }
                                                    ELEMENT[at0034.1] occurrences matches {0..0}
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        protocol matches {
                            ITEM_TREE[at0035] matches {
                                items cardinality matches {0..*} matches {
                                    use_archetype CLUSTER[at0036.1, openEHR-EHR-CLUSTER.ovl-follow_up_-001.v0] occurrences matches {0..1} matches {
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0001] occurrences matches {0..1} matches {
                                                value matches {
                                                    DV_CODED_TEXT matches {
                                                        defining_code matches {
                                                            [at0002], [at0003], [at0004]
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0001.1] matches {
                                                value matches {
                                                    DV_CODED_TEXT matches {
                                                        defining_code matches {
                                                            [local_terms::0]
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

