                    ["it"] = <
                        ["at0000"] = <
                            text = <"Problema/Diagnosi">
                            description = <"Dettagli su una specifica condizione di salute, una lesione, una disabilità o un qualsiasi altro problema individuato su un individuo che abbia un impatto sul benessere fisico, mentale e/o sociale.">
                        >
                        ["at0001"] = <
                            text = <"structure">
                            description = <"@ internal @">
                        >
                        ["at0002"] = <
                            text = <"Nome del problema/diagnosi">
                            description = <"Nome/identificativo del problema o della diagnosi.">
                        >
                        ["at0003"] = <
                            text = <"Data/ora di riconoscimento clinico">
                            description = <"Data/ora, stimate o effettive, in cui la diagnosi o il problema sono stati riconosciuti da un operatore sanitario.">
                        >
                        ["at0005"] = <
                            text = <"Severità">
                            description = <"Una valutazione generale della severità del problema o della diagnosi.">
                        >
                        ["at0009"] = <
