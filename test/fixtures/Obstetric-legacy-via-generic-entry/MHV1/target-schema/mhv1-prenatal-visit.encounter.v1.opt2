                        ["at0002"] = <
                            text = <"Item tree">
                            description = <"@ internal @">
                        >
                        ["at0003"] = <
                            text = <"Description">
                            description = <"Narrative description about the living arrangements.">
                        >
                        ["at0004"] = <
