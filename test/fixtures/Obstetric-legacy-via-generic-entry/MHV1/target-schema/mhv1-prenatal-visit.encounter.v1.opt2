                    ["ca"] = <
                        ["at0000"] = <
                            text = <"Resum de l'embaràs">
                            description = <"Resum o registre resum d'un embaràs i el seu resultat, inclòs el període prenatal, el treball de part, el part i el període postnatal immediat.">
                        >
                        ["at0001"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0007"] = <
                            text = <"*Number of fetuses (en)">
                            description = <"Nombre de fetus identificats a l'úter.">
