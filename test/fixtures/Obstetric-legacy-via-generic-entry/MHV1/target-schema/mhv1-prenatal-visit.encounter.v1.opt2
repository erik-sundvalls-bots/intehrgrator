                        >
                        ["at0003"] = <
                            text = <"Beschreibung">
                            description = <"Beschreibung der Wohnsituation.">
                        >
                        ["at0004"] = <
                            text = <"Wohnsituation">
                            description = <"Einzelnes Word oder Satz, um zu beschreiben, ob eine Person für gewöhnlich allein oder mit anderen zusammen wohnt.">
                        >
                        ["at0005"] = <
                            text = <"Art des Haushaltes">
                            description = <"Einzelnes Wort oder eine Phrase, die die Zusammensetzung oder Struktur des Haushalts beschreibt.">
                        >
                        ["at0006"] = <
                            text = <"Beschreibung des Haushalts">
                            description = <"Beschreibung über Individuen, die zusammen wohnen und sich Mahlzeiten, wirtschaftliche Ressourcen und/oder Wohnraum teilen.">
                        >
                        ["at0007"] = <
                            text = <"Anzahl der Haushaltsmitglieder">
