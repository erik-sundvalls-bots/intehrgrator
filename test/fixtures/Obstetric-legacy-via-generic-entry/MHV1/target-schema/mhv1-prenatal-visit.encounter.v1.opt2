                    ["nl"] = <
                        ["at0077"] = <
                            text = <"Datum/tijd van aanvang">
                            description = <"Geschatte of precieze datum/tijd dat de eerste tekenen of symptomen van het probleem of de diagnose werden opgemerkt.">
