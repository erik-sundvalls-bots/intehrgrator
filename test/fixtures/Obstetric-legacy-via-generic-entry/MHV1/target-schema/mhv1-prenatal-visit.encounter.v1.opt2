                        >
                        ["at0004"] = <
                            text = <"Vikt">
                            description = <"Individens vikt.">
                        >
                        ["at0008"] = <
                            text = <"state structure">
                            description = <"@ internal @">
                        >
                        ["at0009"] = <
                            text = <"Klädsel">
                            description = <"Beskrivning av individens klädsel vid tidpunkten för vägning.">
                        >
                        ["at0010"] = <
                            text = <"Fullt påklädd, inklusive skor">
                            description = <"Kläder, inklusive skor, som kan öka vikten avsevärt.">
                        >
                        ["at0011"] = <
                            text = <"Lätt klädd/underkläder">
                            description = <"Kläder som inte ökar vikten avsevärt.">
                        >
                        ["at0013"] = <
                            text = <"Naken">
                            description = <"Inga kläder alls.">
                        >
                        ["at0015"] = <
                            text = <"protocol structure">
                            description = <"@ internal @">
                        >
                        ["at0017"] = <
                            text = <"Blöja">
                            description = <"Iklädd endast blöja, som kan öka vikten avsevärt.">
                        >
                        ["at0020"] = <
                            text = <"Utrustning">
                            description = <"Detaljer om den utrustning som används för att mäta vikten.">
                        >
                        ["at0024"] = <
                            text = <"Kommentar">
                            description = <"Kommentarer avseende mätningen av kroppsvikt, som inte beskrivs i övriga datafält.">
                        >
                        ["at0025"] = <
                            text = <"Möjliga felkällor">
                            description = <"Beskrivning av faktorer och felkällor som kan påverka mätningen av kroppsvikt, exempelvis tidpunkt i menstruationscykeln, tid sedan senaste tarmtömning eller amputation.">
                        >
                        ["at0026"] = <
                            text = <"Födelse">
                            description = <"Vanligtvis den första vägningen av barnet, strax efter födseln. Den här händelsen registreras endast en gång per patientjournal.">
                        >
                        ["at0027"] = <
                            text = <"Tilläggsinformation">
