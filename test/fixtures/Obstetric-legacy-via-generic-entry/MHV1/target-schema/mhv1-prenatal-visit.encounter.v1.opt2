                        >
                        ["ac0.2"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.9"] = <
                            text = <"*(Synthesized) (en)">
                        >
                    >
                    ["sv"] = <
                        ["at0000"] = <
                            text = <"Födelsedetaljer">
                            description = <"*A subset of persistent or summary information about the pregnancy and birth of an infant, selected for utility of use within both the maternal and infant health records. (en)">
                        >
                        ["at0001"] = <
                            text = <"Beskrivning">
                            description = <"*Narrative description of the newborn, including observed congenital abnormalities. (en)">
                        >
                        ["at0003"] = <
                            text = <"Födelseordning">
                            description = <"*The sequential order of the birth of the infant within a multiple birth pregnancy. (en)">
                        >
                        ["at0004"] = <
                            text = <"Graviditet">
                            description = <"*The length of the pregnancy at the time of delivery of the infant. (en)">
                        >
                        ["at0005"] = <
                            text = <"Förlossningssätt">
                            description = <"*Method by which the newborn was delivered. (en)">
                        >
                        ["at0006"] = <
                            text = <"Oassisterad">
                            description = <"Normal, icke-instrumentell vaginal förlossning">
                        >
                        ["at0007"] = <
                            text = <"Assisterad sätesförlossning">
                            description = <"Vaginal förlossning assisterad med handgrepp vid förlossning av återstoden av kroppen, armarna och huvudet.">
                        >
                        ["at0008"] = <
                            text = <"Total sätesextraktion">
                            description = <"Vaginal förlossning, genom vilken fostrets fötter fattas, och hela fostret extraheras.">
                        >
                        ["at0009"] = <
                            text = <"Vakuumextraktion">
                            description = <"Vaginal förlossning assisterad med användning av vakuumextraktion.">
                        >
                        ["at0010"] = <
                            text = <"Vakuumextraktion med rotation">
                            description = <"Vaginal förlossning assisterad med användning av vakuumextraktion.">
                        >
                        ["at0011"] = <
                            text = <"Lyfttång">
                            description = <"Vaginal förlossning assisterad med användning av lyfttång.">
                        >
                        ["at0012"] = <
                            text = <"Låg tång">
                            description = <"Vaginal förlossning assisterad med användning av låg tång.">
                        >
                        ["at0013"] = <
                            text = <"Hög tång">
                            description = <"Vaginal förlossning assisterad med användning av hög tång.">
                        >
                        ["at0014"] = <
                            text = <"Hög tång med rotation">
                            description = <"Vaginal förlossning assisterad med användning av hög tång med rotation.">
                        >
                        ["at0015"] = <
                            text = <"Kejsarsnitt – nedre uterinsegmentet">
                            description = <"Kirurgisk förlossning genom ett tvärgående snitt i det nedre uterinsegmentet">
                        >
                        ["at0016"] = <
                            text = <"Kejsarsnitt – övre uterinsegmentet">
                            description = <"Kirurgisk förlossning genom ett snitt i det övre uterinsegmentet.">
                        >
                        ["at0018"] = <
                            text = <"Graviditetsmognad">
                            description = <"*The estimated gestational maturity of the newborn at, or very near, birth. (en)">
                        >
                        ["at0019"] = <
                            text = <"Förlossningens brådskandegrad">
                            description = <"*The level of urgency identified at or around the time of delivery. (en)">
                        >
                        ["at0020"] = <
                            text = <"Rutin / elektiv">
                            description = <"Förlossningen, igångsättningen eller kejsarsnittet krävde ingen oväntad eller brådskande intervention.">
                        >
                        ["at0022"] = <
                            text = <"Akut">
                            description = <"Erkännande av en hög risksituation krävde att förlossningen påskyndades som en akut åtgärd.">
                        >
                        ["at0021"] = <
                            text = <"Brådskande">
                            description = <"Erkännande av en ökande risksituation krävde att förlossningen påskyndades.">
                        >
