                            text = <"*Second degree vaginal tear (en)">
                            description = <"*Involve the skin and muscle of the perineum and might extend deep into the vagina. (en)">
                        >
                        ["at0155"] = <
                            text = <"*Third degree vaginal tear (en)">
                            description = <"*Tear in the vaginal tissue, perineal skin, and perineal muscles that extends into the anal sphincter. (en)">
                        >
                        ["at0156"] = <
                            text = <"*Fourth degree vaginal tear (en)">
                            description = <"*Extend through the anal sphincter and into the mucous membrane that lines the rectum. (en)">
                        >
