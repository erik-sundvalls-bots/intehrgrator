                            text = <"Doseringsbeskrivning">
                            description = <"Textbeskrvining av dosen.">
                        >
                    >
                    ["es"] = <
                        ["at0000"] = <
                            text = <"Dosificación">
                            description = <"Combinación de una cantidad de medicación y el momento de administración para un mismo día, como parte de una prescripción o gestión de medicación.">
                        >
                        ["at0037"] = <
                            text = <"Pauta horaria">
