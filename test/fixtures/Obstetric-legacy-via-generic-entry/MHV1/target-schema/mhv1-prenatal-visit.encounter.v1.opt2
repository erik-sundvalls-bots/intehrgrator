                        >
                        ["at0046"] = <
                            text = <"Stato">
                            description = <"Dettagli strutturati per descrivere aspetti del processo diagnostico specifici in relazione alla localizzazione, dominio, episodio o workflow.">
                        >
                        ["at0047"] = <
                            text = <"Lieve">
                            description = <"Il problema o la diagnosi non interferiscono con la normale attività o potrebbero causare problemi di salute salute se non trattati.">
                        >
                        ["at0048"] = <
