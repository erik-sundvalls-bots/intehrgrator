                        ["at0014"] = <
                            text = <"Typiskt mönster">
                            description = <"Den vanliga förutsägbarheten för menstruation under episoden.">
                        >
                        ["at0015"] = <
                            text = <"Regelbunden">
                            description = <"Början på menstruation är ungefär förutsägbar från månad till månad.">
                        >
                        ["at0016"] = <
                            text = <"Oregelbunden">
                            description = <"Början av menstruation är inte förutsägbar månad till månad.">
                        >
                        ["at0017"] = <
                            text = <"Typisk cykellängd">
                            description = <"Den vanliga cykellängden under episoden.">
                        >
                        ["at0018"] = <
                            text = <"Typisk menstruationsvaraktighet">
                            description = <"Den vanliga varaktigheten för menstruation under episoden.">
                        >
                        ["at0020"] = <
                            text = <"Ytterligare detaljer">
                            description = <"Ytterligare strukturerade detaljer om episoden av menstruation.">
                        >
                        ["at0021"] = <
                            text = <"Episodens slutdatum">
                            description = <"Datum när episoden upphörde.">
                        >
                        ["at0022"] = <
                            text = <"Episod kommentar">
                            description = <"Ytterligare beskrivning om menstruationsepisoden som inte redan inkluderats.">
                        >
                        ["at0023"] = <
                            text = <"Kommentar">
                            description = <"Ytterligare beskrivning om de övergripande mönster och menstruationsepisoder som inte redan inkluderats.">
                        >
                        ["at0024"] = <
                            text = <"Datum senast uppdaterad">
                            description = <"Datum då menstruationsöversikten, inklusive episoden, uppdaterades.">
                        >
                        ["at0025"] = <
                            text = <"Övergripande beskrivning">
                            description = <"Berättande beskrivning av det övergripande menstruationsmönstret.">
                        >
                        ["at0026"] = <
                            text = <"Premenarkal">
                            description = <"Innan menstruationen börjar.">
                        >
                        ["ac0.1"] = <
