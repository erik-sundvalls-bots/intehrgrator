{
  "kind": "intehrgrator-function",
  "version": 1,
  "name": "coded_text_from_sheet",
  "description": "Looks up the first exact key match in a project Sheet. Parameters: sheet_name, key_column, key, value_column, code_column, primary_terminology, mapping_columns. Column references are header names; mapping_columns is a map of terminology ID to code-column header (e.g. SNOMED-CT → snomed). Returns a complete DV_CODED_TEXT with the primary value/code/terminology and one equivalent TERM_MAPPING (match =) for each nonblank mapping cell. Missing key, text, code or primary terminology returns null; no codes are guessed. Keep codes as text to preserve leading zeroes/decimals. Sheets stay project data and are not bundled.",
  "parameters": [
    "sheet_name",
    "key_column",
    "key",
    "value_column",
    "code_column",
    "primary_terminology",
    "mapping_columns"
