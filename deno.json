{
  "name": "@regionstockholm/intehrgrator",
  "version": "0.10.0",
  "exports": "./src/mod.ts",
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns", "deno.unstable"],
    "strict": true
  },
  "imports": {
    "@intehrgrator/": "./src/",
    "@std/assert": "jsr:@std/assert@1",
    "@std/fs": "jsr:@std/fs@1",
    "@std/http": "jsr:@std/http@1",
    "@std/path": "jsr:@std/path@1",
    "@std/testing": "jsr:@std/testing@1",
    "@codemirror/commands": "npm:@codemirror/commands@^6.8.1",
    "@codemirror/lang-javascript": "npm:@codemirror/lang-javascript@^6.2.4",
    "@codemirror/lang-json": "npm:@codemirror/lang-json@^6.0.2",
    "@codemirror/lang-xml": "npm:@codemirror/lang-xml@^6.1.0",
    "@codemirror/lang-html": "npm:@codemirror/lang-html@^6.4.9",
    "@codemirror/language": "npm:@codemirror/language@^6.11.3",
    "@codemirror/lint": "npm:@codemirror/lint@^6.8.4",
    "@codemirror/search": "npm:@codemirror/search@^6.5.11",
    "@codemirror/state": "npm:@codemirror/state@^6.5.2",
    "@codemirror/view": "npm:@codemirror/view@^6.38.0",
    "@lezer/highlight": "npm:@lezer/highlight@^1.2.1",
    "@floating-ui/dom": "npm:@floating-ui/dom@^1.7.4",
    "@shoelace-style/shoelace": "npm:@shoelace-style/shoelace@2.20.1",
    "blockly": "npm:blockly@^11.2.2",
    "blockly/core": "npm:blockly@^11.2.2/core",
    "blockly/blocks": "npm:blockly@^11.2.2/blocks",
    "blockly/javascript": "npm:blockly@^11.2.2/javascript",
    "blockly/msg/en": "npm:blockly@^11.2.2/msg/en",
    "blockly/msg/sv": "npm:blockly@^11.2.2/msg/sv",
    "blockly/msg/de": "npm:blockly@^11.2.2/msg/de",
    "blockly/msg/es": "npm:blockly@^11.2.2/msg/es",
    "blockly/msg/ca": "npm:blockly@^11.2.2/msg/ca",
    "blockly/msg/fr": "npm:blockly@^11.2.2/msg/fr",
    "@blockly/workspace-minimap": "npm:@blockly/workspace-minimap@0.2.16",
    "@blockly/toolbox-search": "npm:@blockly/toolbox-search@2.0.16",
    "fflate": "npm:fflate@^0.8.2",
    "fast-xml-parser": "npm:fast-xml-parser@^4.5.6",
    "handlebars": "npm:handlebars@^4.7.9",
    "jspreadsheet-ce": "npm:jspreadsheet-ce@5.0.4",
    "jsuites": "npm:jsuites@5.13.4",
    "yaml": "npm:yaml@^2.9.0",
    "fontoxpath": "npm:fontoxpath@^3.33.2/dist/fontoxpath.esm.js",
    "slimdom": "npm:slimdom@^4.3.5",
    "@cfworker/json-schema": "npm:@cfworker/json-schema@^4.1.1",
    "ehrtslib/": "https://cdn.jsdelivr.net/gh/ErikSundvall/ehrtslib@f6d211ebd89ae0aa5110ac88a289a4d05ea7d854/"
  },
  "scopes": {
    "https://cdn.jsdelivr.net/gh/ErikSundvall/ehrtslib@f6d211ebd89ae0aa5110ac88a289a4d05ea7d854/": {
      "https://cdn.jsdelivr.net/gh/ErikSundvall/ehrtslib@f6d211ebd89ae0aa5110ac88a289a4d05ea7d854/validation/template_validator.ts": "./vendor/ehrtslib-overrides/validation/template_validator.ts"
    }
  },
  "tasks": {
    "vendor": "deno run -A scripts/vendor-ehrtslib.ts",
    "convert:kintegrate-hbs": "deno run -A scripts/convert-kintegrate-hbs-to-blockly.ts",
    "test": "deno test -A --no-check --parallel --ignore=test/ui test/",
    "test:xquery-engine": "deno test -A --no-check test/xquery_engine_test.ts",
    "test:ui": "deno run -A scripts/ui-test.ts",
    "test:all": "deno task test && deno task test:ui",
    "wasm:go-template": "deno run -A scripts/build-go-template-wasm.ts",
    "lint": "deno lint src test scripts",
    "check": "deno check src/**/*.ts web/main.ts web/better_form_viewer.ts scripts/*.ts",
    "build": "deno run -A scripts/build.ts && deno run -A scripts/stage-desktop-www.ts",
    "dev": "deno run -A scripts/dev-server.ts",
    "desktop": "deno task build && deno desktop -A --no-check --config deno.json --backend webview --hmr src/desktop/main.ts",
    "compile:desktop": "deno run -A scripts/compile-desktop.ts",
    "compile:ehrtslib": "deno run -A scripts/compile-ehrtslib.ts",
    "release": "deno run -A scripts/release.ts",
    "release:no-test": "deno run -A scripts/release.ts --no-test",
    "measure:context": "deno run -A --no-check scripts/measure_slot_context.ts",
    "mcp": "deno run -A src/agent/mcp_stdio.ts",
    "generate:function-library": "deno run -A --no-check scripts/generate-function-library.ts"
  },
  "lint": {
    "include": ["src", "test", "scripts", "web"],
    "rules": {
      "exclude": ["no-sloppy-imports"]
    }
  },
  "exclude": ["vendor", "dist", "docs/demo"],
  "desktop": {
    "app": {
      "name": "intEHRgrator",
      "identifier": "se.regionstockholm.intehrgrator"
    },
    "backend": "webview"
  }
}
