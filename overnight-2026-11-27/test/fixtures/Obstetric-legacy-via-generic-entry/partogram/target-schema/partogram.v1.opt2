                    ["sv"] = <
                        ["at0000"] = <
                            text = <"Blodtryck">
                            description = <"Den lokala mätningen av artärblodtrycket som är ett substitut för artärtryck i den systemiska cirkulationen.">
                        >
                        ["at0001"] = <
                            text = <"Anamnes">
                            description = <"Strukturerad anamnes.">
                        >
                        ["at0003"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0004"] = <
                            text = <"Systoliskt">
                            description = <"Det högsta värdet på systemartärtrycket under systole, det vill säga under sammandragningsfasen av hjärtcykeln.">
                        >
                        ["at0005"] = <
                            text = <"Diastoliskt">
                            description = <"Det minsta värdet på systemartärtrycket under diastole, det vill säga under avslappningsfasen av hjärtcykeln.">
                        >
                        ["at0006"] = <
                            text = <"Ospecificerad händelse">
                            description = <"Ospecificerad standardhändelse vid en tidpunkt eller inom ett tidsintervall som explicit kan definieras i en template eller genereras automatiskt av vissa IT-system.">
                        >
                        ["at0007"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0008"] = <
                            text = <"Ställning">
