                    ["zh-cn"] = <
                        ["at0000"] = <
                            text = <"脉搏/心跳">
                            description = <"脉搏或心跳的速率以及相关的特征属性/特性/属性。">
                        >
                        ["at0001"] = <
                            text = <"structure">
                            description = <"@ internal @">
                        >
                        ["at0002"] = <
                            text = <"history">
                            description = <"@ internal @">
                        >
                        ["at0003"] = <
                            text = <"任何事件">
                            description = <"可在模板之中或运行时明确定义的默认的、未明确指定的时间点型/时间型或时间区间型/时间间隔型事件。">
                        >
                        ["at0004"] = <
                            text = <"速率">
                            description = <"脉搏或心跳的速率，且以每分钟脉搏搏动或心脏跳动的次数为单位。完整的名称分别为脉搏[速]率或心率">
                        >
                        ["at0005"] = <
                            text = <"规律性">
                            description = <"脉搏或心跳的规律性。">
                        >
                        ["at0006"] = <
                            text = <"规律">
                            description = <"脉搏或心跳的变化模式规律齐整。">
                        >
                        ["at0007"] = <
                            text = <"规律性不齐">
                            description = <"模式属于是规律齐整的不齐/不规则。例如，每 'n' 次心跳会出现一次心跳脱漏（dropped beat）。">
                        >
                        ["at0008"] = <
                            text = <"不规律性不齐">
                            description = <"模式不规则，混乱/杂乱且不可预测。例如，心房颤动（房颤）。">
                        >
                        ["at0010"] = <
                            text = <"List">
                            description = <"@ internal @">
                        >
                        ["at0012"] = <
                            text = <"List">
                            description = <"@ internal @">
                        >
                        ["at0013"] = <
                            text = <"体位">
                            description = <"观察期间服务/记录对象（患者）的体位/身体姿势。">
                        >
                        ["at1000"] = <
                            text = <"平卧位">
                            description = <"服务/记录对象（患者）当时的体位为平卧/平躺。">
                        >
                        ["at1001"] = <
                            text = <"坐位">
                            description = <"服务/记录对象（患者）当时的体位为坐位/坐姿（如坐着床上或椅子上）。">
                        >
                        ["at1002"] = <
                            text = <"倾斜位">
                            description = <"服务/记录对象（患者）当时的体位是角度大约 45 度的身体倾斜，且双腿抬高至骨盆水平。">
                        >
                        ["at1003"] = <
                            text = <"站立位/直立位">
                            description = <"服务/记录对象（患者）当时的体位为站立、行走或跑步。">
                        >
                        ["at1005"] = <
                            text = <"存在情况">
                            description = <"脉搏或心跳的存在情况或者说存在与否。">
                        >
                        ["at1013"] = <
                            text = <"设备">
                            description = <"关于用来测量脉搏率或心率的设备/装置的详细信息。">
                        >
                        ["at1017"] = <
                            text = <"体力消耗">
                            description = <"关于检查期间所进行的体力消耗/用力[动作]的详细信息。">
                        >
                        ["at1018"] = <
                            text = <"干扰因素">
                            description = <"关于任何可能影响体格检查所见/结果解释的偶然因素的叙述性描述。又可称为“混杂因素”。">
                        >
                        ["at1019"] = <
                            text = <"方法">
                            description = <"用于观察/测量/检测脉搏或心跳的方法。">
                        >
                        ["at1022"] = <
                            text = <"临床描述">
                            description = <"关于脉搏或心跳的叙述性描述。">
                        >
                        ["at1023"] = <
                            text = <"临床解释">
                            description = <"用来表示脉搏或心跳结果（包括心律/节律）的临床含义和意义的单个单词、短语或简要描述。">
                        >
                        ["at1024"] = <
                            text = <"存在">
                            description = <"可以检测到脉搏或心跳。">
                        >
                        ["at1025"] = <
                            text = <"未检测到">
                            description = <"无法检测到脉搏或心跳。">
                        >
                        ["at1028"] = <
                            text = <"不规律">
                            description = <"脉搏或心跳的变化模式不规律/不齐整。">
                        >
                        ["at1030"] = <
                            text = <"特征">
                            description = <"关于脉搏或心跳特征/特点的描述。">
                        >
                        ["at1032"] = <
                            text = <"触诊">
                            description = <"观察者通过触摸服务/记录对象（患者）的身体来获得检查所见/观察结果。">
                        >
                        ["at1033"] = <
                            text = <"听诊">
                            description = <"在借助于听诊器等设备/装置的情况下来获得检查所见/观察结果。">
                        >
                        ["at1034"] = <
                            text = <"自动无创式">
                            description = <"利用脉搏血氧仪或听诊器等设备/装置进行无创式/非侵入式的观察所获得的所见/发现/结果。">
                        >
                        ["at1036"] = <
                            text = <"最大值">
                            description = <"关于特定的体力消耗/用力[动作]期间所观察到的最大脉搏[速]率或心率。">
                        >
                        ["at1037"] = <
                            text = <"身体部位">
                            description = <"观察脉搏或心跳时所采用的身体部位。">
                        >
                        ["at1038"] = <
                            text = <"桡动脉 - 左侧">
                            description = <"左侧桡动脉。">
                        >
                        ["at1039"] = <
                            text = <"桡动脉 - 右侧">
                            description = <"右侧桡动脉。">
                        >
                        ["at1040"] = <
                            text = <"心脏">
                            description = <"心脏区域。">
                        >
                        ["at1041"] = <
                            text = <"颈动脉 - 左侧">
                            description = <"左侧颈动脉。">
                        >
                        ["at1042"] = <
                            text = <"颈动脉 - 右侧">
                            description = <"右侧颈动脉。">
                        >
                        ["at1043"] = <
                            text = <"股动脉 - 左侧">
                            description = <"左侧股动脉。">
                        >
                        ["at1044"] = <
                            text = <"股动脉 - 右侧">
                            description = <"右侧股动脉。">
                        >
                        ["at1047"] = <
                            text = <"手指">
                            description = <"未明确说明的手指。">
                        >
                        ["at1048"] = <
                            text = <"肱动脉 - 左侧">
                            description = <"左侧肱动脉。">
                        >
                        ["at1049"] = <
                            text = <"肱动脉 - 右侧">
                            description = <"右侧肱动脉。">
                        >
                        ["at1050"] = <
                            text = <"自动有创式">
                            description = <"利用动脉导管等设备/装置进行有创式/侵入式的观察所获得的所见/发现/结果。">
                        >
                        ["at1051"] = <
                            text = <"耳垂">
                            description = <"未明确说明的耳朵的耳垂。">
                        >
                        ["at1054"] = <
                            text = <"脚趾">
                            description = <"未明确说明的脚趾。">
                        >
                        ["at1055"] = <
                            text = <"不齐类型">
                            description = <"不规则的脉搏或心跳的更为具体的模式。">
                        >
                        ["at1056"] = <
                            text = <"扩展">
                            description = <"采集本地内容或与其他参考模型/形式保持一致时所需的其他信息。">
                        >
                        ["at1057"] = <
                            text = <"临床解释">
                            description = <"通用标签，旨在用于记录任何或所有关于脉搏或心跳的陈述。">
                        >
                        ["at1058"] = <
                            text = <"节律">
                            description = <"关于脉搏或心跳节律的具体结论，而其依据则是相应的心率、模式以及检查时所观察到的其他特征的组合。">
                        >
