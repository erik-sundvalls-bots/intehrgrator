                                                                        [units, magnitude, precision] matches {
                                                                            [{"cm"}, {|-5.0..5.0|}, {|0|}]
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                            ELEMENT[at0038] occurrences matches {0..1} matches {
                                                                value matches {
                                                                    DV_CODED_TEXT matches {
                                                                        defining_code matches {
                                                                            [at0039], [at0040], [at0041]
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                            ELEMENT[at0042] occurrences matches {0..1} matches {
                                                                value matches {
                                                                    DV_TEXT
                                                                }
                                                            }
                                                            ELEMENT[at0043] occurrences matches {0..1} matches {
                                                                value matches {
                                                                    DV_TEXT
                                                                }
                                                            }
                                                            ELEMENT[at0044] occurrences matches {0..1} matches {
                                                                value matches {
                                                                    DV_TEXT
                                                                }
                                                            }
                                                            ELEMENT[at0009.1] occurrences matches {0..0} matches {
                                                                value matches {
                                                                    DV_CODED_TEXT matches {
                                                                        defining_code matches {
                                                                            [ac0.1]
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                            ELEMENT[at0012.1] occurrences matches {0..0} matches {
                                                                value matches {
                                                                    DV_CODED_TEXT matches {
                                                                        defining_code matches {
                                                                            [ac0.2]
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                            ELEMENT[at0038.1] occurrences matches {0..0} matches {
                                                                value matches {
                                                                    DV_CODED_TEXT matches {
                                                                        defining_code matches {
                                                                            [ac0.3]
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                            ELEMENT[at0042.1] occurrences matches {0..0}
                                                            ELEMENT[at0043.1] occurrences matches {0..0}
                                                            ELEMENT[at0044.1] occurrences matches {0..0}
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        state matches {
                                            ITEM_TREE[at0009] matches {
                                                items cardinality matches {0..*; unordered} matches {
                                                    ELEMENT[at0008] occurrences matches {0..*} matches {
                                                        value matches {
                                                            DV_TEXT
                                                        }
                                                    }
                                                    ELEMENT[at0013] occurrences matches {0..1} matches {
                                                        value matches {
                                                            DV_TEXT
                                                        }
                                                    }
                                                    ELEMENT[at0008.1] occurrences matches {0..0}
                                                    ELEMENT[at0013.1] occurrences matches {0..0}
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        protocol matches {
                            ITEM_TREE[at0007] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    allow_archetype CLUSTER[at0010] occurrences matches {0..*} matches {
                                        include
                                            archetype_id/value matches {/openEHR-EHR-CLUSTER\.device(-[a-zA-Z0-9_]+)*\.v1/}
                                    }
                                    allow_archetype CLUSTER[at0012] occurrences matches {0..*} matches {
                                        include
                                            archetype_id/value matches {/.*/}
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

