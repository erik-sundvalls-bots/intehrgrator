                    ["es"] = <
                        ["at0000"] = <
                            text = <"Presión arterial">
                            description = <"La medición local de la presión arterial, que es un sustituto de la presión arterial en la circulación sistémica.">
                        >
                        ["at0001"] = <
                            text = <"Historia">
                            description = <"Nodo estructural de historia.">
                        >
                        ["at0003"] = <
                            text = <"blood pressure">
                            description = <"@ internal @">
                        >
                        ["at0004"] = <
                            text = <"Sistólica">
                            description = <"Presión arterial sistémica máxima - medida en la fase sistólica o de contracción del ciclo cardíaco.">
                        >
                        ["at0005"] = <
                            text = <"Diastólica">
                            description = <"Presión arterial sistémica mínima - medida en la fase diastólica o de relajación del ciclo cardíaco.">
                        >
                        ["at0006"] = <
                            text = <"Cualquier evento">
                            description = <"Evento predeterminado, sin especificar en el tiempo o intervalo, que puede definirse explícitamente en una plantilla o en tiempo de ejecución.">
                        >
                        ["at0007"] = <
                            text = <"state structure">
                            description = <"@ internal @">
                        >
                        ["at0008"] = <
                            text = <"Posición">
                            description = <"La posición del individuo en el momento de la medición.">
                        >
                        ["at0011"] = <
                            text = <"Árbol">
                            description = <"Estructura de la lista.">
                        >
                        ["at0013"] = <
                            text = <"Tamaño del manguito">
                            description = <"El tamaño del manguito utilizado para medir la presión arterial.">
                        >
                        ["at0014"] = <
                            text = <"Localización de la medición">
                            description = <"Zona del cuerpo donde se midió la presión arterial.">
                        >
                        ["at0015"] = <
                            text = <"Muslo Adulto">
                            description = <"Un manguito utilizado para el muslo de un adulto.">
                        >
                        ["at0016"] = <
                            text = <"Adulto Grande">
                            description = <"Un manguito para adultos con brazos más grandes.">
                        >
                        ["at0017"] = <
                            text = <"Adulto">
                            description = <"Un manguito estándar para adultos.">
                        >
                        ["at0025"] = <
                            text = <"Brazo derecho">
                            description = <"El brazo derecho de la persona.">
                        >
                        ["at0026"] = <
                            text = <"Brazo izquierdo">
                            description = <"El brazo izquierdo de la persona.">
                        >
                        ["at0027"] = <
                            text = <"Muslo derecho">
                            description = <"El muslo derecho de la persona.">
                        >
                        ["at0028"] = <
                            text = <"Muslo izquierdo">
                            description = <"Muslo izquierdo del paciente">
                        >
                        ["at0033"] = <
                            text = <"Comentario">
                            description = <"Información adicional sobre la medición que no se recoge en otros campos.">
                        >
                        ["at1000"] = <
                            text = <"De pie">
                            description = <"De pie en el momento de la medición de la presión arterial.">
                        >
                        ["at1001"] = <
                            text = <"Sentado">
                            description = <"Sentado (por ejemplo, en la cama o en una silla) en el momento de la medición de la presión arterial.">
                        >
                        ["at1002"] = <
                            text = <"Reclinado">
                            description = <"Reclinado en el momento de la medición de la presión arterial.">
                        >
                        ["at1003"] = <
                            text = <"Acostado">
                            description = <"Acostado en el momento de la medición de la presión arterial.">
                        >
                        ["at1005"] = <
                            text = <"Inclinación">
                            description = <"La inclinación craneocaudal de la superficie sobre la que se encuentra la persona en el momento de la medición.">
                        >
                        ["at1006"] = <
                            text = <"Presión arterial media">
                            description = <"La presión arterial media que se produce a lo largo de todo el ciclo de contracción y relajación del corazón.">
                        >
                        ["at1007"] = <
                            text = <"Presión del pulso">
                            description = <"La diferencia entre la presión sistólica y la presión diastólica.">
                        >
                        ["at1008"] = <
                            text = <"Adulto Pequeño">
                            description = <"Un manguito utilizado para adultos de complexión pequeña.">
                        >
                        ["at1009"] = <
                            text = <"Pediátrico/Niños">
                            description = <"Un manguito adecuado para niños o adultos con brazos delgados.">
                        >
                        ["at1010"] = <
                            text = <"Punto final diastólico">
                            description = <"Registre qué sonido de Korotkoff se utiliza para determinar la presión diastólica mediante el método auscultativo.">
                        >
                        ["at1011"] = <
                            text = <"Fase IV">
                            description = <"El cuarto sonido de Korotkoff se identifica como un abrupto amortiguamiento de los sonidos.">
                        >
                        ["at1012"] = <
                            text = <"Fase V">
                            description = <"El quinto sonido de Korotkoff se identifica por la ausencia de sonidos cuando la presión del manguito desciende por debajo de la presión arterial diastólica.">
                        >
                        ["at1014"] = <
                            text = <"Tumbado con inclinación hacia la izquierda">
                            description = <"Acostada boca arriba con cierta inclinación lateral, normalmente hacia el lado izquierdo. Se suele requerir en el último trimestre del embarazo para aliviar la compresión aortocava.">
                        >
                        ["at1018"] = <
                            text = <"Bebé">
                            description = <"Un manguito utilizado para bebés.">
                        >
                        ["at1019"] = <
                            text = <"Neonatal">
                            description = <"Un manguito utilizado para un recién nacido, suponiendo que el manguito sea del tamaño adecuado para la madurez y el peso al nacer del recién nacido.">
                        >
                        ["at1020"] = <
                            text = <"Muñeca derecha">
                            description = <"La muñeca derecha de la persona.">
                        >
                        ["at1021"] = <
                            text = <"Muñeca izquierda">
                            description = <"La muñeca izquierda de la persona.">
                        >
                        ["at1025"] = <
                            text = <"Dispositivo">
                            description = <"Detalles sobre el esfigmomanómetro u otro dispositivo utilizado para medir la presión arterial.">
                        >
                        ["at1026"] = <
                            text = <"Tobillo derecho">
                            description = <"El tobillo derecho de la persona.">
                        >
                        ["at1030"] = <
                            text = <"Esfuerzo">
                            description = <"Detalles sobre la actividad física realizada en el momento de la medición de la presión arterial.">
                        >
                        ["at1031"] = <
                            text = <"Tobillo izquierdo">
                            description = <"El tobillo izquierdo de la persona.">
                        >
                        ["at1032"] = <
                            text = <"Dedo de la mano">
                            description = <"Un dedo de la mano de la persona.">
                        >
                        ["at1035"] = <
                            text = <"Método">
                            description = <"Método de medición de la presión arterial.">
                        >
                        ["at1036"] = <
                            text = <"Auscultación">
                            description = <"Método para medir la presión arterial de forma externa, utilizando un estetoscopio y los sonidos de Korotkoff.">
                        >
                        ["at1037"] = <
                            text = <"Palpación">
                            description = <"Método para medir la presión arterial de forma externa, mediante palpación (normalmente de las arterias braquial o radial).">
                        >
                        ["at1038"] = <
                            text = <"Fórmula de la presión arterial media">
                            description = <"Fórmula utilizada para calcular la presión arterial media (si se registra en los datos).">
                        >
                        ["at1039"] = <
                            text = <"Aparato">
                            description = <"Método para medir la presión arterial de forma externa, utilizando un tensiómetro.">
                        >
                        ["at1040"] = <
                            text = <"Invasivo">
                            description = <"Método para medir la presión arterial internamente, es decir, mediante la penetración de la piel y la medición dentro de los vasos sanguíneos.">
                        >
                        ["at1042"] = <
                            text = <"Promedio de 24 horas">
                            description = <"Estimación de la presión arterial media durante un periodo de 24 horas.">
                        >
                        ["at1043"] = <
                            text = <"Estado del sueño">
                            description = <"Estado del sueño - permite interpretar los registros de presión arterial ambulatoria de 24 horas.">
                        >
                        ["at1044"] = <
                            text = <"Despierto">
                            description = <"El individuo está plenamente consciente.">
                        >
                        ["at1045"] = <
                            text = <"Durmiendo">
                            description = <"El individuo se encuentra en un estado natural de reposo corporal.">
                        >
                        ["at1051"] = <
                            text = <"Dedo del pie">
                            description = <"Un dedo del pie de la persona.">
                        >
                        ["at1052"] = <
                            text = <"Factores de confusión">
                            description = <"Comente y registre otros factores incidentales que puedan estar contribuyendo a la medición de la presión arterial. Por ejemplo, el nivel de ansiedad o el «síndrome de la bata blanca», dolor o fiebre, cambios en la presión atmosférica, etc.">
                        >
                        ["at1053"] = <
                            text = <"Intraarterial">
                            description = <"Medición invasiva mediante una línea de acceso al transductor dentro de una arteria.">
                        >
                        ["at1054"] = <
                            text = <"Fórmula de la presión sistólica">
                            description = <"Fórmula utilizada para calcular la presión sistólica a partir de la presión arterial media (si se registra en los datos).">
                        >
                        ["at1055"] = <
                            text = <"Fórmula de la presión diastólica">
                            description = <"Fórmula utilizada para calcular la presión diastólica a partir de la presión arterial media (si se registra en los datos).">
                        >
                        ["at1056"] = <
                            text = <"Dorso del pie">
                            description = <"El dorso del pie de la persona.">
                        >
                        ["at1057"] = <
                            text = <"Lugar de medición estructurado">
                            description = <"Localización anatómica estructurada del lugar donde se tomó la medida.">
                        >
                        ["at1058"] = <
                            text = <"Extensión">
                            description = <"Información adicional necesaria para captar el contexto local o para alinearse con otros modelos de referencia/formalismos.">
                        >
                        ["at1059"] = <
                            text = <"Interpretación clínica">
                            description = <"Palabra, frase o breve descripción que representa el significado clínico y la importancia de la medición de la presión arterial.">
                        >
                        ["ac0.1"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.2"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.3"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.4"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.5"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.6"] = <
                            text = <"*(Synthesized) (en)">
                        >
                    >
                    ["nb"] = <
                        ["at0000"] = <
                            text = <"Blodtrykk">
                            description = <"Måling av blodtrykket som uttrykk for det arterielle blodtrykk i det systemiske kretsløp.">
                        >
                        ["at0001"] = <
                            text = <"Historikk">
                            description = <"History Structural node.">
                        >
                        ["at0003"] = <
                            text = <"*blood pressure(en)">
                            description = <"*@ internal @(en)">
                        >
                        ["at0004"] = <
                            text = <"Systolisk">
                            description = <"Maksimalt systemisk arterielt blodtrykk - målt i systolen, det vil si i hjertets kontraksjonsfase.">
                        >
                        ["at0005"] = <
                            text = <"Diastolisk">
                            description = <"Laveste systemiske arterielle blodtrykk - målt i diastolen, det vil si under hjertets relaksasjonsfase.">
                        >
                        ["at0006"] = <
                            text = <"Uspesifisert hendelse">
                            description = <"Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i et templat eller i en applikasjon.">
                        >
                        ["at0007"] = <
                            text = <"*state structure(en)">
                            description = <"*@ internal @(en)">
                        >
                        ["at0008"] = <
                            text = <"Stilling">
                            description = <"Individets posisjon ved tidspunktet for målingen.">
                        >
                        ["at0011"] = <
                            text = <"Tre">
                            description = <"Struktur liste">
                        >
                        ["at0013"] = <
                            text = <"Mansjettstørrelse">
                            description = <"Størrelse på blodtrykkmansjetten som anvendes til måling av blodtrykket. (Cuffstørrelse)">
                        >
                        ["at0014"] = <
                            text = <"Målested">
                            description = <"Anatomisk sted hvor blodtrykket måles. Bruk listen over interne koder for valg av vanlige målesteder. Bruk fri eller kodet tekst for registrering av mer spesifikke detaljer eller et målested som ikke inngår i listen over vanlige steder. Henvis eventuelt til ekstern terminologi.">
                        >
                        ["at0015"] = <
                            text = <"Lår voksne">
                            description = <"Mansjett for bruk rundt låret til voksne individer.">
                        >
                        ["at0016"] = <
                            text = <"Store voksne">
                            description = <"En blodtrykksmansjett for voksne med store armer.">
                        >
                        ["at0017"] = <
                            text = <"Voksne">
                            description = <"En standard blodtrykksmansjett til voksne.">
                        >
                        ["at0025"] = <
                            text = <"Overarm, høyre">
                            description = <"Individets høyre overarm.">
                        >
                        ["at0026"] = <
                            text = <"Overarm, venstre">
                            description = <"Individets venstre overarm.">
                        >
                        ["at0027"] = <
                            text = <"Lår, høyre">
                            description = <"Individets høyre lår.">
                        >
                        ["at0028"] = <
                            text = <"Lår, venstre">
                            description = <"Individets venstre lår.">
                        >
                        ["at0033"] = <
                            text = <"Kommentar">
                            description = <"Ytterligere fritekst om målingen, som ikke omfattes av andre felt.">
                        >
                        ["at1000"] = <
                            text = <"Stående">
                            description = <"Stående ved tidspunktet for målingen.">
                        >
                        ["at1001"] = <
                            text = <"Sittende">
                            description = <"Sittende (for eksempel på en stol eller på en seng med føttene på gulvet) på tidspunkt for blodtrykksmålingen.">
                        >
                        ["at1002"] = <
                            text = <"Tilbakelent">
                            description = <"Sittende tilbakelent ca 45º og med beina hevet til samme høyde som hoften på tidspunkt for blodtrykksmålingen.">
                        >
                        ["at1003"] = <
                            text = <"Liggende">
                            description = <"Liggende flatt på tidspunkt for blodtrykksmålingen.">
                        >
                        ["at1005"] = <
                            text = <"Tilt">
                            description = <"Kranio-caudal tilt av overflaten som individet ligger på på tidspunkt for blodtrykksmåling.">
                        >
                        ["at1006"] = <
                            text = <"Middelarterietrykk">
                            description = <"Det gjennomsnittlige trykket mot arterieveggen gjennom en enkelt hjertesyklus. Middeltrykk/MAP måles direkte eller beregnes ut fra systolisk og diastolisk trykk ved hjelp av en matematisk formel.">
                        >
                        ["at1007"] = <
                            text = <"Pulstrykk">
                            description = <"Differansen mellom det systoliske og diastoliske arterielle blodtrykket.">
                        >
                        ["at1008"] = <
                            text = <"Små voksne">
                            description = <"En blodtrykksmansjett for små voksne.">
                        >
                        ["at1009"] = <
                            text = <"Barn">
                            description = <"En blodtrykksmansjett til barn eller små voksne med tynne armer.">
                        >
                        ["at1010"] = <
                            text = <"Diastolisk endepunkt">
                            description = <"Registrering av hvilken av Korotkofflydene som brukes for å bestemme det diastoliske blodtrykket ved hjelp av auskultasjon.">
                        >
                        ["at1011"] = <
                            text = <"Fase IV">
                            description = <"Den fjerde Korotkoff lyd som identifieres som en brå demping av lydene.">
                        >
                        ["at1012"] = <
                            text = <"Fase V">
                            description = <"Den femte Korotkoff lyd som identifiseres som fraværet av lyder idet mansjettrykket faller under det diastoliske blodtrykket.">
                        >
                        ["at1014"] = <
                            text = <"Liggende lent mot venstre">
                            description = <"Liggende flatt med noe lateral tilt, vanligvis vinklet mot venstre side. Vanligvis nødvendig i siste trimester av svangerskapet for å avlaste aortocaval komprimering.">
                        >
                        ["at1018"] = <
                            text = <"Spedbarn">
                            description = <"En blodtrykksmansjett til bruk for spedbarn.">
                        >
                        ["at1019"] = <
                            text = <"Neonatale">
                            description = <"En blodtrykksmansjett til bruk for neonatale, forutsatt at blodtrykksmansjetten er tilpasset i størrelse for modenhet og fødselsvekt.">
                        >
                        ["at1020"] = <
                            text = <"Håndledd, høyre">
                            description = <"Individets høyre håndledd.">
                        >
                        ["at1021"] = <
                            text = <"Håndledd, venstre">
                            description = <"Individets venstre håndledd.">
                        >
                        ["at1025"] = <
                            text = <"Måleapparat">
                            description = <"Detaljer om sfygmomanometeret eller annet måleapparat brukt til blodtrykksmåling.">
                        >
                        ["at1026"] = <
                            text = <"Ankel, høyre">
                            description = <"Individets høyre ankel.">
                        >
                        ["at1030"] = <
                            text = <"Fysisk anstrengelse">
                            description = <"Detaljer om fysisk aktivitet på tidspunkt for blodtrykksmåling.">
                        >
                        ["at1031"] = <
                            text = <"Ankel, venstre">
                            description = <"Individets venstre ankel.">
                        >
                        ["at1032"] = <
                            text = <"Finger">
                            description = <"Individets finger. Dersom identifikasjon av den spesifikke fingeren er nødvendig, kan dette legges inn ved hjelp av feltet med fri eller kodet tekst.">
                        >
                        ["at1035"] = <
                            text = <"Målemetode">
                            description = <"Metode for måling av blodtrykket.">
                        >
                        ["at1036"] = <
                            text = <"Auskultasjon">
                            description = <"Metode for måling av blodtrykk eksternt, ved hjelp av stetoskop og Korotkofflyder.">
                        >
                        ["at1037"] = <
                            text = <"Palpasjon">
                            description = <"Metode for måling av blodtrykket eksternt, ved hjelp av palpasjon (vanligvis av arteriene brachialis eller radialis).">
                        >
                        ["at1038"] = <
                            text = <"Formel for beregning av MAP">
                            description = <"Eventuell formel som er anvendt til beregning av middeltrykket (MAP).">
                        >
                        ["at1039"] = <
                            text = <"Automatisk, non-invasivt">
                            description = <"Metode for non-invasiv måling av blodtrykket ved hjelp av en maskin som automatisk måler blodtrykket, for eksempel et måleapparat eller en blodtrykksmåler for hjemmebruk.">
                        >
                        ["at1040"] = <
                            text = <"Automatisk, invasivt">
                            description = <"Metode for måling av blodtrykket invasivt med innleggelse av intravasalkateter i en blodåre.">
                        >
                        ["at1042"] = <
                            text = <"24-timers gjennomsnitt">
                            description = <"Estimert gjennomsnittsblodtrykk over en 24-timers periode.">
                        >
                        ["at1043"] = <
                            text = <"Søvnstatus">
                            description = <"Søvnstatus - understøtter tolkning av 24 timers ambulant blodtrykksmåling.">
                        >
                        ["at1044"] = <
                            text = <"Våken">
                            description = <"Individet er ved full bevissthet.">
                        >
                        ["at1045"] = <
                            text = <"Sovende">
                            description = <"Individet er i den naturlige tilstand av kroppslig hvile.">
                        >
                        ["at1051"] = <
                            text = <"Tå">
                            description = <"Individets tå. Dersom identifikasjon av den spesifikke tåen er nødvendig, kan dette legges inn ved hjelp av feltet med fri eller kodet tekst.">
                        >
                        ["at1052"] = <
                            text = <"Konfunderende faktorer">
                            description = <"Kommentar til og registrering av andre faktorer som kan påvirke blodtrykksmålingen. For eksempel angst eller \"hvit frakk syndrom\", smerter eller feber, endringer i atmosfærisk trykk osv.">
                        >
                        ["at1053"] = <
                            text = <"Intra-arterielt">
                            description = <"Invasiv måling i en artiere via en transducer.">
                        >
                        ["at1054"] = <
                            text = <"Formel for beregning av systolisk trykk">
                            description = <"Formelen som anvendes til beregning av systolisk blodtrykk dersom det benyttes en maskin som måler middeltrykket og beregner systolisk og diastolisk trykk.">
                        >
                        ["at1055"] = <
                            text = <"Formel for beregning av diastolisk trykk">
                            description = <"Formelen som anvendes til beregning av diastolisk blodtrykk dersom det benyttes en maskin som måler middeltrykket og beregner systolisk og diastolisk trykk.">
                        >
                        ["at1056"] = <
                            text = <"Fotrygg">
                            description = <"Individets fotrygg.">
                        >
                        ["at1057"] = <
                            text = <"Strukturert målested">
                            description = <"Strukturert anatomisk lokalisering av stedet målingen ble gjort.">
                        >
                        ["at1058"] = <
                            text = <"Tilleggsinformasjon">
                            description = <"Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.">
                        >
                        ["at1059"] = <
                            text = <"Klinisk tolkning">
                            description = <"Enkeltord, frase eller kort beskrivelse som representerer den kliniske betydningen og signifikansen av blodtrykksmålingen.">
                        >
