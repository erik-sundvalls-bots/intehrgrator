                        >
                        ["at0069"] = <
                            text = <"Directivas de autorización">
                            description = <"Detalles sobre la autorización del ítem ordenado, incluyendo ayuda para autoadministración local, y politicas frente a problemas y ratificaciones.">
                        >
                        ["at0070"] = <
