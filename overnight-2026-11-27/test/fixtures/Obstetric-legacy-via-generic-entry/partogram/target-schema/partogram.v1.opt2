                        ["at0004"] = <
                            text = <"سیستولیک">
                            description = <"اوج فشار خون وریدی کلی که در سیستولیک یا فاز انقباضی چرخه گردش خون اندازه گیری می شود ">
                        >
                        ["at0005"] = <
                            text = <"دیاستولیک">
                            description = <"حداقل فشار خون وریدی کلی که در دیاستولیک یا فاز انبساطی چرخه گردش خون اندازه گیری می شود">
                        >
                        ["at0006"] = <
