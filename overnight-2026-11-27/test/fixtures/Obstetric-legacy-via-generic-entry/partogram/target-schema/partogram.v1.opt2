                    ["ca"] = <
                        ["at0000"] = <
                            text = <"Pressió arterial">
                            description = <"La mesura local de la pressió arterial, que és una substituta de la pressió arterial a la circulació sistèmica.">
                        >
                        ["at0001"] = <
                            text = <"Antecedents">
                            description = <"Node estructural dels antecedents.">
                        >
                        ["at0003"] = <
                            text = <"blood pressure">
                            description = <"@ internal @">
                        >
                        ["at0004"] = <
                            text = <"Sistòlica">
                            description = <"Pressió arterial sistemàtica màxima - mesurada en la fase sistòlica o de contracció del cicle cardíac.">
                        >
                        ["at0005"] = <
                            text = <"Diastòlica">
                            description = <"Pressió arterial sistemàtica mínima - mesurada en la fase diastòlica o de relaxació del cicle cardíac.">
                        >
                        ["at0006"] = <
                            text = <"Qualsevol esdeveniment">
                            description = <"Esdeveniment predeterminat i no especificat d’un moment específic o interval que es pot definir clarament en una plantilla o en temps d’execució.">
                        >
                        ["at0007"] = <
                            text = <"state structure">
                            description = <"@ internal @">
                        >
                        ["at0008"] = <
                            text = <"Posició">
                            description = <"Posició del pacient al moment de la mesura.">
                        >
                        ["at0011"] = <
                            text = <"Esquema">
                            description = <"Llistat.">
                        >
                        ["at0013"] = <
                            text = <"Grandària del maneguet">
                            description = <"Grandària del maneguet utilitzat per a mesurar la pressió arterial.">
                        >
                        ["at0014"] = <
                            text = <"Zona del mesurament">
                            description = <"Zona del cos on es va mesurar la pressió arterial.">
                        >
                        ["at0015"] = <
                            text = <"Cuixa d'un adult">
                            description = <"Maneguet utilitzat per a una cuixa adulta (20 cm x 42 cm aprox.).">
                        >
                        ["at0016"] = <
                            text = <"Adult gran">
                            description = <"Maneguet utilitzat per a un adult amb braços grans (16 cm x 38 cm aprox.).">
                        >
                        ["at0017"] = <
                            text = <"Adult">
                            description = <"Maneguet estàndard per a un adult (13 cm x 30 cm aprox.).">
                        >
                        ["at0025"] = <
                            text = <"Braç dret">
                            description = <"Braç dret del pacient.">
                        >
                        ["at0026"] = <
                            text = <"Braç esquerre">
                            description = <"Braç esquerre del pacient.">
                        >
                        ["at0027"] = <
                            text = <"Cuixa dreta">
                            description = <"Cuixa dreta del pacient.">
                        >
                        ["at0028"] = <
                            text = <"Cuixa esquerra">
                            description = <"Cuixa esquerra del pacient.">
                        >
                        ["at0033"] = <
                            text = <"Observacions">
                            description = <"Informació addicional sobre la mesura, no recollida en altres caselles.">
                        >
                        ["at1000"] = <
                            text = <"Dret">
                            description = <"Persona de peu al moment de la mesura de la pressió arterial.">
                        >
                        ["at1001"] = <
                            text = <"Assegut">
                            description = <"Persona asseguda (per exemple, al llit o en una cadira) al moment de la mesura de la pressió arterial.">
                        >
                        ["at1002"] = <
                            text = <"Reclinat">
                            description = <"Persona reclinada al moment de la mesura de la pressió arterial.">
                        >
                        ["at1003"] = <
                            text = <"Ajagut">
                            description = <"Persona ajaguda en posició horitzontal al moment de la mesura de la pressió arterial.">
                        >
                        ["at1005"] = <
                            text = <"Inclinació">
                            description = <"La inclinació craniocaudal de la superfície on la persona es ajeu al moment de la mesura.">
                        >
                        ["at1006"] = <
                            text = <"Pressió arterial mitjana">
                            description = <"La mitjana de la pressió arterial que ocorre durant el cicle complet de contracció i relaxació del cor.">
                        >
                        ["at1007"] = <
                            text = <"Pressió de pols">
                            description = <"Diferència entre la pressió sistòlica i la diastòlica.">
                        >
                        ["at1008"] = <
                            text = <"Adult petit">
                            description = <"Maneguet utilitzat per a un adult petit (10 cm x 24 cm aprox.).">
                        >
                        ["at1009"] = <
                            text = <"Pediàtric/Infants">
                            description = <"Maneguet apropiat per a un infant o adult amb un braç petit (8 cm x 21 cm aprox.).">
                        >
                        ["at1010"] = <
                            text = <"Punt final diastòlic">
                            description = <"Registra quin so de Korotkoff s'utilitza per a determinar la pressió diastòlica mitjançant el mètode d'auscultació.">
                        >
                        ["at1011"] = <
                            text = <"Fase IV">
                            description = <"El quart so Korotkoff s'identifica com un amortiment abrupte de sons.">
                        >
                        ["at1012"] = <
                            text = <"Fase V">
                            description = <"El cinquè so de Korotkoff s'identifica per l'absència de sons quan la pressió del maneguet cau per sota de la pressió arterial diastòlica.">
                        >
                        ["at1014"] = <
                            text = <"Ajagut cap a l'esquerra">
                            description = <"Persona ajaguda amb una certa inclinació lateral, generalment en angle cap al costat esquerre. Es requereix normalment durant l'últim trimestre d'embaràs per alleujar la compressió aortocava.">
                        >
                        ["at1018"] = <
                            text = <"Nadó">
                            description = <"Maneguet utilitzat per a nadons (5 cm x 15 cm aprox.).">
                        >
                        ["at1019"] = <
                            text = <"Nounat">
                            description = <"Maneguet utilitzat per nounats, suposant que el maneguet sigui de la mida adequada per a la maduresa i pes del nounat.">
                        >
                        ["at1020"] = <
                            text = <"Canell dret">
                            description = <"Canell dret del pacient.">
                        >
                        ["at1021"] = <
                            text = <"Canell esquerre">
                            description = <"Canell esquerre del pacient.">
                        >
                        ["at1025"] = <
                            text = <"Dispositiu">
                            description = <"Dades sobre el tensiòmetre o altre dispositiu utilitzat per a mesurar la pressió arterial.">
                        >
                        ["at1026"] = <
                            text = <"Turmell dret">
                            description = <"Turmell dret del pacient.">
                        >
                        ["at1030"] = <
                            text = <"Esforç">
                            description = <"Dades sobre l'activitat física realitzada al moment de la mesura de la pressió arterial.">
                        >
                        ["at1031"] = <
                            text = <"Turmell esquerre">
                            description = <"Turmell esquerre del pacient.">
                        >
                        ["at1032"] = <
                            text = <"Dit de la mà">
                            description = <"Un dit de la mà del pacient.">
                        >
                        ["at1035"] = <
                            text = <"Mètode">
                            description = <"Mètode de la mesura de la pressió arterial.">
                        >
                        ["at1036"] = <
                            text = <"Auscultació">
                            description = <"Mètode extern de mesura de la pressió arterial, utilitzant un estetoscopi i sons de Korotkoff.">
                        >
                        ["at1037"] = <
                            text = <"Palpació">
                            description = <"Mètode extern de mesura de la pressió arterial, utilitzant la palpació, en general de l'artèria braquial o artèries radials.">
                        >
                        ["at1038"] = <
                            text = <"Fórmula de la pressió arterial mitjana">
                            description = <"Fórmula utilitzada per a calcular la Pressió Arterial Mitjana (en cas de registrar aquesta dada).">
                        >
                        ["at1039"] = <
                            text = <"Màquina">
                            description = <"Mètode extern de mesura de la pressió arterial, utilitzant un dispositiu o màquina.">
                        >
                        ["at1040"] = <
                            text = <"Invasiu">
                            description = <"Mètode intern de mesura de la pressió arterial que involucra la penetració de la pell i mesurar dins dels vasos sanguinis.">
                        >
                        ["at1042"] = <
                            text = <"Mitjana de 24 hores">
                            description = <"Estimació de la pressió arterial mitjana durant un període de 24 hores.">
                        >
                        ["at1043"] = <
                            text = <"Estat del son">
                            description = <"Estat del son - ajuda a la interpretació dels registres de la pressió arterial ambulatòria de 24 hores.">
                        >
                        ["at1044"] = <
                            text = <"Despert">
                            description = <"La persona es troba totalment conscient.">
                        >
                        ["at1045"] = <
                            text = <"Dormit">
                            description = <"La persona es troba en un estat natural de repòs corporal.">
                        >
                        ["at1051"] = <
                            text = <"Dit del peu">
                            description = <"Un dit del peu del pacient.">
                        >
                        ["at1052"] = <
                            text = <"Factors de confusió">
                            description = <"Comentar i registrar altres factors incidentals que puguin estar afectant a la mesura de la pressió arterial. Per exemple, nivell d'ansietat o «hipertensió de bata blanca»; dolor o febre; canvis en la pressió atmosfèrica, etc.">
                        >
                        ["at1053"] = <
                            text = <"Intraarterial">
                            description = <"Mesura invasiva mitjançant un transductor dins d'una artèria.">
                        >
                        ["at1054"] = <
                            text = <"Fórmula de pressió sistòlica">
                            description = <"Fórmula utilitzada per a calcular la pressió sistòlica a partir de la pressió arterial mitjana (en cas de registrar aquesta dada).">
                        >
                        ["at1055"] = <
                            text = <"Fórmula de pressió diastòlica">
                            description = <"Fórmula utilitzada per a calcular la pressió diastòlica a partir de la pressió arterial mitjana (en cas de registrar aquesta dada).">
                        >
                        ["at1056"] = <
                            text = <"Dors del peu">
                            description = <"Dors del peu del pacient.">
                        >
                        ["at1057"] = <
                            text = <"Zona estructurada del mesurament">
                            description = <"Zona anatòmica estructurada d'on es va prendre el mesurament.">
                        >
                        ["at1058"] = <
                            text = <"Extensió">
                            description = <"Informació addicional requerida per a capturar el contingut local o per alinear-se amb altres models/formalismes de referència.">
                        >
                        ["at1059"] = <
                            text = <"Interpretació clínica">
                            description = <"Una sola paraula, frase o descripció breu que representi el significat clínic i la importància de la mesura de la pressió arterial.">
                        >
                        ["ac0.1"] = <
                            text = <"*(Synthesized) (en)">
