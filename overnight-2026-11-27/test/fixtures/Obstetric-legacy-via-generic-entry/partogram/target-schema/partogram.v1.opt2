                        >
                        ["at0003"] = <
                            text = <"Beskrivning">
                            description = <"*Narrative description about the fluid. (en)">
                        >
                        ["at0004"] = <
                            text = <"Specifika fynd">
                            description = <"*Additional structured details about the body fluid. (en)">
                        >
                        ["at0005"] = <
                            text = <"Multimediavisning">
                            description = <"*Digital image, video or diagram representing the inspection findings. (en)">
                        >
                        ["at0006"] = <
                            text = <"Klinisk tolkning">
                            description = <"*Single word, phrase or brief description that represents the clinical meaning and significance of the examination findings. (en)">
                        >
                        ["at0007"] = <
                            text = <"Kommentar">
                            description = <"*Additional narrative about the inspection findings, not captured in other fields. (en)">
                        >
                        ["at0008"] = <
                            text = <"Undersökning ej utförd">
                            description = <"*Details to explicitly record that this examination was not performed. (en)">
                        >
                        ["at0017"] = <
                            text = <"Lukt">
                            description = <"*The smell of the body fluid. (en)">
                        >
                        ["at0018"] = <
