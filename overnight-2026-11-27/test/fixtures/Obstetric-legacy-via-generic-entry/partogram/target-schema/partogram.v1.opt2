                        ["at1018"] = <
                            text = <"Sekoittavat tekijät">
                            description = <"Kertomusmuodossa oleva kuvaus satunnaistekijöistä, jotka saattavat vaikuttaa fysikaalisten löydösten tulkintaan.">
                        >
                        ["at1019"] = <
                            text = <"Menetelmä">
                            description = <"Pulssin tai sykkeen havainnointiin käytettävä menetelmä.">
