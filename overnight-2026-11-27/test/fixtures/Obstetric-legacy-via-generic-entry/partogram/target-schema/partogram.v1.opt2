                        >
                        ["at1057"] = <
                            text = <"Gestructureerde lichaamslocatie van de meting">
                            description = <"Gestructureerde anatomische locatie waar de bloeddruk is gemeten.">
                        >
                        ["at1058"] = <
                            text = <"Extensie">
                            description = <"Aanvullende informatie die vereist is om de lokale context vast te leggen of uit te lijnen met andere referentiemodellen/formalismen.">
                        >
                        ["at1059"] = <
                            text = <"Klinische interpretatie">
                            description = <"Eén woord, zin of korte beschrijving die de klinische betekenis van de bloeddrukmeting weergeeft.">
