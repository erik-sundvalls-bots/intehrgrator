                            description = <"Правое бедро пациента.">
                        >
                        ["at0028"] = <
                            text = <"Левое бедро">
                            description = <"Левое бедро пациента.">
                        >
                        ["at0033"] = <
                            text = <"*Comment(en)">
                            description = <"*Additional narrative about the measurement, not captured in other fields.(en)">
                        >
