                    ["ca"] = <
                        ["at0000"] = <
                            text = <"Pols / Batec cardíac">
                            description = <"La freqüència i els atributs associats per a un pols o batec cardíac.">
                        >
                        ["at0001"] = <
                            text = <"estructura">
                            description = <"@ internal @">
                        >
                        ["at0002"] = <
                            text = <"història">
                            description = <"@ internal @">
                        >
                        ["at0003"] = <
                            text = <"Qualsevol esdeveniment">
                            description = <"Per defecte, un punt no especificat en l'esdeveniment de temps o interval que es pot definir explícitament en una plantilla o en temps d'execució.">
                        >
                        ["at0004"] = <
                            text = <"Taxa">
                            description = <"La velocitat del pols o batec del cor, mesurada en batecs per minut.">
                        >
                        ["at0005"] = <
                            text = <"Regularitat">
                            description = <"Regularitat del pols o batec cardíac.">
                        >
                        ["at0006"] = <
                            text = <"Regular">
                            description = <"El patró és regular.">
                        >
                        ["at0007"] = <
                            text = <"Regularment irregular">
                            description = <"El patró és irregular en un patró regular. Per exemple, un batec caigut una vegada que cada 'n' batega.">
                        >
                        ["at0008"] = <
                            text = <"Irregular">
                            description = <"El patró és irregular de manera caòtica i impredictible. Per exemple, la fibril·lació auricular.">
                        >
                        ["at0010"] = <
                            text = <"Llista">
                            description = <"@ internal @">
                        >
                        ["at0012"] = <
                            text = <"Llista">
                            description = <"@ internal @">
                        >
                        ["at0013"] = <
                            text = <"Posició">
                            description = <"La posició corporal del subjecte durant l'observació.">
                        >
                        ["at1000"] = <
                            text = <"mentida">
                            description = <"El tema estava estirat.">
                        >
                        ["at1001"] = <
                            text = <"Assegut">
                            description = <"El tema estava assegut (per exemple en llit o cadira).">
                        >
                        ["at1002"] = <
                            text = <"Reclinació">
                            description = <"El tema estava reclinat en un angle aproximat de 45 graus, amb les cames elevades al nivell de la pelvis.">
                        >
                        ["at1003"] = <
                            text = <"En peu/alt">
                            description = <"El tema estava de peu, caminant o corrent.">
                        >
                        ["at1005"] = <
                            text = <"Presència">
                            description = <"Presència d'un pols o batec cardíac.">
                        >
                        ["at1013"] = <
                            text = <"Dispositiu">
                            description = <"Detalls sobre el dispositiu utilitzat per mesurar la freqüència de pols o freqüència cardíaca.">
                        >
                        ["at1017"] = <
                            text = <"Exerció">
                            description = <"Detalls sobre l'esforç físic que s'està realitzant durant l'examen.">
                        >
                        ["at1018"] = <
                            text = <"Factors de confusió">
                            description = <"Descripció narrativa sobre qualsevol factor incidental que pugui afectar la interpretació de les troballes físiques.">
                        >
                        ["at1019"] = <
                            text = <"Mètode">
                            description = <"Mètode utilitzat per observar el pols o batec cardíac.">
                        >
                        ["at1022"] = <
                            text = <"Descripció clínica">
                            description = <"Descripció narrativa sobre el pols o batec cardíac.">
                        >
                        ["at1023"] = <
                            text = <"Interpretació clínica">
                            description = <"Paraula única, frase o breu descripció que representa el significat clínic i la significació de les troballes del pols o del batec cardíac, inclòs el ritme.">
                        >
                        ["at1024"] = <
                            text = <"Present">
                            description = <"Es pot detectar un pols o batec cardíac.">
                        >
                        ["at1025"] = <
                            text = <"No detectat">
                            description = <"No es pot detectar un pols o batec cardíac.">
                        >
                        ["at1028"] = <
                            text = <"Irregular">
                            description = <"El patró és irregular.">
                        >
                        ["at1030"] = <
                            text = <"Caràcter">
                            description = <"Descripció del caràcter del pols o batec cardíac.">
                        >
                        ["at1032"] = <
                            text = <"Palpació">
                            description = <"Els resultats s'observen mitjançant el contacte físic de l'observador sobre el tema.">
                        >
                        ["at1033"] = <
                            text = <"Auscultació">
                            description = <"Les troballes s'observen amb l'ajuda d'un dispositiu, com un estetoscopi.">
                        >
                        ["at1034"] = <
                            text = <"Automàtic, no invasiu">
                            description = <"Els resultats s'observen de manera no invasiva utilitzant un dispositiu com un oxidant de pols o un estetoscopi.">
                        >
                        ["at1036"] = <
                            text = <"Màxim">
                            description = <"Freqüència màxima de pols o freqüència cardíaca observada durant un període d'esforç.">
                        >
                        ["at1037"] = <
                            text = <"Lloc del cos">
                            description = <"Lloc corporal on es va observar el pols o batec cardíac.">
                        >
                        ["at1038"] = <
