                        >
                        ["at0023"] = <
                            text = <"Canale uditivo">
                            description = <"La temperatura viene misurata dall'interno del canale uditivo esterno.">
                        >
                        ["at0024"] = <
                            text = <"Ascella">
                            description = <"La temperatura viene misurata dalla pelle dell'ascella con il braccio posizionato lateralmente.">
