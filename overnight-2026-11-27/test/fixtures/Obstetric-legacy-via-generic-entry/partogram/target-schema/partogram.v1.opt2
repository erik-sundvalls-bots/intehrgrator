                    ["de"] = <
                        ["at0000"] = <
                            text = <"Verordnung von Arzneimittel">
                            description = <"Verschreibung eines Medikaments, Impfstoffs, Ernährungsprodukts oder anderen therapeutischen Mittels für eine bestimmte Person.">
                        >
