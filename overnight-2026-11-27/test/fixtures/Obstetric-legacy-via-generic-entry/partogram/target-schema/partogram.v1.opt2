                    ["zh-cn"] = <
                        ["at0000"] = <
                            text = <"血压">
                            description = <"代表体循环动脉压的动脉血压的局部测量。">
                        >
                        ["at0001"] = <
                            text = <"历史">
                            description = <"历史结构节点">
                        >
                        ["at0003"] = <
                            text = <"血压">
                            description = <"*@ internal @(en)">
                        >
                        ["at0004"] = <
                            text = <"收缩压">
                            description = <"在心动周期的收缩期所测量到的体循环动脉血压峰值。">
                        >
                        ["at0005"] = <
                            text = <"舒张压">
                            description = <"在心动周期的舒张期所测量到的体循环动脉血压最低值（谷值，最小值）。">
                        >
                        ["at0006"] = <
                            text = <"任何事件">
                            description = <"默认，在某一模板之中或在运行时所可能明确定义的未加详细说明的时间点或时段事件。">
                        >
                        ["at0007"] = <
                            text = <"*state structure(en)">
                            description = <"*@ internal @(en)">
                        >
                        ["at0008"] = <
                            text = <"体位">
                            description = <"测量时受检对象的体位或者说身体姿势。">
                        >
                        ["at0011"] = <
                            text = <"树状结构">
                            description = <"列表结构">
                        >
                        ["at0013"] = <
                            text = <"袖带尺寸">
                            description = <"用于血压测量的袖带（臂带，袖套，臂围）的大小或者说尺寸。">
                        >
                        ["at0014"] = <
                            text = <"测量位置">
                            description = <"测量血压时所采用的简单身体部位。">
                        >
                        ["at0015"] = <
                            text = <"成年人大腿型">
                            description = <"适用于成年人大腿的袖带（臂带，袖套，臂围） - 气囊尺寸约为 20cm x 42cm。">
                        >
                        ["at0016"] = <
                            text = <"成年人粗大型">
                            description = <"适用于上肢较为粗大的成年人的袖带（臂带，袖套，臂围） - 气囊尺寸约为16cm x 38cm。">
                        >
                        ["at0017"] = <
                            text = <"成年人标准型">
                            description = <"适用于成年人的标准袖带（臂带，袖套，臂围） - 气囊尺寸约为13cm x 30cm。">
                        >
                        ["at0025"] = <
                            text = <"右臂">
                            description = <"受检对象的右臂。">
                        >
                        ["at0026"] = <
                            text = <"左臂">
                            description = <"受检对象的左臂。">
                        >
                        ["at0027"] = <
                            text = <"右腿">
                            description = <"受检对象的右腿。">
                        >
                        ["at0028"] = <
                            text = <"左腿">
                            description = <"受检对象的左腿。">
                        >
                        ["at0033"] = <
                            text = <"注释">
                            description = <"其他字段并未予以记录的，关于当前检测过程的附加文字叙述。">
                        >
                        ["at1000"] = <
                            text = <"立位">
                            description = <"测量血压时身体处于站立体位">
                        >
                        ["at1001"] = <
                            text = <"坐位">
                            description = <"测量血压时身体处于坐位，又称为“坐姿”。">
                        >
                        ["at1002"] = <
                            text = <"侧卧位">
                            description = <"测量血压时身体处于45度角侧卧位或者说采取的是斜靠的姿势。">
                        >
                        ["at1003"] = <
                            text = <"平卧位">
                            description = <"测量血压时受检者采取的是平躺或者说平卧的姿势，又称为“仰卧位”。">
                        >
                        ["at1005"] = <
                            text = <"倾角">
                            description = <"测量时该人员所卧于的表面的颅尾（头尾）倾角（倾斜角度）。">
                        >
                        ["at1006"] = <
                            text = <"平均动脉压">
                            description = <"又称为“平均动脉血压”，指的是在整个心脏收缩与舒张周期过程中出现的动脉压均值（平均动脉压）。">
                        >
                        ["at1007"] = <
                            text = <"脉压">
                            description = <"收缩压与舒张压之间的差值，又称为“脉压差”或“脉搏压”。">
                        >
                        ["at1008"] = <
                            text = <"成年人细小型">
                            description = <"适用于体型瘦小的成年人的袖带（臂带，袖套，臂围） - 气囊尺寸约为10cm x 24cm。">
                        >
                        ["at1009"] = <
                            text = <"儿科型/儿童型">
                            description = <"适用于儿童或上肢较瘦成年人的袖带（臂带，袖套，臂围） - 气囊尺寸约为8cm x 21cm。">
                        >
                        ["at1010"] = <
                            text = <"舒张期终点">
                            description = <"旨在记录当确定舒张压时所采用的究竟是哪种柯氏音。">
                        >
                        ["at1011"] = <
                            text = <"第IV时相">
                            description = <"将声音的突然减弱（消音，捂住，低沉）或者说其向捂音的突然转变确定为第IV柯氏音，即柯氏音的第IV时相（变音）。">
                        >
                        ["at1012"] = <
                            text = <"第V时相">
                            description = <"将声音随着袖带压力降至舒张压以下时声音的消失确定为第V柯氏音，即柯氏音的第V时相。">
                        >
                        ["at1014"] = <
                            text = <"左斜卧位">
                            description = <"测量血压时受检者采取的是平躺或者说平卧姿势，且有向侧位一定程度的倾斜，通常是斜向左侧。在妊娠晚期，为了缓解主腔静脉压迫（aortocaval compression），常常需要采取这种体位。">
                        >
                        ["at1018"] = <
                            text = <"婴幼儿型">
                            description = <"适用于婴幼儿的袖带（臂带，袖套，臂围） - 气囊尺寸约为5cm x 15cm。">
                        >
                        ["at1019"] = <
                            text = <"新生儿型">
                            description = <"适用于新生儿的袖带（臂带，袖套，臂围），且假定袖带尺寸适合于新生儿的成熟度和出生体重。">
                        >
                        ["at1020"] = <
                            text = <"右手腕">
                            description = <"受检对象的右手腕。">
                        >
                        ["at1021"] = <
                            text = <"左手腕">
                            description = <"受检对象的左手腕。">
                        >
                        ["at1025"] = <
                            text = <"装置">
                            description = <"关于用于测量血压的血压计或其他装置（仪器，设备）的详情。">
                        >
                        ["at1026"] = <
                            text = <"右踝">
                            description = <"受检对象的右踝。">
                        >
                        ["at1030"] = <
                            text = <"体力活动">
                            description = <"关于血压测量时所从事的体力活动或者说身体活动的详情。">
                        >
                        ["at1031"] = <
                            text = <"左踝">
                            description = <"受检对象的左踝。">
                        >
                        ["at1032"] = <
                            text = <"手指">
                            description = <"检查对象的某一手指。">
                        >
                        ["at1035"] = <
                            text = <"方法">
                            description = <"血压测量方法。">
                        >
                        ["at1036"] = <
                            text = <"听诊法">
                            description = <"利用听诊器和柯氏音（Korotkoff sounds）在身体外部测量血压的方法。">
                        >
                        ["at1037"] = <
                            text = <"触诊法">
                            description = <"利用触诊（扪诊）在身体外部测量血压的方法（通常采用的是对肱动脉或桡动脉的触诊）。">
                        >
                        ["at1038"] = <
                            text = <"平均动脉压公式">
                            description = <"用于计算平均动脉压（Mean Arterial Pressure，MAP，平均动脉血压）的公式（如果在数据之中加以记录的话）。">
                        >
                        ["at1039"] = <
                            text = <"仪器法">
                            description = <"利用血压测量设备（仪器，装置）在身体外部测量血压的方法。">
                        >
                        ["at1040"] = <
                            text = <"有创法">
                            description = <"在身体内部测量血压的方法，也就是说涉及到皮肤穿刺和在血管内进行测量。">
                        >
                        ["at1042"] = <
                            text = <"24小时均值">
                            description = <"24小时期间血压均值的估计">
                        >
                        ["at1043"] = <
                            text = <"睡眠状态">
                            description = <"睡眠状态 - 旨在支持对于24小时流动式/门诊血压记录的解释。">
                        >
                        ["at1044"] = <
                            text = <"警觉且清醒">
                            description = <"受检对象意识完全清楚。">
                        >
                        ["at1045"] = <
                            text = <"睡眠状态">
                            description = <"受检对象处在全身休息的自然状态下。">
                        >
                        ["at1051"] = <
                            text = <"脚趾">
                            description = <"检查对象的某一脚趾。">
                        >
                        ["at1052"] = <
                            text = <"干扰因素">
                            description = <"旨在记录和说明可能影响血压测量结果的偶然因素。例如，焦虑/进展程度或“白大褂综合征（white coat syndrome）”、疼痛、发热、大气压变化等等。">
                        >
                        ["at1053"] = <
                            text = <"动脉内">
                            description = <"利用位于动脉内的传感器接入通路来进行有创性测量。">
                        >
                        ["at1054"] = <
                            text = <"收缩压公式">
                            description = <"用于依据平均动脉压（数据之中已有相应记录时）来计算收缩压的公式。">
                        >
                        ["at1055"] = <
                            text = <"舒张压公式">
                            description = <"用于依据平均动脉压（数据之中已有相应记录时）来计算舒张压的公式。">
                        >
                        ["at1056"] = <
                            text = <"足背">
                            description = <"患者脚部的背面。">
                        >
                        ["at1057"] = <
                            text = <"结构化测量位置">
                            description = <"进行当前测量时所采用的结构化解剖学位置。">
                        >
                        ["at1058"] = <
                            text = <"扩展">
                            description = <"采集/记录本地语境或者与其他参考模型/形式化体系进行匹配统一时所需的附加信息。">
                        >
                        ["at1059"] = <
                            text = <"临床解释">
                            description = <"单个词语、短语或者简要的描述，用于表达当前血压测量结果的临床含义和意义。">
                        >
                        ["ac0.1"] = <
