                            description = <"Ταυτοποίηση του εξεταζόμενου συστήματος σώματος ή ανατομικής δομής.">
                        >
                        ["at0003"] = <
                            text = <"Κλινική Περιγραφή">
                            description = <"Αφηγηματική περιγραφή των συνολικών ευρημάτων που παρατηρήθηκαν κατά τη διάρκεια της φυσικής εξέτασης.">
                        >
                        ["at0004"] = <
                            text = <"Ευρήματα εξέτασης">
                            description = <"Δομημένες λεπτομέρειες σχετικά με τα ευρήματα της φυσικής εξέτασης.">
                        >
                        ["at0005"] = <
                            text = <"Αναπαράσταση πολυμέσων">
                            description = <"Ψηφιακή εικόνα, βίντεο ή διάγραμμα που αναπαριστά τα ευρήματα της φυσικής εξέτασης.">
                        >
                        ["at0006"] = <
                            text = <"Κλινική αξιολόγηση">
                            description = <"Μία λέξη, φράση ή σύντομη περιγραφή που αντιπροσωπεύει την κλινική σημασία και σημασία των ευρημάτων της φυσικής εξέτασης.">
                        >
                        ["at0007"] = <
                            text = <"Σχόλιο">
                            description = <"Πρόσθετη αφήγηση σχετικά με τα ευρήματα της φυσικής εξέτασης, που δεν αποτυπώνεται σε άλλους τομείς.">
                        >
                        ["at0008"] = <
                            text = <"Λόγος διακοπής εξέτασης">
                            description = <"Λεπτομέρειες για να καταγραφεί ρητά ότι αυτή η εξέταση δεν διενεργήθηκε.">
                        >
                        ["at0011"] = <
