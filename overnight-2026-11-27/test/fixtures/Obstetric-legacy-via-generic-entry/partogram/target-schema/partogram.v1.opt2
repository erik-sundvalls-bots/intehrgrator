                        >
                        ["at0003"] = <
                            text = <"Cualquier evento">
                            description = <"Evento predeterminado, de punto en el tiempo o intervalo no especificado que puede definirse explícitamente en una plantilla o en tiempo de ejecución.">
                        >
                        ["at0004"] = <
                            text = <"Frecuencia">
                            description = <"La frecuencia del pulso o latido del corazón, medida en latidos por minuto.">
                        >
                        ["at0005"] = <
                            text = <"Regularidad">
                            description = <"Regularidad del pulso o latido del corazón.">
                        >
                        ["at0006"] = <
                            text = <"Regular">
                            description = <"El patrón es regular.">
                        >
                        ["at0007"] = <
                            text = <"Regularmente irregular">
                            description = <"El patrón es irregular en un patrón regular. Por ejemplo baja de un latido cada 'n' latidos.">
                        >
                        ["at0008"] = <
                            text = <"Irregularmente irregular">
                            description = <"El patrón es irregular, caótico e impredecible. Por ejemplo, la fibrilación auricular.">
                        >
                        ["at0010"] = <
                            text = <"lista">
                            description = <"@ internal @">
                        >
                        ["at0012"] = <
                            text = <"lista">
                            description = <"@ internal @">
                        >
                        ["at0013"] = <
                            text = <"Posición">
                            description = <"Posición del cuerpo del sujeto durante la observación.">
                        >
                        ["at1000"] = <
                            text = <"Acostado">
                            description = <"El sujeto está acostado de forma horizontal.">
                        >
                        ["at1001"] = <
                            text = <"Sentado">
                            description = <"El sujeto estaba sentado (por ejemplo en la cama o en una silla).">
                        >
                        ["at1002"] = <
                            text = <"Reclinado">
                            description = <"El sujeto estaba reclinado en un ángulo aproximado a los 45 grados, con las piernas elevadas al nivel de la pelvis.">
                        >
                        ["at1003"] = <
                            text = <"De pie">
                            description = <"El sujeto estaba de pie, caminando o corriendo.">
                        >
                        ["at1005"] = <
                            text = <"Presencia">
                            description = <"Presencia del pulso o latidos del corazón.">
                        >
                        ["at1013"] = <
                            text = <"Dispositivo">
                            description = <"Detalles sobre el dispositivo utilizado para la medida del pulso o latidos del corazón">
                        >
                        ["at1017"] = <
                            text = <"Esfuerzo">
                            description = <"Detalles sobre el esfuerzo físico que se realiza durante el examen.">
                        >
                        ["at1018"] = <
                            text = <"Factores de confusión">
                            description = <"Descripción narrativa de cualquier factor incidental que pueda afectar la interpretación de los hallazgos físicos.">
                        >
                        ["at1019"] = <
                            text = <"Método">
                            description = <"Método utilzado para realizar la observación del pulso o latidos del corazón">
                        >
                        ["at1022"] = <
                            text = <"Descripción clínica">
                            description = <"Descripción narrativa sobre el pulso o latidos cardíacos.">
                        >
                        ["at1023"] = <
                            text = <"Interpretación clínica">
                            description = <"Palabra única, frase o breve descripción que representa el significado clínico y significado de los hallazgos sobre el pulso o latidos del corazón, incluyendo el ritmo.">
                        >
                        ["at1024"] = <
                            text = <"Presente">
                            description = <"Pulso o latidos cardíacos son detectados.">
                        >
                        ["at1025"] = <
                            text = <"No detectado">
                            description = <"Pulso o latidos cardíacos no son detectados.">
                        >
                        ["at1028"] = <
                            text = <"Irregular">
                            description = <"El patrón es irregular.">
                        >
                        ["at1030"] = <
                            text = <"Carácter">
                            description = <"Descripción del carácter del pulso o latidos del corazón.">
                        >
                        ["at1032"] = <
                            text = <"Palpación">
                            description = <"Los hallazgos se observan mediante el contacto físico del observador sobre el sujeto.">
                        >
                        ["at1033"] = <
                            text = <"Auscultación">
                            description = <"Los hallazgos fueron obserbados mediante la asistencia de un dispositivo, como un estetoscopio.">
                        >
                        ["at1034"] = <
                            text = <"Automático, no invasivo">
                            description = <"Los hallazgos se observan de forma no invasiva utilizando un dispositivo como un oxímetro de pulso o un estetoscopio.">
                        >
                        ["at1036"] = <
                            text = <"Máximo">
