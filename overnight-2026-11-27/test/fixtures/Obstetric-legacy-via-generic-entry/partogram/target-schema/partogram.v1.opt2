                    ["el"] = <
                        ["at0000"] = <
                            text = <"Πίεση αίματος">
                            description = <"Η τοπική μέτρηση της αρτηριακής πίεσης που είναι υποκατάστατο της αρτηριακής πίεσης στη συστηματική κυκλοφορία.">
                        >
                        ["at0001"] = <
                            text = <"Ιστορικό">
                            description = <"*History Structural node.(en)">
                        >
                        ["at0003"] = <
                            text = <"blood pressure">
                            description = <"@ internal @">
                        >
                        ["at0004"] = <
                            text = <"Συστολική">
                            description = <"Μέγιστη συστηματική αρτηριακή πίεση - μετρούμενη σε φάση συστολής ή συστολής του καρδιακού κύκλου.">
                        >
                        ["at0005"] = <
                            text = <"Διαστολική">
                            description = <"Ελάχιστη συστηματική αρτηριακή πίεση - μετρούμενη στη διαστολική φάση ή στη φάση χαλάρωσης του καρδιακού κύκλου.">
                        >
                        ["at0006"] = <
                            text = <"*Any event(en)">
                            description = <"Προεπιλεγμένο, απροσδιόριστο χρονικό σημείο ή συμβάν διαστήματος που μπορεί να ορίζεται ρητά σε ένα πρότυπο ή κατά το χρόνο εκτέλεσης.">
                        >
                        ["at0007"] = <
                            text = <"state structure">
                            description = <"@ internal @">
                        >
                        ["at0008"] = <
                            text = <"Θέση">
                            description = <"Η θέση του ατόμου κατά τη στιγμή της μέτρησης.">
                        >
                        ["at0011"] = <
                            text = <"Δομή λίστας">
                            description = <"Δομή λίστας.">
                        >
                        ["at0013"] = <
                            text = <"Mέγεθος περιβραχιονίου">
                            description = <"Το μέγεθος του περιβραχιονίου που χρησιμοποιείται για τη μέτρηση της αρτηριακής πίεσης.">
                        >
                        ["at0014"] = <
                            text = <"Θέση μέτρησης">
                            description = <"Απλό σημείο του σώματος όπου μετρήθηκε η αρτηριακή πίεση.">
                        >
                        ["at0015"] = <
                            text = <"Μηρός ενηλίκων">
                            description = <"Ένα περιβραχιόνιο που χρησιμοποιείται για έναν μηρό ενηλίκων.">
                        >
                        ["at0016"] = <
                            text = <"Μεγάλος ενήλικας">
                            description = <"Ένα περιβραχιόνιο για ενήλικες με μεγαλύτερα χέρια.">
                        >
                        ["at0017"] = <
                            text = <"Ενήλικας">
                            description = <"Ένα περιβραχιόνιο που είναι στάνταρ για έναν ενήλικα.">
                        >
                        ["at0025"] = <
                            text = <"Δεξιός βραχίωνας">
                            description = <"Το δεξί χέρι του ατόμου.">
                        >
                        ["at0026"] = <
                            text = <"Αριστερός βραχίωνας">
                            description = <"Ο αριστερός βραχίονας του ατόμου.">
                        >
                        ["at0027"] = <
                            text = <"Δεξιός μηρός">
                            description = <"Ο δεξιός μηρός του ατόμου.">
                        >
                        ["at0028"] = <
                            text = <"Αριστερός μηρός">
                            description = <"Ο αριστερός μηρός του ατόμου.">
                        >
                        ["at0033"] = <
                            text = <"Σχόλιο">
                            description = <"Πρόσθετη αφήγηση σχετικά με τη μέτρηση, που δεν αποτυπώνεται σε άλλα πεδία.">
                        >
                        ["at1000"] = <
                            text = <"Ορθοστασία">
                            description = <"Στέκεται κατά τη στιγμή της μέτρησης της αρτηριακής πίεσης.">
                        >
                        ["at1001"] = <
                            text = <"Καθιστή θέση">
                            description = <"Καθιστή θέση (για παράδειγμα στο κρεβάτι ή την καρέκλα) κατά τη στιγμή της μέτρησης της αρτηριακής πίεσης.">
                        >
                        ["at1002"] = <
                            text = <"Ανακλινομενη θέση">
                            description = <"Ανάκλιση κατά τη στιγμή της μέτρησης της αρτηριακής πίεσης.">
                        >
                        ["at1003"] = <
                            text = <"Ξαπλωμένη θέση">
                            description = <"Ξαπλωμένη κατά τη στιγμή της μέτρησης της αρτηριακής πίεσης.">
                        >
                        ["at1005"] = <
                            text = <"Σε κλίση">
                            description = <"Η κρανιοουραία κλίση της επιφάνειας στην οποία βρίσκεται το άτομο κατά τη στιγμή της μέτρησης.">
                        >
                        ["at1006"] = <
                            text = <"Μέση αρτηριακή πίεση">
                            description = <"Η μέση αρτηριακή πίεση που εμφανίζεται καθ 'όλη τη διάρκεια του κύκλου συστολής και χαλάρωσης της καρδιάς.">
                        >
                        ["at1007"] = <
                            text = <"Παλμική πίεση">
                            description = <"Η διαφορά μεταξύ της συστολικής και της διαστολικής πίεσης.">
                        >
                        ["at1008"] = <
                            text = <"Μικρός ενήλικας">
                            description = <"Ένα περιβραχιόνιο που χρησιμοποιείται για έναν μικρό ενήλικα.">
                        >
                        ["at1009"] = <
                            text = <"Παιδικό">
                            description = <"Ένα περιβραχιόνιο που είναι κατάλληλη για παιδί ή ενήλικα με λεπτό χέρι.">
                        >
                        ["at1010"] = <
                            text = <"Διαστολικό καταληκτικό σημείο">
                            description = <"Καταγράψτε ποιος ήχος Korotkoff χρησιμοποιείται για τον προσδιορισμό της διαστολικής πίεσης χρησιμοποιώντας ακουστική μέθοδο.">
                        >
                        ["at1011"] = <
                            text = <"Phase IV">
                            description = <"Ο τέταρτος ήχος Korotkoff αναγνωρίζεται ως ένα απότομο σιγαστήρα ήχων.">
                        >
                        ["at1012"] = <
                            text = <"Phase V">
                            description = <"Ο πέμπτος ήχος Korotkoff αναγνωρίζεται από την απουσία ήχων καθώς η πίεση της μανσέτας πέφτει κάτω από τη διαστολική αρτηριακή πίεση.">
                        >
                        ["at1014"] = <
                            text = <"Ξαπλωμένη με κλίση προς τα αριστερά">
                            description = <"Ξαπλωμένη επίπεδη με κάποια πλευρική κλίση, συνήθως υπό γωνία προς την αριστερή πλευρά. Συνήθως απαιτείται στο τελευταίο τρίμηνο της εγκυμοσύνης για την ανακούφιση της συμπίεσης της αορτοκαβάλης.">
                        >
                        ["at1018"] = <
                            text = <"Βρέφη">
                            description = <"Ένα περιβραχιόνιο για βρέφη">
                        >
                        ["at1019"] = <
                            text = <"Νεογνά">
                            description = <"Ένα περιβραχιόνιο που χρησιμοποιείται για νεογνά">
                        >
                        ["at1020"] = <
                            text = <"Δεξιός καρπός">
                            description = <"Ο δεξιός καρπός του ατόμου.">
                        >
                        ["at1021"] = <
                            text = <"Αριστερός καρπός">
                            description = <"Ο αριστερός καρπός του ατόμου.">
                        >
                        ["at1025"] = <
                            text = <"Συσκευή">
                            description = <"Λεπτομέρειες σχετικά με το σφυγμομανόμετρο ή άλλη συσκευή που χρησιμοποιείται για τη μέτρηση της αρτηριακής πίεσης.">
                        >
                        ["at1026"] = <
                            text = <"Δεξιός αστράγαλος">
                            description = <"Ο δεξιός αστράγαλος του ατόμου.">
                        >
                        ["at1030"] = <
                            text = <"*Exertion(en)">
                            description = <"*Details about physical activity undertaken at the time of blood pressure measurement.(en)">
                        >
                        ["at1031"] = <
                            text = <"Αριστερός αστράγαλος">
                            description = <"Ο αριστερός αστράγαλος του ατόμου.">
                        >
                        ["at1032"] = <
                            text = <"Δάχτυλο">
                            description = <"Ένα δάχτυλο του ατόμου.">
                        >
                        ["at1035"] = <
                            text = <"Μέθοδος">
                            description = <"Μέθοδος μέτρησης της αρτηριακής πίεσης.">
                        >
                        ["at1036"] = <
                            text = <"Ακρόαση">
                            description = <"Μέθοδος μέτρησης της αρτηριακής πίεσης εξωτερικά, χρησιμοποιώντας στηθοσκόπιο και ήχους Korotkoff">
                        >
                        ["at1037"] = <
                            text = <"Ψηλάφιση">
                            description = <"Μέθοδος μέτρησης της αρτηριακής πίεσης εξωτερικά, χρησιμοποιώντας ψηλάφηση (συνήθως των βραχιονίων ή ακτινωτών αρτηριών).">
                        >
                        ["at1038"] = <
                            text = <"Τύπος μέσης αρτηριακής πίεσης">
                            description = <"Τύπος που χρησιμοποιείται για τον υπολογισμό της μέσης αρτηριακής πίεσης (εάν καταγράφεται στα δεδομένα).">
                        >
                        ["at1039"] = <
                            text = <"Μηχανή">
                            description = <"Μέθοδος μέτρησης της αρτηριακής πίεσης εξωτερικά, χρησιμοποιώντας μια μηχανή αρτηριακής πίεσης.">
                        >
                        ["at1040"] = <
                            text = <"Επεμβατική">
                            description = <"Μέθοδος μέτρησης της αρτηριακής πίεσης εσωτερικά, δηλαδή περιλαμβάνει διείσδυση του δέρματος και μέτρηση μέσα στα αιμοφόρα αγγεία.">
                        >
                        ["at1042"] = <
                            text = <"24ωρος μέσος όρος">
                            description = <"Εκτίμηση της μέσης αρτηριακής πίεσης σε μια περίοδο 24 ωρών.">
                        >
                        ["at1043"] = <
                            text = <"Κατάσταση ύπνου">
                            description = <"Κατάσταση ύπνου - υποστηρίζει την ερμηνεία των 24ωρων περιπατητικών αρχείων αρτηριακής πίεσης">
                        >
                        ["at1044"] = <
                            text = <"Ξύπνια">
                            description = <"Το άτομο έχει πλήρη συνείδηση.">
                        >
                        ["at1045"] = <
                            text = <"Aνάπαυσης">
                            description = <"Το άτομο βρίσκεται στη φυσική κατάσταση της σωματικής ανάπαυσης.">
                        >
                        ["at1051"] = <
                            text = <"Δάχτυλο ποδιού">
                            description = <"Ένα δάχτυλο του ατόμου.">
                        >
                        ["at1052"] = <
                            text = <"Συγχυτικοί παράγοντες">
                            description = <"Σχολιάστε και καταγράψτε άλλους τυχαίους παράγοντες που μπορεί να συμβάλλουν στη μέτρηση της αρτηριακής πίεσης. Για παράδειγμα, επίπεδο άγχους ή «σύνδρομο λευκού τριχώματος». πόνος ή πυρετός. αλλαγές στην ατμοσφαιρική πίεση κ. λπ.">
                        >
                        ["at1053"] = <
                            text = <"Ενδοαρτηριακή">
                            description = <"Επεμβατική μέτρηση μέσω γραμμής πρόσβασης μορφοτροπέα εντός μιας αρτηρίας.">
                        >
                        ["at1054"] = <
                            text = <"Τύπος συστολικής πίεσης">
                            description = <"Τύπος που χρησιμοποιείται για τον υπολογισμό της συστολικής πίεσης από τη μέση αρτηριακή πίεση (εάν καταγράφεται στα δεδομένα).">
                        >
                        ["at1055"] = <
                            text = <"Τύπος διαστολικής πίεσης">
                            description = <"Τύπος που χρησιμοποιείται για τον υπολογισμό της διαστολικής πίεσης από τη μέση αρτηριακή πίεση (εάν καταγράφεται στα δεδομένα).">
                        >
                        ["at1056"] = <
                            text = <"Ράχη ποδιού">
                            description = <"Η ράχη του ατόμου του ποδιού.">
                        >
                        ["at1057"] = <
                            text = <"Δομημένη τοποθεσία μέτρησης">
                            description = <"Δομημένη ανατομική θέση του σημείου όπου έγινε η μέτρηση.">
                        >
                        ["at1058"] = <
                            text = <"*Extension(en)">
                            description = <"*Additional information required to capture local context or to align with other reference models/formalisms.(en)">
                        >
                        ["at1059"] = <
                            text = <"Κλινική ερμηνεία">
                            description = <"Μία λέξη, φράση ή σύντομη περιγραφή που αντιπροσωπεύει την κλινική έννοια και σημασία της μέτρησης της αρτηριακής πίεσης.">
                        >
                        ["ac0.1"] = <
