                    ["it"] = <
                        ["at0000"] = <
                            text = <"Temperatura corporea">
                            description = <"Una misura della temperatura corporea, che è un surrogato della temperatura corporea del corpo centrale dell'individuo. ">
                        >
                        ["at0001"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0002"] = <
                            text = <"History">
                            description = <"@ internal @">
                        >
                        ["at0003"] = <
                            text = <"Qualsiasi evento">
                            description = <"Evento predefinito, non specificato nel tempo o nell'intervallo di tempo, che può essere definito esplicitamente in un modello o in fase di esecuzione.">
                        >
                        ["at0004"] = <
                            text = <"Temperatura">
                            description = <"*The measured temperature. (en)">
