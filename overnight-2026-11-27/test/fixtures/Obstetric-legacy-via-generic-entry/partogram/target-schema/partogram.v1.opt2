                            text = <"Localització corporal">
                            description = <"Nom del lloc d'administració del producte ordenat.">
                        >
                        ["at0093"] = <
                            text = <"Localització corporal estructurada">
                            description = <"Descripció estructurada del lloc d'administració de l'element ordenat.">
                        >
                        ["at0094"] = <
                            text = <"Mètode d'administració">
                            description = <"Tècnica o dispositiu pel qual s'administrarà la medicació ordenada.">
                        >
                        ["at0095"] = <
                            text = <"Aparell d'administració">
                            description = <"Detalls del dispositiu mèdic utilitzat per assistir a l'administració de la medicació ordenada">
                        >
                        ["at0105"] = <
                            text = <"Informació del pacient">
                            description = <"Una instrucció addicional dirigida principalment a l'individu/pacient o cuidadors.">
                        >
                        ["at0106"] = <
                            text = <"Instrucció de distribució">
                            description = <"Una instrucció addicional dirigida principalment a la persona que dispensa l'element ordenat.">
                        >
                        ["at0107"] = <
                            text = <"Instruccions de monitoratge">
                            description = <"Una instrucció addicional que dona consells sobre el seguiment recomanat o requerit de l'element ordenat.">
                        >
                        ["at0112"] = <
                            text = <"Resum de la comanda">
                            description = <"Informació resumida sobre l'ús de l'element ordenat, com ara l'estat actual o les dates clau, generalment s'utilitzen en contextos de no prescripció.">
                        >
                        ["at0113"] = <
                            text = <"Detalls de la ordre">
                            description = <"Detalls sobre tota la ordre de medicaments.">
                        >
                        ["at0129"] = <
                            text = <"Instruccions de dispensació">
                            description = <"Instruccions sobre la dispensació de l'element ordenat.">
                        >
                        ["at0130"] = <
                            text = <"Quantitat màxima">
                            description = <"La quantitat màxima i acumulativa de medicació que s'hauria d'administrar en el termini permès.">
                        >
                        ["at0132"] = <
                            text = <"Instrucció de la substitució">
                            description = <"Permís de substitució amb un article bioequivalent.">
                        >
                        ["at0139"] = <
                            text = <"Prioritat">
                            description = <"Indicador de la urgència amb què s'ha de dispensar l'element ordenat.">
                        >
                        ["at0143"] = <
                            text = <"Detalls de la medicació">
                            description = <"Detalls estructurats sobre la medicació en general, incloent-hi la concentració, forma i substàncies constituents.">
                        >
                        ["at0148"] = <
                            text = <"Intenció terapèutica">
                            description = <"La intenció terapèutica general de l'element ordenat.">
                        >
                        ["at0150"] = <
                            text = <"Dosi efectiva diària total">
                            description = <"Detalls sobre la quantitat diària total de l'article ordenat que s'espera serà administrat.">
                        >
                        ["at0151"] = <
                            text = <"Quantitat diària total">
                            description = <"La quantitat d'articles ordenats que es prendran cada dia si s'administren segons el que es preveu.">
                        >
                        ["at0154"] = <
                            text = <"Motiu de no-substitució">
                            description = <"La raó per la qual un objecte ordenat no hauria de ser substituït a la dispensació.">
                        >
                        ["at0155"] = <
                            text = <"Data d'inici de la dispensació">
                            description = <"La data a partir de la qual la dispensació de l'element ordenat es permesa per primera vegada.">
                        >
                        ["at0161"] = <
                            text = <"Data de venciment de la dispensació">
                            description = <"La data després de la qual l'element ordenat ja no és vàlid per ser dispensat legalment.">
                        >
                        ["at0162"] = <
                            text = <"Motiu anul·lat">
                            description = <"Motiu per l'anul·lació d'una dosi màxima o seguretat clínica.">
                        >
                        ["at0165"] = <
                            text = <"Objectiu">
                            description = <"Descripció del motiu per al registre d'una dosi efectiva diària total.">
                        >
                        ["at0166"] = <
                            text = <"Detalls addicionals">
                            description = <"Detalls estructurats addicionals sobre l'element ordenat no capturat en altres camps.">
                        >
                        ["at0167"] = <
                            text = <"Comentaris">
                            description = <"Narrativa addicional sobre l'ordre de medicació no capturada en altres camps.">
                        >
                        ["at0168"] = <
                            text = <"Permès">
                            description = <"Es permet la substitució de la medicació amb una medicació bioequivalent.">
                        >
                        ["at0169"] = <
                            text = <"No permès">
                            description = <"No es permet la substitució de la medicació amb una medicació bioequivalent.">
                        >
                        ["at0170"] = <
                            text = <"Detalls de dispensació">
                            description = <"Més detalls relacionats amb les direccions de dispensació.">
                        >
                        ["at0171"] = <
                            text = <"Consell de seguretat anul·lat">
                            description = <"Un problema de seguretat conegut o reconegut que s'aplica a aquest tema i a l'objecte ordenat, com ara una al·lèrgia, advertència per duplicació de fàrmacs o contraindicació. Normalment, aquest element només es registra quan aquest consell de seguretat és anul·lat.">
                        >
                        ["at0173"] = <
                            text = <"Descripció d'instruccions específiques">
                            description = <"Descripció narrativa d'una part específica de les instruccions generals.">
                        >
                        ["at0174"] = <
                            text = <"Justificació de la dosificació">
                            description = <"Descripció de la justificació emprada per a calcular la quantitat d'una dosi o velocitat d'administració quan això depèn d'un altre factor.">
                        >
                        ["at0177"] = <
                            text = <"Dosi estructurada i indicacions de temps">
                            description = <"Detalls de la dosi estructurada i indicacions de temps d'administració.">
                        >
                        ["at0178"] = <
                            text = <"Anul·lació de seguretat">
                            description = <"Anul·lació d'un problema de seguretat conegut o reconegut que s'aplica a aquest tema i a l'element ordenat, com ara una al·lèrgia, avís de duplicació de fàrmacs o contraindicació.">
                        >
                        ["at0179"] = <
                            text = <"Orientació clínica">
                            description = <"Consells a futurs prescriptors/dispensadors sobre l'ordre en curs a llarg termini.">
                        >
                    >
                    ["es"] = <
                        ["at0000"] = <
                            text = <"Prescripción médica">
                            description = <"Una prescripción para un medicamento, vacuna, producto nutricional o otro producto terapéutico para un individuo específico">
                        >
                        ["at0001"] = <
                            text = <"Prescripción">
                            description = <"Detalles de la prescripción solicitada">
                        >
                        ["at0002"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0004"] = <
                            text = <"*Order identifier(en)">
                            description = <"*Unique identifier for the medication order.(en)">
                        >
                        ["at0005"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0008"] = <
                            text = <"*Extension(en)">
                            description = <"*Additional information required to capture local content or to align with other reference models/formalisms.(en)">
                        >
                        ["at0009"] = <
                            text = <"*Overall directions description(en)">
                            description = <"*Complete narrative description about how the ordered item is to be used.(en)">
                        >
                        ["at0011"] = <
                            text = <"*Order start criterion(en)">
                            description = <"*A condition which, when met, requires the commencement of administration or use.(en)">
                        >
                        ["at0012"] = <
                            text = <"*Order start date/time(en)">
                            description = <"*The date and optional time to commence use of the ordered item.(en)">
                        >
                        ["at0013"] = <
                            text = <"*Order stop date/time(en)">
                            description = <"*The date and optional time when it is planned to cease use of the ordered item.(en)">
                        >
                        ["at0016"] = <
                            text = <"*Order stop criterion(en)">
                            description = <"*A condition which, when met, requires the cessation of administration or use.(en)">
                        >
                        ["at0018"] = <
                            text = <"*Clinical indication(en)">
                            description = <"*The clinical reason for use of the ordered item.(en)">
                        >
                        ["at0044"] = <
                            text = <"*Additional instruction(en)">
                            description = <"*An additional instruction on how to use or store the ordered item.(en)">
                        >
                        ["at0047"] = <
                            text = <"*Parsable directions(en)">
                            description = <"*A parsable, computable text representation of the directions.(en)">
                        >
                        ["at0050"] = <
                            text = <"*Duration of order completed(en)">
                            description = <"*The time period during which the individual/patient has already been using the ordered item as a part of the intended whole order but prior to the issuance of this order.(en)">
                        >
                        ["at0051"] = <
                            text = <"*Maximum dose(en)">
                            description = <"*Details about the maximum, cumulative dose allowed over a defined period for the ordered item.(en)">
                        >
                        ["at0053"] = <
                            text = <"*Allowed period(en)">
                            description = <"*The period of time during which the maximum dose is calculated.(en)">
                        >
                        ["at0060"] = <
                            text = <"*Administrations completed(en)">
                            description = <"*The number of administrations of the ordered item that have been completed, as part of the intended whole order but prior to the issuance of this order.(en)">
                        >
                        ["at0062"] = <
                            text = <"*Medication safety(en)">
                            description = <"*Details about medication safety for the ordered item.(en)">
                        >
                        ["at0064"] = <
                            text = <"*Exceptional safety override?(en)">
                            description = <"*Confirmation by the prescriber that the normal dose or other safety limit has been overridden due to exceptional circumstances.(en)">
                        >
                        ["at0065"] = <
                            text = <"*Dispense amount(en)">
                            description = <"*Details about the amount of the ordered item to be dispensed.(en)">
                        >
                        ["at0069"] = <
                            text = <"*Authorisation directions(en)">
                            description = <"*Details of authorisation of the ordered item, including supporting local self-administration, issue and endorsement policies.(en)">
                        >
                        ["at0070"] = <
                            text = <"*Medication item(en)">
                            description = <"*Name of the medication, vaccine or other therapeutic/prescribable item being ordered.(en)">
                        >
                        ["at0091"] = <
                            text = <"*Route(en)">
                            description = <"*The route by which the ordered item is to be administered into the subject's body.(en)">
                        >
                        ["at0092"] = <
                            text = <"*Body site(en)">
                            description = <"*Name of the site of administration of the ordered item.(en)">
                        >
                        ["at0093"] = <
                            text = <"*Structured body site(en)">
                            description = <"*Structured description of the site of administration of the ordered item.(en)">
                        >
                        ["at0094"] = <
                            text = <"*Administration method(en)">
                            description = <"*The technique or device by which the ordered item is to be administered.(en)">
                        >
                        ["at0095"] = <
                            text = <"*Administration device(en)">
                            description = <"*Details of the medical device used to assist administration of the ordered item.(en)">
                        >
                        ["at0105"] = <
                            text = <"*Patient information(en)">
                            description = <"*An additional instruction directed primarily at the individual/patient or carers.(en)">
                        >
                        ["at0106"] = <
                            text = <"*Dispense instruction(en)">
                            description = <"*An additional instruction directed primarily at the person dispensing the ordered item.(en)">
                        >
                        ["at0107"] = <
                            text = <"*Monitoring instruction(en)">
                            description = <"*An additional instruction which gives advice on recommended or required monitoring of the ordered item.(en)">
                        >
                        ["at0112"] = <
                            text = <"*Order summary(en)">
                            description = <"*Summary information about use of the ordered item, such as current status or key dates, generally used in non-prescription contexts.(en)">
                        >
                        ["at0113"] = <
                            text = <"*Order details(en)">
                            description = <"*Details about the whole medication order.(en)">
                        >
                        ["at0129"] = <
                            text = <"*Dispense directions(en)">
                            description = <"*Directions about the dispensing of the ordered item.(en)">
                        >
                        ["at0130"] = <
                            text = <"*Maximum amount(en)">
                            description = <"*The maximum, cumulative amount of medication which should be administered within the allowed period.(en)">
                        >
                        ["at0132"] = <
                            text = <"*Substitution direction(en)">
                            description = <"*Permission for substitution with a bioequivalent item.(en)">
                        >
                        ["at0139"] = <
                            text = <"*Priority(en)">
                            description = <"*An indicator of the urgency with which the ordered item should be dispensed.(en)">
                        >
                        ["at0143"] = <
                            text = <"*Medication details(en)">
                            description = <"*Structured details about the overall medication including strength, form and constituent substances.(en)">
                        >
                        ["at0148"] = <
                            text = <"*Therapeutic intent(en)">
                            description = <"*The overall therapeutic intent of the ordered item.(en)">
                        >
                        ["at0150"] = <
                            text = <"*Total daily effective dose(en)">
                            description = <"*Details about the total daily amount of the ordered item expected to be administered.(en)">
                        >
                        ["at0151"] = <
                            text = <"*Total daily amount(en)">
                            description = <"*The amount of ordered item which will be taken each day if administered as intended.(en)">
                        >
                        ["at0154"] = <
                            text = <"*Non-substitution reason(en)">
                            description = <"*The reason why an ordered item should not be substituted at dispense.(en)">
                        >
                        ["at0155"] = <
                            text = <"*Dispensing start date(en)">
                            description = <"*The date from which the ordered item is permitted to be dispensed for the first time.(en)">
                        >
                        ["at0161"] = <
                            text = <"*Dispensing expiry date(en)">
                            description = <"*The date after which the ordered item is no longer valid to be legally dispensed.(en)">
                        >
                        ["at0162"] = <
                            text = <"*Override reason(en)">
                            description = <"*The reason for a clinical safety or maximum dose override.(en)">
                        >
                        ["at0165"] = <
                            text = <"*Purpose(en)">
                            description = <"*Description of the reason for recording a total daily effective dose.(en)">
                        >
                        ["at0166"] = <
                            text = <"*Additional details(en)">
                            description = <"*Additional structured details about the ordered item not captured in other fields.(en)">
                        >
                        ["at0167"] = <
                            text = <"*Comment(en)">
                            description = <"*Additional narrative about the medication order not captured in other fields.(en)">
                        >
                        ["at0168"] = <
                            text = <"*Permitted(en)">
                            description = <"*Substitution of the medication with a bioequivalent medication is allowed.(en)">
                        >
                        ["at0169"] = <
                            text = <"*Not permitted(en)">
                            description = <"*Substitution of the medication with a bioequivalent medication is not allowed.(en)">
                        >
                        ["at0170"] = <
                            text = <"*Dispense details(en)">
                            description = <"*Further details related to dispense directions.(en)">
                        >
                        ["at0171"] = <
                            text = <"*Overriden safety advice(en)">
                            description = <"*A known or recognised safety issue which applies to this subject and the ordered item, such as an allergy, drug duplication warning or contraindication. This element is normally only recorded when this safety advice is overridden.(en)">
                        >
                        ["at0173"] = <
                            text = <"*Specific directions description(en)">
                            description = <"*A narrative description of a specific part of overall directions.(en)">
                        >
                        ["at0174"] = <
                            text = <"*Dosage justification(en)">
                            description = <"*A description of the justification used to calculate a dose amount or administration rate where this is dependent on some other factor.(en)">
                        >
                        ["at0177"] = <
                            text = <"*Structured dose and timing directions(en)">
                            description = <"*Details of structured dose and timing directions.(en)">
                        >
                        ["at0178"] = <
                            text = <"*Safety override(en)">
                            description = <"*Overriding of a known or recognised safety issue which applies to this subject and the ordered item, such as an allergy, drug duplication warning or contraindication.(en)">
                        >
                        ["at0179"] = <
                            text = <"*Clinician guidance(en)">
                            description = <"*Advice to future prescribers/dispensers about the ongoing, long term order.(en)">
                        >
                    >
                    ["sk"] = <
                        ["at0000"] = <
                            text = <"Preskripcia">
                            description = <"Preskripcia lieku, vakcíny, dietetickej potraviny alebo iného terapeutického produktu pre identifikovaného pacienta.">
                        >
                        ["at0001"] = <
                            text = <"Preskripcia">
                            description = <"Detaily preskripcie">
                        >
                        ["at0002"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0004"] = <
                            text = <"*Order identifier(en)">
                            description = <"*Unique identifier for the medication order.(en)">
                        >
                        ["at0005"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0008"] = <
                            text = <"*Extension(en)">
                            description = <"*Additional information required to capture local content or to align with other reference models/formalisms.(en)">
                        >
                        ["at0009"] = <
                            text = <"Kompletný popis pokynov k podávaniu">
                            description = <"Kompletný popis k podávaniu preskribovanej položky">
                        >
                        ["at0011"] = <
                            text = <"*Order start criterion(en)">
                            description = <"*A condition which, when met, requires the commencement of administration or use.(en)">
                        >
                        ["at0012"] = <
                            text = <"*Order start date/time(en)">
                            description = <"*The date and optional time to commence use of the ordered item.(en)">
                        >
                        ["at0013"] = <
                            text = <"*Order stop date/time(en)">
                            description = <"*The date and optional time when it is planned to cease use of the ordered item.(en)">
                        >
                        ["at0016"] = <
                            text = <"*Order stop criterion(en)">
                            description = <"*A condition which, when met, requires the cessation of administration or use.(en)">
                        >
                        ["at0018"] = <
                            text = <"*Clinical indication(en)">
                            description = <"*The clinical reason for use of the ordered item.(en)">
                        >
                        ["at0044"] = <
                            text = <"*Additional instruction(en)">
                            description = <"*An additional instruction on how to use or store the ordered item.(en)">
                        >
                        ["at0047"] = <
                            text = <"Parsovateľné pokyny">
                            description = <"Pokyny zadané vo forme parsovateľného , vypočítateľného textu">
                        >
                        ["at0050"] = <
                            text = <"*Duration of order completed(en)">
                            description = <"*The time period during which the individual/patient has already been using the ordered item as a part of the intended whole order but prior to the issuance of this order.(en)">
                        >
                        ["at0051"] = <
                            text = <"Maximálna dávka">
                            description = <"Detaily ohľadom maximálnej kumulatívnej dávky počas definovaného časového intervalu">
                        >
                        ["at0053"] = <
                            text = <"Počas intervalu">
                            description = <"Časový interval pre výpočet maximálnej dávky">
                        >
                        ["at0060"] = <
                            text = <"*Administrations completed(en)">
                            description = <"*The number of administrations of the ordered item that have been completed, as part of the intended whole order but prior to the issuance of this order.(en)">
                        >
                        ["at0062"] = <
                            text = <"Bezpečnosť">
                            description = <"Detaily k bezpečnosti medikácie pre preskribovanú položku">
                        >
                        ["at0064"] = <
                            text = <"Výnimočné prekročenie bezpečnej dávky?">
                            description = <"Potvrdenie , že preskribujúci predpísal vyššiu dávku ako je norma, prípadne , že boli prekročené iné bezpečnostné limity kvôli výnimočným okolnostiam">
                        >
                        ["at0065"] = <
                            text = <"*Dispense amount(en)">
                            description = <"*Details about the amount of the ordered item to be dispensed.(en)">
                        >
                        ["at0069"] = <
                            text = <"*Authorisation directions(en)">
                            description = <"*Details of authorisation of the ordered item, including supporting local self-administration, issue and endorsement policies.(en)">
                        >
                        ["at0070"] = <
                            text = <"Preskribovaná položka">
                            description = <"Názov lieku /liečiva, vakcíny alebo inej preskribovanej položky">
                        >
                        ["at0091"] = <
                            text = <"Cesta podania">
                            description = <"Cesta podania predpísaná pre danú preskribovanú položku">
                        >
                        ["at0092"] = <
                            text = <"Časť tela">
                            description = <"Názov časti tela, kde má byť podaná preskribovaná položka">
                        >
                        ["at0093"] = <
                            text = <"Štrukturovaná časť tela">
                            description = <"Štrukturovaný popis časti tela , do ktorej má byť podaná preskribovaná položka">
                        >
                        ["at0094"] = <
                            text = <"Metóda podania">
                            description = <"Technika alebo zariadenie, ktorým má byť podaná preskribovaná položka">
                        >
                        ["at0095"] = <
                            text = <"Zariadenie pre podávanie">
                            description = <"Detaily zariadenia, ktoré má byť použité na podanie preskribovanej položky.">
                        >
                        ["at0105"] = <
                            text = <"*Patient information(en)">
                            description = <"*An additional instruction directed primarily at the individual/patient or carers.(en)">
                        >
                        ["at0106"] = <
                            text = <"*Dispense instruction(en)">
                            description = <"*An additional instruction directed primarily at the person dispensing the ordered item.(en)">
                        >
                        ["at0107"] = <
                            text = <"*Monitoring instruction(en)">
                            description = <"*An additional instruction which gives advice on recommended or required monitoring of the ordered item.(en)">
                        >
                        ["at0112"] = <
                            text = <"*Order summary(en)">
                            description = <"*Summary information about use of the ordered item, such as current status or key dates, generally used in non-prescription contexts.(en)">
                        >
                        ["at0113"] = <
                            text = <"*Order details(en)">
                            description = <"*Details about the whole medication order.(en)">
                        >
                        ["at0129"] = <
                            text = <"*Dispense directions(en)">
                            description = <"*Directions about the dispensing of the ordered item.(en)">
                        >
                        ["at0130"] = <
                            text = <"Maximálne množstvo">
                            description = <"Maximálna kumulatívna dávka počas definovaného časového intervalu">
                        >
                        ["at0132"] = <
                            text = <"*Substitution direction(en)">
                            description = <"*Permission for substitution with a bioequivalent item.(en)">
                        >
                        ["at0139"] = <
                            text = <"*Priority(en)">
                            description = <"*An indicator of the urgency with which the ordered item should be dispensed.(en)">
                        >
                        ["at0143"] = <
                            text = <"Detaily predpísanej položky">
                            description = <"Štrukturované detaily predpísanej položky, vrátane sily, formy a jednotlivé ingrediencie v zmesi">
                        >
                        ["at0148"] = <
                            text = <"*Therapeutic intent(en)">
                            description = <"*The overall therapeutic intent of the ordered item.(en)">
                        >
                        ["at0150"] = <
                            text = <"Celková denná dávka">
                            description = <"Detaily ohľadom celkovej dennej dávky preskribovanej položky">
                        >
                        ["at0151"] = <
                            text = <"*Total daily amount(en)">
                            description = <"*The amount of ordered item which will be taken each day if administered as intended.(en)">
                        >
                        ["at0154"] = <
                            text = <"*Non-substitution reason(en)">
                            description = <"*The reason why an ordered item should not be substituted at dispense.(en)">
                        >
                        ["at0155"] = <
                            text = <"*Dispensing start date(en)">
                            description = <"*The date from which the ordered item is permitted to be dispensed for the first time.(en)">
                        >
                        ["at0161"] = <
                            text = <"*Dispensing expiry date(en)">
                            description = <"*The date after which the ordered item is no longer valid to be legally dispensed.(en)">
                        >
                        ["at0162"] = <
                            text = <"Dôvod pre prekročenie">
                            description = <"Dôvod pre prekročenie bezpečnej dávky alebo klinickej bezpečnosti">
                        >
                        ["at0165"] = <
                            text = <"Dôvod">
                            description = <"Popis k dôvodu pre záznam k celkovej dennej efektívnej dávke">
                        >
                        ["at0166"] = <
                            text = <"*Additional details(en)">
                            description = <"*Additional structured details about the ordered item not captured in other fields.(en)">
                        >
