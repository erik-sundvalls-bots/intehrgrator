                            description = <"Yksittäinen sana, fraasi tai lyhyt kuvaus joka edustaa pulssi- tai sykelöydöksen (ml. rytmi) kliinistä merkitystä.">
                        >
                        ["at1024"] = <
                            text = <"Havaittu">
