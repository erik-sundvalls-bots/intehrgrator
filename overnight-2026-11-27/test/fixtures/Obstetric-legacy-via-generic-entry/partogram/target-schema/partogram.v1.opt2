                        ["at1052"] = <
                            text = <"Einflussfaktoren">
                            description = <"Kommentar und Aufzeichung anderer Faktoren die ggf. zu dem Ergebnis der Blutdruckmessung beitragen können. Die kann z.B. bei belastenden Situationen der Fall sein (z.B. sog. Weißkittelhypertonie, Schmerzen, Fieber, Änderungen im atmosphärischen Druck).">
                        >
                        ["at1053"] = <
                            text = <"Intraarteriell">
                            description = <"Invasive Messung mittels Transducer über einen arteriellen Zugang.">
                        >
                        ["at1054"] = <
                            text = <"Formel für systolischen Druck">
                            description = <"Formel, die benutzt wurde, um den systolischen Druck vom mittleren arteriellen Druck zu berechnen (wenn erfasst).">
                        >
                        ["at1055"] = <
                            text = <"Formel für diastolischen Druck">
                            description = <"Formel, die benutzt wurde, um den distolischen Druck vom mittleren arteriellen Druck zu berechnen (wenn erfasst).">
                        >
                        ["at1056"] = <
                            text = <"Fußrücken">
                            description = <"Fußrücken des Individuums.">
                        >
                        ["at1057"] = <
                            text = <"Strukturierte Stelle der Messung">
                            description = <"Strukturierte Körperstelle an der der Blutdruck gemessen wurde.">
                        >
                        ["at1058"] = <
                            text = <"Erweiterung">
                            description = <"Zusätzliche Information, die für die Erfassung des lokalen Kontexts oder für die Anpassung an andere Referenzmodelle/Formalismen benötigt wird.">
                        >
                        ["at1059"] = <
                            text = <"Klinische Interpretation">
                            description = <"Einzelnes Wort, Ausdruck oder Kurzbeschreibung der klinischen Bedeutung und Aussagekraft der Blutdruckmessung.">
                        >
                        ["ac0.1"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.2"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.3"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.4"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.5"] = <
                            text = <"*(Synthesized) (en)">
                        >
                        ["ac0.6"] = <
                            text = <"*(Synthesized) (en)">
                        >
