                            description = <"Detaljer om sfygmomanometer eller annan utrustning som används för att mäta blodtrycket.">
                        >
                        ["at1026"] = <
                            text = <"Höger ankel">
                            description = <"Individens högra ankel.">
                        >
                        ["at1030"] = <
