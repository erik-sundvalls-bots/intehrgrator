                        >
                        ["at0016"] = <
                            text = <"بزرگسال درشت">
                            description = <"کاف بزرگسالان با برآمدگی بازوی بزرگتر در حدود 16 در 38 سانتیمتر">
                        >
                        ["at0017"] = <
                            text = <"*Adult(en)">
                            description = <"*A cuff that is standard for an adult - bladder approx 13cm x 30cm.(en)">
                        >
