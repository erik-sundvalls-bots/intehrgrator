component_terminologies
<
            ["Care unit v2"] = <
                term_definitions = <
                    ["en"] = <
                        ["at0000"] = <
                            text = <"Organisation">
                            description = <"An entity comprising one or more people and having a particular purpose.">
                        >
                        ["at0001"] = <
                            text = <"Name">
                            description = <"The unstructured name or label for the organisation.">
                        >
                        ["at0002"] = <
                            text = <"Contact person">
                            description = <"Details about one or more people within the organisation.">
                        >
                        ["at0003"] = <
                            text = <"Identifier">
                            description = <"Identifier associated with the organisation.">
                        >
                        ["at0004"] = <
                            text = <"Role">
                            description = <"The relationship or role of the organisation to the individual or subject of care.">
                        >
                        ["at0005"] = <
                            text = <"Address">
                            description = <"Details about an address for the organisation.">
                        >
                        ["at0017"] = <
                            text = <"Additional details">
                            description = <"Additional details about the organisation.">
                        >
                        ["at0019"] = <
                            text = <"Comment">
                            description = <"Additional narrative about the organisation not captured in other fields.">
                        >
                        ["at0021"] = <
                            text = <"Parent organisation">
                            description = <"A larger organisation of which this organisation is a child or subsidiary.">
                        >
                        ["at0022"] = <
                            text = <"Electronic communication">
                            description = <"Details about one or more types of electronic communication for the organisation.">
                        >
                        ["at0000.1"] = <
                            text = <"Care unit">
                            description = <"An entity comprising one or more people and having a particular purpose.
In this context, the care unit is an organizational unit that provides health care.
">
                        >
                        ["at0003.1"] = <
                            text = <"Identifier">
                            description = <"Identifier associated with the organisation.
In this context, the identifier of the care unit.">
                        >
                        ["at0004.1"] = <
                            text = <"Role">
                            description = <"The relationship or role of the organisation to the individual or subject of care.
In this context, the role states that the organisation is of the type care unit.">
                        >
                        ["at0001.1"] = <
                            text = <"Name">
                            description = <"The unstructured name or label for the organisation. In this context, the name of the care unit.">
                        >
                    >
                    ["nb"] = <
                        ["at0000"] = <
                            text = <"Organisasjon">
                            description = <"En entitet som består av ett eller flere mennesker med et bestemt formål.">
                        >
                        ["at0001"] = <
                            text = <"Navn">
                            description = <"Ustrukturert navn for organisasjonen.">
                        >
                        ["at0002"] = <
                            text = <"Kontaktperson">
                            description = <"Detaljer om én eller flere personer i organisasjonen.">
                        >
                        ["at0003"] = <
                            text = <"Identifikator">
                            description = <"Identifikator for organisasjonen.">
                        >
                        ["at0004"] = <
                            text = <"Rolle">
                            description = <"Forholdet eller rollen organisasjonen har til individet som pasientjournalen omhandler.">
                        >
                        ["at0005"] = <
                            text = <"Adresse">
                            description = <"Detaljer om organisasjonens adresse.">
                        >
                        ["at0017"] = <
                            text = <"Ytterligere detaljer">
                            description = <"Ytterligere strukturerte detaljer om organisasjonen.">
                        >
                        ["at0019"] = <
                            text = <"Kommentar">
                            description = <"Ytterligere fritekst om organisasjonen som ikke er registrert i andre felt.">
                        >
                        ["at0021"] = <
                            text = <"Overordnet organisasjon">
                            description = <"En større organisasjon som denne organisasjonen er en del av.">
                        >
                        ["at0022"] = <
                            text = <"Elektronisk kommunikasjon">
                            description = <"Detaljer om én eller flere former for elektronisk kommunikasjon med organisasjonen.">
                        >
                    >
                    ["de"] = <
                        ["at0000"] = <
                            text = <"Organisation">
                            description = <"Eine Einheit, die aus einer oder mehreren Personen besteht und ein bestimmtes Ziel hat.">
                        >
                        ["at0001"] = <
                            text = <"Namenszeile">
                            description = <"Der Name oder Bezeichnung der Organisation in unstrukturierter Form.">
                        >
                        ["at0002"] = <
                            text = <"Kontaktperson">
                            description = <"Details zu einer oder mehreren Personen innerhalb der Organisation.">
                        >
                        ["at0003"] = <
                            text = <"Identifier">
                            description = <"Identifikator, der der identifizierten Organisation zugeordnet ist.">
                        >
                        ["at0004"] = <
                            text = <"Funktion">
                            description = <"Die Beziehung oder Rolle der Organisation zum Pflegebedürftigen oder Patient.">
                        >
                        ["at0005"] = <
                            text = <"Adresse">
                            description = <"Angaben zu einer Adresse der Organisation.">
                        >
                        ["at0017"] = <
                            text = <"Zusätzliche Details">
                            description = <"Weitere Angaben zur Organisation.">
                        >
                        ["at0019"] = <
                            text = <"Kommentar">
                            description = <"Zusätzlicher Text zu der Organisation, der in anderen Bereichen nicht erfasst wird.">
                        >
                        ["at0021"] = <
                            text = <"Muttergesellschaft">
                            description = <"Eine größere Organisation, von der diese Organisation ein Sub- oder Tochterunternehmen ist.">
                        >
                        ["at0022"] = <
                            text = <"Elektronische Kommunikation">
                            description = <"Details zu einer oder mehreren Arten der elektronischen Kommunikation für die Organisation.">
                        >
                    >
                    ["sv"] = <
                        ["at0000"] = <
                            text = <"Organisation">
                            description = <"En organisatorisk entitet som består av en eller flera personer och som har ett särskilt syfte.">
                        >
                        ["at0001"] = <
                            text = <"Namn">
                            description = <"Namnet som en organisation är känd under.">
                        >
                        ["at0002"] = <
                            text = <"Kontaktperson">
                            description = <"Uppgifter om en eller flera kontaktpersoner inom organisationen.">
                        >
                        ["at0003"] = <
                            text = <"Identifierare">
                            description = <"Identifierare associerad med organisationen.">
                        >
                        ["at0004"] = <
                            text = <"Roll">
                            description = <"Organisationens relation till eller roll gentemot vårdtagaren.">
                        >
                        ["at0005"] = <
                            text = <"Adress">
                            description = <"Organisationens adressuppgifter.">
                        >
                        ["at0017"] = <
                            text = <"Ytterligare detaljer">
                            description = <"Ytterligare uppgifter om organisationen.">
                        >
                        ["at0019"] = <
                            text = <"Kommentar">
                            description = <"Kommentarer avseende organisationen som inte beskrivs i övriga datafält.">
                        >
                        ["at0021"] = <
                            text = <"Överordnad organisation">
                            description = <"Den större organisation som denna organisation är en del i.">
                        >
                        ["at0022"] = <
                            text = <"Elektronisk kommunikation">
                            description = <"Ett eller flera elektroniska kommunikationssätt som organisationen använder.">
                        >
                        ["at0000.1"] = <
                            text = <"Vårdenhet">
                            description = <"En enhet bestående av en eller flera personer och har ett särskilt syfte.
I denna kontext är vårdenhet en organisatorisk enhet som tillhandahåller hälso- och sjukvård.">
                        >
                        ["at0003.1"] = <
                            text = <"Identifierare">
                            description = <"Identifierare associerad med den identifierade organisationen.
I denna kontext avses vårdenhetens identifierare.
">
                        >
                        ["at0004.1"] = <
                            text = <"Roll">
                            description = <"Den roll eller kapacitet i vilken organisationen bidrar till vårdpersonens hälsa eller sociala vård.
I denna kontext anger rollen att organisationen är av typ vårdenhet.">
                        >
                        ["at0001.1"] = <
                            text = <"Namn">
                            description = <"Namnet som en organisation är känd för.
I denna kontext avses vårdenhetens namn.">
                        >
                    >
                >
            >
            ["Medication order.partogram"] = <
                term_definitions = <
                    ["en"] = <
                        ["at0000"] = <
                            text = <"Medication order">
                            description = <"An order for a medication, vaccine, nutritional product or other therapeutic item for an identified individual.">
                        >
                        ["at0001"] = <
                            text = <"Order">
                            description = <"Details of the requested order.">
                        >
                        ["at0002"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0004"] = <
                            text = <"Order identifier">
                            description = <"Unique identifier for the medication order.">
                        >
                        ["at0005"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0008"] = <
                            text = <"Extension">
                            description = <"Additional information required to capture local content or to align with other reference models/formalisms.">
                        >
                        ["at0009"] = <
                            text = <"Overall directions description">
                            description = <"Complete narrative description about how the ordered item is to be used.">
                        >
                        ["at0011"] = <
                            text = <"Order start criterion">
                            description = <"A condition which, when met, requires the commencement of administration or use.">
                        >
                        ["at0012"] = <
                            text = <"Order start date/time">
                            description = <"The date and optional time to commence use of the ordered item.">
                        >
                        ["at0013"] = <
                            text = <"Order stop date/time">
                            description = <"The date and optional time when it is planned to cease use of the ordered item.">
                        >
                        ["at0016"] = <
                            text = <"Order stop criterion">
                            description = <"A condition which, when met, requires the cessation of administration or use.">
                        >
                        ["at0018"] = <
                            text = <"Clinical indication">
                            description = <"The clinical reason for use of the ordered item.">
                        >
                        ["at0044"] = <
                            text = <"Additional instruction">
                            description = <"An additional instruction on how to use or store the ordered item.">
                        >
                        ["at0047"] = <
                            text = <"Parsable directions">
                            description = <"A parsable, computable text representation of the directions.">
                        >
                        ["at0050"] = <
                            text = <"Duration of order completed">
                            description = <"The time period during which the individual/patient has already been using the ordered item as a part of the intended whole order but prior to the issuance of this order.">
                        >
                        ["at0051"] = <
                            text = <"Maximum dose">
                            description = <"Details about the maximum, cumulative dose allowed over a defined period for the ordered item.">
                        >
                        ["at0053"] = <
                            text = <"Allowed period">
                            description = <"The period of time during which the maximum dose is calculated.">
                        >
                        ["at0060"] = <
                            text = <"Administrations completed">
                            description = <"The number of administrations of the ordered item that have been completed, as part of the intended whole order but prior to the issuance of this order.">
                        >
                        ["at0062"] = <
                            text = <"Medication safety">
                            description = <"Details about medication safety for the ordered item.">
                        >
                        ["at0064"] = <
                            text = <"Exceptional safety override?">
                            description = <"Confirmation by the prescriber that the normal dose or other safety limit has been overridden due to exceptional circumstances.">
                        >
                        ["at0065"] = <
                            text = <"Dispense amount">
                            description = <"Details about the amount of the ordered item to be dispensed.">
                        >
                        ["at0069"] = <
                            text = <"Authorisation directions">
                            description = <"Details of authorisation of the ordered item, including supporting local self-administration, issue and endorsement policies.">
                        >
                        ["at0070"] = <
                            text = <"Medication item">
                            description = <"Name of the medication, vaccine or other therapeutic/prescribable item being ordered.">
                        >
                        ["at0091"] = <
                            text = <"Route">
                            description = <"The route by which the ordered item is to be administered into the subject's body.">
                        >
                        ["at0092"] = <
                            text = <"Body site">
                            description = <"Name of the site of administration of the ordered item.">
                        >
                        ["at0093"] = <
                            text = <"Structured body site">
                            description = <"Structured description of the site of administration of the ordered item.">
                        >
                        ["at0094"] = <
                            text = <"Administration method">
                            description = <"The technique or device by which the ordered item is to be administered.">
                        >
                        ["at0095"] = <
                            text = <"Administration device">
                            description = <"Details of the medical device used to assist administration of the ordered item.">
                        >
                        ["at0105"] = <
                            text = <"Patient information">
                            description = <"An additional instruction directed primarily at the individual/patient or carers.">
                        >
                        ["at0106"] = <
                            text = <"Dispense instruction">
                            description = <"An additional instruction directed primarily at the person dispensing the ordered item.">
                        >
                        ["at0107"] = <
                            text = <"Monitoring instruction">
                            description = <"An additional instruction which gives advice on recommended or required monitoring of the ordered item.">
                        >
                        ["at0112"] = <
                            text = <"Order summary">
                            description = <"Summary information about use of the ordered item, such as current status or key dates, generally used in non-prescription contexts.">
                        >
                        ["at0113"] = <
                            text = <"Order details">
                            description = <"Details about the whole medication order.">
                        >
                        ["at0129"] = <
                            text = <"Dispense directions">
                            description = <"Directions about the dispensing of the ordered item.">
                        >
                        ["at0130"] = <
                            text = <"Maximum amount">
                            description = <"The maximum, cumulative amount of medication which should be administered within the allowed period.">
                        >
                        ["at0132"] = <
                            text = <"Substitution direction">
                            description = <"Permission for substitution with a bioequivalent item.">
                        >
                        ["at0139"] = <
                            text = <"Priority">
                            description = <"An indicator of the urgency with which the ordered item should be dispensed.">
                        >
                        ["at0143"] = <
                            text = <"Medication details">
                            description = <"Structured details about the overall medication including strength, form and constituent substances.">
                        >
                        ["at0148"] = <
                            text = <"Therapeutic intent">
                            description = <"The overall therapeutic intent of the ordered item.">
                        >
                        ["at0150"] = <
                            text = <"Total daily effective dose">
                            description = <"Details about the total daily amount of the ordered item expected to be administered.">
                        >
                        ["at0151"] = <
                            text = <"Total daily amount">
                            description = <"The amount of ordered item which will be taken each day if administered as intended.">
                        >
                        ["at0154"] = <
                            text = <"Non-substitution reason">
                            description = <"The reason why an ordered item should not be substituted at dispense.">
                        >
                        ["at0155"] = <
                            text = <"Dispensing start date">
                            description = <"The date from which the ordered item is permitted to be dispensed for the first time.">
                        >
                        ["at0161"] = <
                            text = <"Dispensing expiry date">
                            description = <"The date after which the ordered item is no longer valid to be legally dispensed.">
                        >
                        ["at0162"] = <
                            text = <"Override reason">
                            description = <"The reason for a clinical safety or maximum dose override.">
                        >
                        ["at0165"] = <
                            text = <"Purpose">
                            description = <"Description of the reason for recording a total daily effective dose.">
                        >
                        ["at0166"] = <
                            text = <"Additional details">
                            description = <"Additional structured details about the ordered item not captured in other fields.">
                        >
                        ["at0167"] = <
