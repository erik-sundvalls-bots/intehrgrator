                            description = <"Informació addicional requerida per capturar contingut local o per alinear-se amb altres models de referència/formalismes.">
                        >
                        ["at1057"] = <
                            text = <"Interpretació clínica">
                            description = <"Etiqueta genèrica per permetre qualsevol o totes les declaracions sobre el pols o el batec del cor.">
                        >
                        ["at1058"] = <
                            text = <"Rhythm">
                            description = <"Conclusió específica sobre el ritme del pols o batec cardíac, extret d'una combinació de la freqüència cardíaca, patró i altres característiques observades en l'examen.">
