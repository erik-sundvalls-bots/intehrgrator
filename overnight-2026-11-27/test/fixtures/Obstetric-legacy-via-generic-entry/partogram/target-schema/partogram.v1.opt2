                    ["fi"] = <
                        ["at0000"] = <
                            text = <"Verenpaine">
                            description = <"Paikallisen valtimopaineen mittaustulos, joka toimii korvikkeena systeemisen verenkierron valtimopaineelle. Termillä \"verenpaine\" viitataan yleensä olkavarresta tehtävään olkavarsivaltimon paineen mittaustulokseen.">
                        >
                        ["at0001"] = <
                            text = <"Historia">
                            description = <"Historia-rakennesolmu.">
                        >
                        ["at0003"] = <
                            text = <"blood pressure">
                            description = <"@ internal @">
                        >
                        ["at0004"] = <
                            text = <"Systolinen">
                            description = <"Systeemisen verenkierron valtimoverenpaineen huippuarvo – mitataan sydämen supistumisvaiheessa.">
                        >
                        ["at0005"] = <
                            text = <"Diastolinen">
                            description = <"Systeemisen verenkierron valtimoverenpaineen pienin arvo – mitataan sydämen lepovaiheessa.">
                        >
                        ["at0006"] = <
                            text = <"Mikä tahansa tapahtuma">
                            description = <"Oletusarvo, määrittämätön ajanhetki tai aikaväli, joka voidaan nimenomaisesti määritellä templaatilla tai suorituksen aikana.">
                        >
                        ["at0007"] = <
                            text = <"state structure">
                            description = <"@ internal @">
                        >
                        ["at0008"] = <
                            text = <"Asento">
                            description = <"Henkilön asento mittaushetkellä.">
                        >
                        ["at0011"] = <
                            text = <"Puu">
                            description = <"Luettelon rakenne.">
                        >
                        ["at0013"] = <
                            text = <"Mansetin koko">
                            description = <"Verenpaineen mittauksessa käytetyn mansetin koko.">
                        >
                        ["at0014"] = <
                            text = <"Mittauskohta">
                            description = <"Kehon yksinkertaisesti ilmaistu kohta, josta verenpaine mitattiin.">
                        >
                        ["at0015"] = <
                            text = <"Aikuisen reisi">
                            description = <"Aikuisen reidessä käytettävä mansetti.">
                        >
                        ["at0016"] = <
                            text = <"Aikuiset, suuri">
                            description = <"Mansetti aikuisille, joilla on paksut käsivarret.">
                        >
                        ["at0017"] = <
                            text = <"Aikuinen">
                            description = <"Standardikokoinen mansetti aikuisille.">
                        >
                        ["at0025"] = <
                            text = <"Oikea käsivarsi">
                            description = <"Henkilön oikea käsivarsi.">
                        >
                        ["at0026"] = <
                            text = <"Vasen käsivarsi">
                            description = <"Henkilön vasen käsivarsi.">
                        >
                        ["at0027"] = <
                            text = <"Oikea reisi">
                            description = <"Henkilön oikea reisi.">
                        >
                        ["at0028"] = <
                            text = <"Vasen reisi">
                            description = <"Henkilön vasen reisi.">
                        >
                        ["at0033"] = <
                            text = <"Kommentti">
                            description = <"Mittauksen kertomusmuodossa olevat lisätiedot, joita ei voida ilmoittaa muissa kentissä.">
                        >
                        ["at1000"] = <
                            text = <"Seisten">
                            description = <"Verenpaine mitataan henkilön seistessä.">
                        >
                        ["at1001"] = <
                            text = <"Istuen">
                            description = <"Verenpaine mitataan henkilön istuessa (esimerkiksi vuoteella tai tuolissa).">
                        >
                        ["at1002"] = <
                            text = <"Taaksepäin nojaten">
                            description = <"Verenpaine mitataan henkilön nojatessa taaksepäin.">
                        >
                        ["at1003"] = <
                            text = <"Makuulla">
                            description = <"Verenpaine mitataan henkilön maatessa.">
                        >
                        ["at1005"] = <
                            text = <"Kallistuma">
                            description = <"Kraniokaudaalinen kallistuma alustalla, jolla henkilö makaa mittauksen aikana.">
                        >
                        ["at1006"] = <
                            text = <"Keskivaltimopaine">
                            description = <"Keskiarvo valtimopaineesta, joka ilmenee sydämen supistumis- ja rentoutumissyklin aikana.">
                        >
                        ["at1007"] = <
                            text = <"Pulssipaine">
                            description = <"Systolisen ja diastolisen paineen erotus.">
                        >
                        ["at1008"] = <
                            text = <"Aikuiset, pieni">
                            description = <"Pienikokoiselle aikuiselle käytettävä mansetti.">
                        >
                        ["at1009"] = <
                            text = <"Pediatrinen/lapsi">
                            description = <"Mansetti, joka sopii lapselle tai ohutkäsivartiselle aikuiselle.">
                        >
                        ["at1010"] = <
                            text = <"Diastolinen päätetapahtuma">
                            description = <"Tieto siitä, minkä Korotkoffin äänen perusteella diastolinen paine määritetään auskultoitaessa.">
                        >
                        ["at1011"] = <
                            text = <"Vaihe IV">
                            description = <"Neljäs Korotkoffin ääni määrittään äänien äkilliseksi heikkenemiseksi.">
                        >
                        ["at1012"] = <
                            text = <"Vaihe V">
                            description = <"Viides Korotkoffin ääni määritetään äänien kuulumisen lakkaamiseksi, kun mansetin paine laskee diastolisen verenpaineen alapuolelle.">
                        >
                        ["at1014"] = <
                            text = <"Makuulla vasemmalle kallellaan">
                            description = <"Makuulla, hiukan kallellaan kyljen suunnassa, yleensä vasemmalle. Tarvitaan yleensä viimeisellä raskauskolmanneksella supiinioireyhtymän helpottamiseksi.">
                        >
                        ["at1018"] = <
                            text = <"Vauva">
                            description = <"Vauvoille käytettävä mansetti.">
                        >
                        ["at1019"] = <
                            text = <"Vastasyntynyt">
                            description = <"Vastasyntyneille käytettävä mansetti, mikäli mansetti on oikean kokoinen vastasyntyneen kokoon ja kehitystasoon nähden.">
                        >
                        ["at1020"] = <
                            text = <"Oikea ranne">
                            description = <"Tutkittavan oikea ranne.">
                        >
                        ["at1021"] = <
                            text = <"Vasen ranne">
                            description = <"Tutkittavan vasen ranne.">
                        >
                        ["at1025"] = <
                            text = <"Laite">
                            description = <"Tiedot sfygmomanometrista tai muusta laitteesta, jolla verenpaine mitataan.">
                        >
                        ["at1026"] = <
                            text = <"Oikea nilkka">
                            description = <"Tutkittavan oikea nilkka.">
                        >
                        ["at1030"] = <
                            text = <"Rasitus">
                            description = <"Tiedot fyysisestä rasituksesta, jolle tutkittava altistettiin verenpaineen mittauksen aikana.">
                        >
                        ["at1031"] = <
                            text = <"Vasen nilkka">
                            description = <"Tutkittavan vasen nilkka.">
                        >
                        ["at1032"] = <
                            text = <"Sormi">
                            description = <"Tutkittavan sormi.">
                        >
                        ["at1035"] = <
                            text = <"Menetelmä">
                            description = <"Verenpaineen mittausmenetelmä.">
                        >
                        ["at1036"] = <
                            text = <"Auskultaatio">
                            description = <"Menetelmä, jolla verenpaine mitataan ulkoisesti käyttämällä stetoskooppia ja Korotkoffin ääniä.">
                        >
                        ["at1037"] = <
                            text = <"Palpaatio">
                            description = <"Menetelmä, jolla verenpaine mitataan ulkoisesti palpoimalla (yleensä olkavarsi- tai värttinävaltimosta).">
                        >
                        ["at1038"] = <
                            text = <"Keskivaltimopaineen kaava">
                            description = <"Keskivaltimopaineen laskennassa käytettävä kaava (jos kirjattu tietoihin).">
                        >
                        ["at1039"] = <
                            text = <"Kone">
                            description = <"Menetelmä, jolla verenpaine mitataan ulkoisesti koneella.">
                        >
                        ["at1040"] = <
                            text = <"Invasiivinen">
                            description = <"Menetelmä, jolla verenpaine mitataan sisäisesti, eli ihon läpi tunkeutuen ja verisuonen sisältä.">
                        >
                        ["at1042"] = <
                            text = <"24 tunnin keskiarvo">
                            description = <"Arvio verenpaineen keskiarvosta 24 tunnin ajanjaksona.">
                        >
                        ["at1043"] = <
                            text = <"Unitila">
                            description = <"Unitila – tukee 24 tunnin ambulatorisen verenpainemittauksen tulosten tulkintaa.">
                        >
                        ["at1044"] = <
                            text = <"Valpas ja hereillä">
                            description = <"Tutkittava on täysin tajuissaan.">
                        >
                        ["at1045"] = <
                            text = <"Nukkuu">
                            description = <"Tutkittavan keho on luonnollisessa lepotilassa.">
                        >
                        ["at1051"] = <
                            text = <"Varvas">
                            description = <"Tutkittavan varvas.">
                        >
                        ["at1052"] = <
                            text = <"Sekoittavat tekijät">
                            description = <"Kommentoi ja kirjaa muita satunnaistekijöitä, jotka saattavat vaikuttaa verenpaineen mittaukseen. Esimerkiksi ahdistuneisuus tai \"valkotakkiverenpaine\", kipu tai kuume; ilmanpaineen muutokset, jne.">
                        >
                        ["at1053"] = <
                            text = <"Valtimonsisäinen">
                            description = <"Invasiivinen mittaus valtimoon sijoitetulla katetrinpääanturilla.">
                        >
                        ["at1054"] = <
                            text = <"Systolisen paineen kaava">
                            description = <"Kaava jota käytetään systolisen paineen laskemiseen keskivaltimopaineesta (jos kirjattu tietoihin).">
                        >
                        ["at1055"] = <
                            text = <"Diastolisen paineen kaava">
                            description = <"Kaava jota käytetään diastolisen paineen laskemiseen keskivaltimopaineesta (jos kirjattu tietoihin).">
                        >
                        ["at1056"] = <
                            text = <"Jalanselkä">
                            description = <"Tutkittavan jalanselkä.">
                        >
                        ["at1057"] = <
                            text = <"Rakenteellinen mittauskohta">
                            description = <"Rakenteellinen anatominen kohta, josta mittaus tehtiin.">
                        >
                        ["at1058"] = <
                            text = <"Laajennus">
                            description = <"Lisätiedot, joita tarvitaan paikallisen asiayhteyden kirjaamiseksi tai yhtenäistämiseksi muiden viitemallien tai formalismien kanssa.">
                        >
                        ["at1059"] = <
                            text = <"Kliininen tulkinta">
                            description = <"Yksittäinen sana, lause tai lyhyt kuvaus, joka edustaa verenpaineen mittauksen kliinistä merkitystä.">
                        >
                        ["ac0.1"] = <
