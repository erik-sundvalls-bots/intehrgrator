                            description = <"L'artèria femoral esquerra.">
                        >
                        ["at1044"] = <
                            text = <"Artèria Femoral - Dreta">
                            description = <"L'artèria femoral dreta.">
                        >
                        ["at1047"] = <
                            text = <"Dit">
                            description = <"Un dit no especificat.">
                        >
                        ["at1048"] = <
                            text = <"Artèria braquial - Esquerra">
                            description = <"L'artèria braquial esquerra.">
                        >
                        ["at1049"] = <
                            text = <"Artèria braquial - Dreta">
                            description = <"L'artèria braquial dreta.">
                        >
                        ["at1050"] = <
                            text = <"Automàtic, invasiu">
                            description = <"Els resultats s'observen de manera invasiva utilitzant un dispositiu com un catèter arterial.">
                        >
                        ["at1051"] = <
                            text = <"Lòbul de l'or">
                            description = <"El lòbul d'una orella no especificada.">
                        >
                        ["at1054"] = <
                            text = <"To">
