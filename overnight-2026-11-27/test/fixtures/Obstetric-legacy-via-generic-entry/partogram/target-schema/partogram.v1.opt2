                            description = <"Descripción estructurada del sitio de administración del ítem ordenado.">
                        >
                        ["at0094"] = <
                            text = <"Método de administración">
                            description = <"La técnica o dispositivo mediante el cual el ítem ordenado será administrado.">
                        >
                        ["at0095"] = <
