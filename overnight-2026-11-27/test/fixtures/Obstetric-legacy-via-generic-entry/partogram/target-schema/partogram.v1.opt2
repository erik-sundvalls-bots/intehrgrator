                        ["at0170"] = <
                            text = <"*Dispense details(en)">
                            description = <"*Further details related to dispense directions.(en)">
                        >
                        ["at0171"] = <
                            text = <"Odporúčanie pre prekročenie">
                            description = <"Prekročenie známej alebo rozpoznanej bezpečnosti pri preskribovaní položky danému pacientovi , ako napr. alergia, opakované podanie alebo kontraindikácia. Tento element bude vyplnený iba v prípade, že je prekročená bezpečnosť">
                        >
                        ["at0173"] = <
                            text = <"Popis všeobecných pokynov k podávaniu">
                            description = <"Popis špecifickej časti pokynov voľným textom">
                        >
                        ["at0174"] = <
                            text = <"Oddôvodnenie dávkovania">
                            description = <"Popis oddôvodnenia pre výočet veľkosti dávky alebo rýchlosti podania , v prípade, že to závisí od nejakých iných faktorov">
                        >
                        ["at0177"] = <
                            text = <"Štrukturované dávkovanie a časy podania">
                            description = <"Detaily pre štrukturované dávkovanie a časy podania">
                        >
                        ["at0178"] = <
                            text = <"Prekročenie bezpečnej dávky">
                            description = <"Prekročenie známej alebo rozpoznanej bezpečnosti pri preskribovaní položky danému pacientovi , ako napr. alergia, opakované podanie alebo kontraindikácia">
                        >
                        ["at0179"] = <
                            text = <"*Clinician guidance(en)">
