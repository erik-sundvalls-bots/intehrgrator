                            description = <"*The colour of the body fluid. (en)">
                        >
                        ["at0021"] = <
                            text = <"Blodkoagel">
                            description = <"*Blood clots are observed within or associated with the body fluid. (en)">
                        >
                        ["at0022"] = <
                            text = <"Blod">
                            description = <"*The qualitative amount of blood observed in the body fluid. (en)">
                        >
                        ["at0023"] = <
