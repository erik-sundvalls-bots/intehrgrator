                            text = <"Träd">
                            description = <"Liststruktur">
                        >
                        ["at0013"] = <
                            text = <"Manschettstorlek">
                            description = <"Storleken på manschetten som används för blodtrycksmätning.">
                        >
                        ["at0014"] = <
                            text = <"Mätställe">
                            description = <"Beskrivning av anatomiskt ställe där blodtrycket mäts.">
                        >
                        ["at0015"] = <
                            text = <"Vuxet lår">
                            description = <"En lårmanschett för vuxna.">
                        >
                        ["at0016"] = <
                            text = <"Stor vuxen">
                            description = <"En manschett för vuxna med kraftigare armar.">
                        >
                        ["at0017"] = <
                            text = <"Vuxen">
                            description = <"En standardmanschett för vuxna.">
                        >
                        ["at0025"] = <
                            text = <"Höger arm">
                            description = <"Individens högra arm.">
                        >
                        ["at0026"] = <
                            text = <"Vänster arm">
                            description = <"Individens vänstra arm.">
                        >
                        ["at0027"] = <
                            text = <"Höger lår">
                            description = <"Individens högra lår.">
                        >
                        ["at0028"] = <
                            text = <"Vänster lår">
                            description = <"Individens vänstra lår.">
                        >
                        ["at0033"] = <
                            text = <"Kommentar">
                            description = <"Ytterligare beskrivning av mätningen som inte beskrivits i andra fält.">
                        >
                        ["at1000"] = <
                            text = <"Stående">
                            description = <"Stående upprätt under blodtrycksmätningen.">
                        >
                        ["at1001"] = <
                            text = <"Sittande">
                            description = <"Sittande ställning under blodtrycksmätningen, exempelvis på en säng eller stol.">
                        >
                        ["at1002"] = <
                            text = <"Halvliggande">
                            description = <"Halvliggande ställning under blodtrycksmätningen.">
                        >
                        ["at1003"] = <
                            text = <"Liggande">
                            description = <"Liggande raklång under blodtrycksmätningen.">
                        >
                        ["at1005"] = <
                            text = <"Lutning">
                            description = <"Lutning vid huvudet på ytan som individen ligger på vid tidpunkten för mätningen.">
                        >
                        ["at1006"] = <
                            text = <"Medelartärtryck">
                            description = <"Det genomsnittliga systemartärtrycket under hela hjärtcykeln, det vill säga under både sammandragningsfas och avslappningsfas.">
                        >
                        ["at1007"] = <
                            text = <"Pulstryck">
                            description = <"Differensen mellan systoliskt och diastoliskt blodtryck.">
                        >
                        ["at1008"] = <
                            text = <"Liten Vuxen">
                            description = <"En manschett för vuxna med smalare armar.">
                        >
                        ["at1009"] = <
                            text = <"Pediatrisk/Barn">
                            description = <"En manschett för barn eller vuxna med smala armar.">
                        >
                        ["at1010"] = <
                            text = <"Diastoliskt effektmått">
                            description = <"Registrerat Korotkoff-ljud som används för att avgöra diastoliskt tryck med hjälp av auskultatorisk metod.">
                        >
                        ["at1011"] = <
                            text = <"Fas IV">
                            description = <"Det fjärde Korotkoff-ljudet identifieras som en plötslig ljuddämpning.">
                        >
                        ["at1012"] = <
                            text = <"Fas V">
                            description = <"Det femte Korotkoff-ljudet identifieras genom avsaknad av ljud då manschettrycket sjunker under det diastoliska blodtrycket.">
                        >
                        ["at1014"] = <
                            text = <"Liggande i vänster sidoläge">
                            description = <"Liggande raklång med viss lateral lutning, vanligtvis mot vänster sida. Det krävs vanligtvis i graviditetens sista trimester för att lindra aortokaval kompression.">
                        >
                        ["at1018"] = <
                            text = <"Spädbarn">
                            description = <"En manschett för spädbarn.">
                        >
                        ["at1019"] = <
                            text = <"Nyfödd">
                            description = <"En manschett för nyfödda.">
                        >
                        ["at1020"] = <
                            text = <"Höger handled">
                            description = <"Individens högra handled.">
                        >
                        ["at1021"] = <
                            text = <"Vänster handled">
                            description = <"Individens vänstra handled.">
                        >
                        ["at1025"] = <
