                    ["el"] = <
                        ["at0000"] = <
                            text = <"Θερμοκρασία σώματος">
                            description = <"Μια μέτρηση της θερμοκρασίας του σώματος, η οποία είναι ένα υποκατάστατο για τη βασική θερμοκρασία του σώματος του ατόμου.">
                        >
                        ["at0001"] = <
                            text = <"Tree">
                            description = <"@ internal @">
                        >
                        ["at0002"] = <
                            text = <"History">
                            description = <"@ internal @">
                        >
                        ["at0003"] = <
                            text = <"Συμβάν διαστήματος">
                            description = <"Προεπιλεγμένο, απροσδιόριστο χρονικό σημείο ή συμβάν διαστήματος που μπορεί να ορίζεται ρητά σε ένα πρότυπο ή κατά το χρόνο εκτέλεσης.">
                        >
                        ["at0004"] = <
                            text = <"Θερμοκρασία">
                            description = <"Η μετρούμενη θερμοκρασία.">
                        >
                        ["at0020"] = <
                            text = <"Protocol">
                            description = <"@ internal @">
                        >
                        ["at0021"] = <
                            text = <"Θέση μέτρησης">
                            description = <"Απλή περιγραφή σχετικά με τον τόπο μέτρησης.">
                        >
                        ["at0022"] = <
                            text = <"Στοματική κοιλότητα">
                            description = <"Η θερμοκρασία μετράται μέσα στο στόμα">
                        >
                        ["at0023"] = <
                            text = <"Ακουστικού">
                            description = <"Η θερμοκρασία μετράται μέσα από τον εξωτερικό ακουστικό πόρο.">
                        >
                        ["at0024"] = <
                            text = <"Μασχάλη">
                            description = <"Η θερμοκρασία μετράται από το δέρμα της μασχάλης με τον βραχίονα τοποθετημένο στο πλάι">
                        >
                        ["at0025"] = <
                            text = <"Ορθό">
                            description = <"Θερμοκρασία μετρούμενη εντός του ορθού.">
                        >
                        ["at0026"] = <
                            text = <"Ρινοφαρυγγική κοιλότητα">
                            description = <"Η θερμοκρασία μετράται μέσα στο ρινοφάρυγγα.">
                        >
                        ["at0027"] = <
                            text = <"Ουροδόχος κύστη">
                            description = <"Η θερμοκρασία μετράται στην ουροδόχο κύστη.">
                        >
                        ["at0028"] = <
                            text = <"Ενδαγγειακή">
                            description = <"Η θερμοκρασία μετράται εντός του αγγειακού συστήματος.">
                        >
                        ["at0029"] = <
                            text = <"Κατάσταση">
                            description = <"Αναφέρετε πληροφορίες σχετικά με τον ασθενή">
                        >
                        ["at0030"] = <
                            text = <"Βαθμός έκθεσης σώματος">
                            description = <"Ο βαθμός έκθεσης του ατόμου κατά τη στιγμή της μέτρησης.">
                        >
                        ["at0031"] = <
                            text = <"Γυμνισμός">
                            description = <"Δεν υπάρχουν ρούχα, κλινοσκεπάσματα ή κάλυμμα.">
                        >
                        ["at0032"] = <
                            text = <"Μειωμένος ρουχισμός/κλινοσκεπάσματα">
                            description = <"Το άτομο καλύπτεται από μικρότερη ποσότητα ρουχισμού ή κλινοστρωμνής από ό, τι κρίνεται κατάλληλο για τις περιβαλλοντικές συνθήκες.">
                        >
                        ["at0033"] = <
                            text = <"Κατάλληλος ρουχισμός/κλινοσκεπάσματα">
                            description = <"Το άτομο καλύπτεται από ποσότητα ρουχισμού ή κλινοστρωμνής που κρίνεται κατάλληλη για τις περιβαλλοντικές συνθήκες.">
                        >
                        ["at0034"] = <
                            text = <"Αυξημένα ρούχα/κλινοσκεπάσματα">
                            description = <"Το άτομο καλύπτεται από αυξημένη ποσότητα ρουχισμού ή κλινοστρωμνής από ό, τι κρίνεται κατάλληλο για τις περιβαλλοντικές συνθήκες.">
                        >
                        ["at0041"] = <
                            text = <"Περιγραφή της θερμικής καταπόνησης">
                            description = <"Αφηγηματική περιγραφή των συνθηκών που εφαρμόζονται στο υποκείμενο και ενδέχεται να επηρεάσουν τη μετρούμενη θερμοκρασία του σώματός του.">
                        >
                        ["at0043"] = <
                            text = <"Δέρμα">
                            description = <"Η θερμοκρασία μετράται από το εκτεθειμένο δέρμα.">
                        >
                        ["at0051"] = <
                            text = <"Κολπική κοιλότητα">
                            description = <"Η θερμοκρασία μετράται μέσα στον κόλπο.">
                        >
                        ["at0054"] = <
