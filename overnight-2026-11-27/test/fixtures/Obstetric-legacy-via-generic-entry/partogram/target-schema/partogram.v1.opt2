                        >
                        ["at1049"] = <
                            text = <"Arteria braquial - Derecha">
                            description = <"Arteria braquial derecha.">
                        >
                        ["at1050"] = <
                            text = <"Automatico, invasivo">
                            description = <"Los hallazgos se observan de forma invasiva utilizando un dispositivo como un catéter arterial.">
