                            description = <"ساختار لیست ">
                        >
                        ["at0013"] = <
                            text = <"اندازه کاف">
                            description = <"اندازه کاف استفاده شده برای اندازه گیری فشار خون">
                        >
                        ["at0014"] = <
                            text = <"*Location of measurement(en)">
                            description = <"*Simple body site where blood pressure was measured.(en)">
                        >
                        ["at0015"] = <
