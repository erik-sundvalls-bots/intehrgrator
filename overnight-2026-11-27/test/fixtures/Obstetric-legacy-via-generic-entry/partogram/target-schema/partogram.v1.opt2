                        >
                        ["at0154"] = <
                            text = <"Fecha/hora de reinicio">
                            description = <"La fecha/hora en la que el curso de medicación está programado para reiniciarse, según la fase del proceso \"Administración suspendida\".">
                        >
                        ["at0155"] = <
