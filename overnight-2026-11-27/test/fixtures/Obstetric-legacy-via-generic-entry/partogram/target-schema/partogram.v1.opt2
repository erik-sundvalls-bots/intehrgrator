                            description = <"Individens finger.">
                        >
                        ["at1035"] = <
                            text = <"Metod">
                            description = <"Metod för mätning av blodtryck.">
                        >
                        ["at1036"] = <
                            text = <"Auskultation">
                            description = <"Metod för icke-invasiv mätning av blodtryck med hjälp av sfygmomanometri, såsom manschett, stetoskop, Korotkoff-ljud.">
                        >
                        ["at1037"] = <
                            text = <"Palpation">
                            description = <"Metod för att mäta det systoliska blodtrycket med hjälp av palpation, vanligtvis av brakiala eller radiella artärer.">
                        >
                        ["at1038"] = <
                            text = <"Formel för medelartärtryck">
                            description = <"Formel som används för att beräkna medelartärtrycket (om det finns registrerat).">
                        >
                        ["at1039"] = <
                            text = <"Blodtrycksmaskin">
                            description = <"Icke-invasiv blodtrycksmätning med hjälp av oscillometri i en halvautomatisk blodtrycksmätare.">
                        >
                        ["at1040"] = <
                            text = <"Invasiv">
                            description = <"Metod för att mäta blodtrycket intravenöst, dvs. genom att penetrera huden och mäta inuti blodkärlen.">
                        >
                        ["at1042"] = <
                            text = <"24 timmars blodtrycksmätning">
                            description = <"Beräkning av det genomsnittliga blodtrycket under en 24-timmarsperiod.">
                        >
                        ["at1043"] = <
                            text = <"Sömnstatus">
                            description = <"Sömnstatus som stöder tolkningen av 24-timmars ambulatoriska blodtrycksmätningar.">
                        >
                        ["at1044"] = <
                            text = <"Alert och vaken">
                            description = <"Patienten är vid fullt medvetande.">
                        >
